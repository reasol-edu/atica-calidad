{% extends 'pdf/layout.html.twig' %}

{#
   A document model (blank) or a filled document as a PDF: the sections already numbered, the values already formatted
   (App\Service\Form\FormResolver). Tables and rules are plain (mPDF), no flex/grid.
#}
{# A field «Adjuntos»: each file by its number of annex, a picture drawn where it is. #}
{% macro attachments(item, images) %}
    {% for a in item.attachments %}
        <div class="form-annex">{{ 'view.annex'|trans({'%n%': a.n}, 'forms') }}: {{ a.name }} <span class="form-annex-size">({{ a.sizeText }})</span></div>
        {% if images[a.id] is defined %}<div class="form-annex-image"><img src="{{ images[a.id] }}" alt=""></div>{% endif %}
    {% else %}
        —
    {% endfor %}
{% endmacro %}

{% macro section(s, blank, images) %}
    <div class="form-section">
        {% if s.title %}
            <h{{ min(s.level + 1, 5) }} class="form-title">{% if s.number %}{{ s.number }}. {% endif %}{{ s.title }}</h{{ min(s.level + 1, 5) }}>
        {% endif %}
        {% for b in s.blocks %}
            {% if b.kind == 'text' %}
                {% if b.label %}<p class="form-label">{{ b.label }}</p>{% endif %}
                {% if b.empty %}
                    {% if blank and b.label %}<div class="form-blank"></div>{% endif %}
                {% else %}
                    <div class="form-text">{{ b.html|sanitize_html('app.rich_text') }}</div>
                {% endif %}
            {% elseif b.kind == 'fields' %}
                <table class="form-fields">
                    {% for item in b.items %}
                        <tr>
                            <td class="form-field-label">{{ item.label }}</td>
                            <td class="form-field-value">{% if item.attachments is defined %}{{ _self.attachments(item, images) }}{% elseif blank and item.scale is defined %}<span class="form-scale">{{ item.scale }}</span>{% else %}{{ item.value }}{% endif %}</td>
                        </tr>
                    {% endfor %}
                </table>
            {% elseif b.kind == 'table' %}
                {% if b.label %}<p class="form-label">{{ b.label }}</p>{% endif %}
                <table class="form-table">
                    <thead>
                        <tr>
                            {% if b.fixed %}<th>{{ b.rowHeader }}</th>{% endif %}
                            {% for c in b.columns %}<th>{{ c }}</th>{% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in b.rows %}
                            <tr>
                                {% if b.fixed %}<td class="form-rowlabel">{{ r.label }}</td>{% endif %}
                                {% for cell in r.cells %}<td>{% if r.html[loop.index0] is defined %}<div class="form-text">{{ r.html[loop.index0]|sanitize_html('app.rich_text') }}</div>{% else %}{{ cell }}{% endif %}</td>{% endfor %}
                            </tr>
                        {% else %}
                            <tr><td colspan="{{ b.columns|length + (b.fixed ? 1 : 0) }}" class="form-blank-row">&nbsp;</td></tr>
                        {% endfor %}
                        {% if b.totals %}
                            <tr class="form-total">
                                {% if b.fixed %}<td class="form-rowlabel"><strong>{{ 'view.total'|trans({}, 'forms') }}</strong></td>{% endif %}
                                {% for t in b.totals %}<td><strong>{{ t }}</strong></td>{% endfor %}
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
                {% if b.deliveredFrom is defined and b.deliveredFrom %}
                    <p class="form-delivered-from">{{ b.deliveredFrom.text }}</p>
                {% endif %}
            {% endif %}
        {% endfor %}
        {% for child in s.children %}{{ _self.section(child, blank, images) }}{% endfor %}
    </div>
{% endmacro %}

{% block content %}
{# The model's font scale (50–150 %, 100 is the normal size) applies to everything in the body; the running header and footer have their own sizes. #}
{% set k = (fontScale|default(100)) / 100 %}
<style>
    body { font-size: {{ (9 * k)|round(2) }}pt; }
    .page-header h1 { font-size: {{ (17 * k)|round(2) }}pt; }
    .page-header .meta { font-size: {{ (9.5 * k)|round(2) }}pt; }
    .form-title { color: #2e2822; margin: 12px 0 4px; }
    h2.form-title { font-size: {{ (13 * k)|round(2) }}pt; border-bottom: 1px solid #e3d8c1; padding-bottom: 2px; }
    h3.form-title { font-size: {{ (11.5 * k)|round(2) }}pt; }
    h4.form-title, h5.form-title { font-size: {{ (10 * k)|round(2) }}pt; }
    .form-label { font-weight: bold; color: #5e5044; margin: 6px 0 2px; }
    .form-text { margin: 2px 0 6px; }
    .form-text p { margin: 0 0 4px; }
    .form-fields { width: 100%; border-collapse: collapse; margin: 4px 0 8px; }
    .form-field-label { width: 32%; background: #f6f1e6; border: 1px solid #e3d8c1; padding: 4px 6px; font-weight: bold; color: #5e5044; }
    .form-field-value { border: 1px solid #e3d8c1; padding: 4px 6px; }
    .form-table { width: 100%; border-collapse: collapse; margin: 4px 0 8px; }
    .form-table th { background: #f6f1e6; border: 1px solid #e3d8c1; padding: 4px 6px; text-align: left; color: #5e5044; }
    .form-table td { border: 1px solid #e3d8c1; padding: 4px 6px; }
    .form-delivered-from { margin: -4px 0 8px; font-size: {{ (7.5 * k)|round(2) }}pt; color: #7a6c5d; }
    .form-rowlabel { background: #fbf9f3; }
    .form-blank { border: 1px solid #e3d8c1; height: 60px; margin: 2px 0 8px; }
    .form-blank-row { height: 20px; }
    .form-scale { color: #5e5044; }
    .form-annex { margin: 1px 0; }
    .form-annex-size { color: #8a7f72; }
    .form-annex-image { margin: 3px 0 6px; }
    .form-annex-image img { max-width: 9cm; max-height: 7cm; }
    .form-annexes { margin-top: 14px; }
    .form-annexes td { border-bottom: 1px solid #e3d8c1; padding: 3px 6px; vertical-align: top; }
    .form-annexes-note { color: #8a7f72; font-size: {{ (8 * k)|round(2) }}pt; margin-top: 4px; }
</style>

{% if showTitle|default(true) %}
<div class="page-header">
    <h1>{{ title }}</h1>
    {% if code %}<div class="meta">{{ code }}</div>{% endif %}
</div>
{% endif %}

{% for s in sections %}{{ _self.section(s, blank, annexImages|default({})) }}{% endfor %}

{# The list of every annex, at the end: where each one is (inside this PDF, its pages at the end). #}
{% if annexes|default([]) is not empty %}
    <h2 class="form-title form-annexes">{{ 'view.annexes'|trans({}, 'forms') }}</h2>
    <table class="form-annexes" width="100%">
        {% for a in annexes %}
            <tr>
                <td width="16%"><strong>{{ 'view.annex'|trans({'%n%': a.n}, 'forms') }}</strong></td>
                <td>{{ a.name }} <span class="form-annex-size">({{ a.sizeText }})</span>{% if annexPages[a.id] is defined %} — {{ 'view.annex_pages'|trans({'%count%': annexPages[a.id]}, 'forms') }}{% endif %}</td>
            </tr>
        {% endfor %}
    </table>
    {% if embedded|default(false) %}<p class="form-annexes-note">{{ 'view.annexes_embedded'|trans({}, 'forms') }}</p>{% endif %}
{% endif %}
{% endblock %}
