{% set pending = this.pending %}
{% if pending is not empty %}
<div {{ attributes }} class="rounded-2xl border border-gray-200 bg-white shadow-xs">
    <div class="px-6 py-5 border-b border-gray-100">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-900">
            {{ ux_icon('heroicons:check-badge', {class: 'h-5 w-5 text-forest-600'}) }}
            {{ 'read_ack.title'|trans({}, 'dashboard') }}
            <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700">{{ pending|length }}</span>
        </h2>
        <p class="mt-1 text-sm text-gray-500">{{ 'read_ack.help'|trans({}, 'dashboard') }}</p>
    </div>
    <ul class="divide-y divide-gray-100">
        {% for document in pending|slice(0, constant('App\\Twig\\Components\\DashboardReadAcknowledgementComponent::MAX_ITEMS')) %}
            {% set folder = document.folder %}
            <li>
                <a href="{{ path('app_document_tree', {section: folder.documentSection.id.toRfc4122, folder: folder.id.toRfc4122, document: document.id.toRfc4122}) }}"
                   class="flex items-start gap-3 px-6 py-3 transition-colors hover:bg-gray-50">
                    <span class="mt-0.5 shrink-0 text-amber-500">{{ ux_icon('heroicons:document-text', {class: 'h-5 w-5'}) }}</span>
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium text-gray-900">{{ document.name }}</span>
                        <span class="block truncate text-xs text-gray-500">
                            {{ folder.name }} · {{ 'read_ack.version'|trans({'%version%': document.activeRevision.version, '%date%': document.activeRevision.revisedAt|date('d/m/Y')}, 'dashboard') }}
                        </span>
                    </span>
                </a>
            </li>
        {% endfor %}
    </ul>
    {% if pending|length > constant('App\\Twig\\Components\\DashboardReadAcknowledgementComponent::MAX_ITEMS') %}
        <p class="px-6 py-3 text-center text-xs text-gray-400">
            {{ 'read_ack.more'|trans({'%count%': pending|length - constant('App\\Twig\\Components\\DashboardReadAcknowledgementComponent::MAX_ITEMS')}, 'dashboard') }}
        </p>
    {% endif %}
</div>
{% endif %}
