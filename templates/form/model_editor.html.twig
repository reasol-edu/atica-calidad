    row_summary_count: 'editor.row_summary_count'|trans({}, 'forms'),
    formula_copies: 'editor.formula_copies'|trans({}, 'forms'),
    formula_matrix: 'editor.formula_matrix'|trans({}, 'forms'),
    formula_matrix_rows: 'editor.formula_matrix_rows'|trans({}, 'forms'),
    formula_matrix_cols: 'editor.formula_matrix_cols'|trans({}, 'forms'),
    decimals: 'editor.decimals'|trans({}, 'forms'),
    rel_table: 'editor.rel_table'|trans({}, 'forms'),
    rel_label: 'editor.rel_label'|trans({}, 'forms'),
    rel_multiple: 'editor.rel_multiple'|trans({}, 'forms'),
    total: 'editor.total'|trans({}, 'forms'),
    total_none: 'editor.total_none'|trans({}, 'forms'),
    total_sum: 'editor.total_sum'|trans({}, 'forms'),
    total_avg: 'editor.total_avg'|trans({}, 'forms'),
    total_min: 'editor.total_min'|trans({}, 'forms'),
    total_max: 'editor.total_max'|trans({}, 'forms'),
    total_count: 'editor.total_count'|trans({}, 'forms'),
