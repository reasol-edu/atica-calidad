<div {{ attributes.defaults(stimulus_controller('activity-category-url')) }} class="js-activity-browser">
    {% set breadcrumb = this.getBreadcrumb %}
    {% set child_categories = this.getVisibleCategories %}
    {% set current = this.getCurrentCategory %}
    {% set can_edit = this.canEdit %}
    {# The sidebar (wide screens only — see the "hidden lg:block" below) is a plain jump-to-any-branch
       aid alongside the breadcrumb/cards browsing beneath it; it changes nothing about how browsing
       itself works, so every LiveAction and every bit of state further down stays untouched. #}
    {% set tree = this.getCategoryTree %}
    {% set current_id = current ? current.id.toRfc4122 : '' %}
    {% set ancestor_ids = breadcrumb|map(c => c.id.toRfc4122) %}

    <div {% if tree is not empty %}data-controller="tree-sidebar" data-tree-sidebar-target="container" style="--tree-sidebar-width: 18rem;"
             class="lg:grid lg:grid-cols-[var(--tree-sidebar-width,18rem)_1.25rem_minmax(0,1fr)]"{% endif %}>
        {% if tree is not empty %}
            <aside data-tree-sidebar-target="aside"
                   class="hidden lg:block lg:min-w-0 lg:overflow-hidden lg:sticky lg:top-4 lg:self-start lg:h-[calc(100vh-2rem)]">
                <div class="h-full overflow-y-auto pr-3">
                    <p class="mb-2 px-2 text-[11px] font-semibold uppercase tracking-wide text-gray-400">{{ 'sidebar.title'|trans({}, 'activity_content') }}</p>
                    <ul class="space-y-0.5 text-sm">
                        <li>
                            <button type="button" data-action="live#action" data-live-action-param="openLevel" data-live-id-param=""
                                    style="padding-left: 0.5rem"
                                    class="flex w-full items-center gap-1.5 rounded-md py-1.5 pr-2 text-left transition-colors
                                           {{ current is null ? 'bg-forest-50 font-medium text-forest-700' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-700' }}">
                                {{ ux_icon('heroicons:home', {class: 'h-3.5 w-3.5 shrink-0'}) }}
                                {{ 'breadcrumb.root'|trans({}, 'activity_content') }}
                            </button>
                        </li>
                        {% for node in tree %}
                            {% include 'components/_activity_category_sidebar_node.html.twig' with {node: node, depth: 0, current_id: current_id, ancestor_ids: ancestor_ids} %}
                        {% endfor %}
                    </ul>
                </div>
            </aside>

            {# The gutter: dragging anywhere in it resizes the sidebar; the round button on top of
               it — always in the same place, sidebar open or not — hides or brings it back. #}
            <div class="relative hidden lg:block">
                <div data-action="mousedown->tree-sidebar#startDrag"
                     class="absolute inset-y-0 left-1/2 w-2.5 -translate-x-1/2 cursor-col-resize rounded-full transition-colors hover:bg-forest-100"></div>
                <button type="button" data-action="tree-sidebar#toggle"
                        class="absolute left-1/2 top-2 z-10 flex h-6 w-5 -translate-x-1/2 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-400 shadow-xs transition-colors hover:border-forest-300 hover:text-forest-600"
                        title="{{ 'sidebar.toggle'|trans({}, 'activity_content') }}">
                    <span data-tree-sidebar-target="icon" class="transition-transform">
                        {{ ux_icon('heroicons:chevron-left', {class: 'h-3 w-3'}) }}
                    </span>
                </button>
            </div>
        {% endif %}

        <div class="min-w-0 space-y-4">

    {# ── Search across the whole activity tree ───────────────────────── #}
    <form data-action="submit->live#action:prevent" class="relative">
        {{ ux_icon('heroicons:magnifying-glass', {class: 'pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400'}) }}
        <input type="search" data-model="debounce(300)|searchQuery" value="{{ searchQuery }}"
               placeholder="{{ 'search.placeholder'|trans({}, 'activity_content') }}"
               class="w-full rounded-xl border border-gray-200 bg-white py-2 pl-9 {{ searchQuery is not empty ? 'pr-9' : 'pr-3' }} text-sm focus:outline-none focus:ring-2 focus:ring-forest-500/20">
        {% if searchQuery is not empty %}
            <button type="button" data-action="live#action" data-live-action-param="clearSearch"
                    class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-300 hover:text-gray-600">
                {{ ux_icon('heroicons:x-mark', {class: 'h-4 w-4'}) }}
            </button>
        {% endif %}
    </form>

    {% if searchQuery|trim|length >= 2 %}
        {# ── Search results ────────────────────────────────────────────── #}
        {% set category_results   = this.getCategorySearchResults %}
        {% set activity_results   = this.getActivitySearchResults %}
        {% set submission_results = this.getSubmissionSearchResults %}
        {% set any_shown = false %}

        {% if category_results is not empty %}
            <div>
                <p class="mb-1 px-1 text-xs font-semibold uppercase tracking-wider text-gray-400">{{ 'search.categories_heading'|trans({}, 'activity_content') }}</p>
                <div class="space-y-1">
                    {% for result in category_results %}
                        <button type="button" data-action="live#action" data-live-action-param="openCategorySearchResult" data-live-id-param="{{ result.category.id }}"
                                class="flex w-full items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-left hover:bg-gray-50 {{ result.direct ? '' : 'opacity-60' }}">
                            {{ ux_icon('heroicons:rectangle-group', {class: 'h-4 w-4 shrink-0 text-gray-400'}) }}
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm text-gray-800">{{ result.category.name|highlight(searchQuery) }}</span>
                                <span class="block truncate text-xs text-gray-400">{{ result.path }}</span>
                            </span>
                            {% if not result.direct %}
                                <span class="shrink-0 text-xs italic text-gray-400">{{ 'search.other_profiles_hint'|trans({}, 'activity_content') }}</span>
                            {% endif %}
                        </button>
                    {% endfor %}
                </div>
            </div>
            {% set any_shown = true %}
        {% endif %}

        {% if activity_results is not empty %}
            <div class="{{ any_shown ? 'pt-2' : '' }}">
                <p class="mb-1 px-1 text-xs font-semibold uppercase tracking-wider text-gray-400">{{ 'search.activities_heading'|trans({}, 'activity_content') }}</p>
                <div class="space-y-1">
                    {% for result in activity_results %}
                        <button type="button" data-action="live#action" data-live-action-param="openActivitySearchResult" data-live-id-param="{{ result.activity.id }}"
                                class="flex w-full items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-left hover:bg-gray-50 {{ result.direct ? '' : 'opacity-60' }}">
                            {{ ux_icon('heroicons:check-circle', {class: 'h-4 w-4 shrink-0 text-gray-400'}) }}
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm text-gray-800">{{ result.activity.title|highlight(searchQuery) }}</span>
                                <span class="block truncate text-xs text-gray-400">{{ result.path }}</span>
                            </span>
                            {% if not result.direct %}
                                <span class="shrink-0 text-xs italic text-gray-400">{{ 'search.other_profiles_hint'|trans({}, 'activity_content') }}</span>
                            {% endif %}
                        </button>
                    {% endfor %}
                </div>
            </div>
            {% set any_shown = true %}
        {% endif %}

        {% if submission_results is not empty %}
            <div class="{{ any_shown ? 'pt-2' : '' }}">
                <p class="mb-1 px-1 text-xs font-semibold uppercase tracking-wider text-gray-400">{{ 'search.submissions_heading'|trans({}, 'activity_content') }}</p>
                <div class="space-y-1">
                    {% for result in submission_results %}
                        <button type="button" data-action="live#action" data-live-action-param="openSubmissionSearchResult" data-live-id-param="{{ result.document.id }}"
                                class="flex w-full items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-left hover:bg-gray-50 {{ result.direct ? '' : 'opacity-60' }}">
                            {{ ux_icon('heroicons:document', {class: 'h-4 w-4 shrink-0 text-gray-400'}) }}
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm text-gray-800">{{ result.document.name|highlight(searchQuery) }}</span>
                                <span class="block truncate text-xs text-gray-400">{{ result.path }}</span>
                            </span>
                            {% if not result.direct %}
                                <span class="shrink-0 text-xs italic text-gray-400">{{ 'search.other_profiles_hint'|trans({}, 'activity_content') }}</span>
                            {% endif %}
                        </button>
                    {% endfor %}
                </div>
            </div>
            {% set any_shown = true %}
        {% endif %}

        {% if not any_shown %}
            <p class="px-1 py-6 text-center text-sm text-gray-400">{{ 'search.empty'|trans({}, 'activity_content') }}</p>
        {% endif %}
    {% else %}
        {# ── Breadcrumbs ───────────────────────────────────────────────── #}
        <div class="flex flex-wrap items-center justify-between gap-2">
            <nav class="flex flex-wrap items-center gap-1 text-sm text-gray-500">
                <button type="button" data-action="live#action" data-live-action-param="openLevel" data-live-id-param=""
                        class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 hover:bg-gray-100 hover:text-gray-700 {{ current is null ? 'font-medium text-gray-800' : '' }}">
                    {{ ux_icon('heroicons:home', {class: 'h-3.5 w-3.5'}) }}
                    {{ 'breadcrumb.root'|trans({}, 'activity_content') }}
                </button>
                {% for crumb in breadcrumb %}
                    {{ ux_icon('heroicons:chevron-right', {class: 'h-3.5 w-3.5 text-gray-300'}) }}
                    <button type="button" data-action="live#action" data-live-action-param="openLevel" data-live-id-param="{{ crumb.id.toRfc4122 }}"
                            class="rounded-md px-1.5 py-0.5 hover:bg-gray-100 hover:text-gray-700 {{ crumb == current ? 'font-medium text-gray-800' : '' }}">
                        {{ crumb.name }}
                    </button>
                {% endfor %}
            </nav>
            <button type="button" data-action="live#action" data-live-action-param="toggleShowAllProfiles"
                    class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1 text-xs font-medium transition-colors
                           {{ not showAllProfiles ? 'border-forest-300 bg-forest-50 text-forest-700' : 'border-gray-200 bg-white text-gray-500 hover:bg-gray-50' }}">
                {{ ux_icon(showAllProfiles ? 'heroicons:funnel' : 'heroicons:eye', {class: 'h-3.5 w-3.5'}) }}
                {{ 'show_all_profiles'|trans({}, 'activity_content') }}
            </button>
        </div>

        {# ── Child categories ──────────────────────────────────────────── #}
        {% if child_categories is not empty %}
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
                {% for category in child_categories %}
                    <button type="button" data-action="live#action" data-live-action-param="openLevel" data-live-id-param="{{ category.id.toRfc4122 }}"
                            class="flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-3 text-left hover:border-forest-300 hover:bg-forest-50/40 transition-colors">
                        {{ ux_icon('heroicons:rectangle-group', {class: 'h-5 w-5 shrink-0 text-gray-400'}) }}
                        <span class="min-w-0 flex-1 truncate text-sm font-medium text-gray-800">{{ category.name }}</span>
                        {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0 text-gray-300'}) }}
                    </button>
                {% endfor %}
            </div>
        {% elseif current is null %}
            <p class="py-6 text-center text-sm italic text-gray-400">{{ 'categories_empty'|trans({}, 'activity_content') }}</p>
        {% endif %}

        {# ── Activities in the current category ───────────────────────── #}
        {% if current is not null %}
            {% set visible_activities = this.getVisibleActivities %}

            {% if can_edit %}
                <div class="flex justify-end">
                    <button type="button" data-action="live#action" data-live-action-param="startAddActivity"
                            class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-3 py-2 text-sm font-medium text-white hover:bg-forest-700 transition-colors">
                        {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
                        {{ 'activity.add'|trans({}, 'admin') }}
                    </button>
                </div>
            {% endif %}

            {% if activityFormOpen and formActivityId == '' %}
                {% include 'components/_activity_form.html.twig' %}
            {% endif %}

            {% if visible_activities is empty %}
                <p class="py-6 text-center text-sm italic text-gray-400">{{ 'activities_empty'|trans({}, 'activity_content') }}</p>
            {% else %}
                <div class="space-y-4">
                    {% for activity in visible_activities %}
                        {% include 'components/_activity.html.twig' with {activity: activity, can_edit: can_edit} %}
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
    {% endif %}

        </div>
    </div>
</div>
