{% extends 'layouts/app.html.twig' %}

{% set heading = action ? 'plan.edit_title'|trans({'%code%': action.code}, 'quality') : 'plan.new_title'|trans({}, 'quality') %}
{% block title %}{{ heading }} · {{ app_name }}{% endblock %}

{#
   A plan action, new or edited: the type (improvement or preventive, each explained in a line),
   what to do and what it's meant to achieve, the process, who and by when.
#}
{% block content %}
{% set field = 'block w-full rounded-xl border bg-white px-3.5 py-2.5 text-base sm:text-sm text-gray-900 placeholder-gray-400 focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20' %}
<div class="px-4 sm:px-6 py-8 max-w-2xl mx-auto">

    <div class="mb-6">
        <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-1">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_quality_index') }}" class="hover:text-forest-600 transition-colors">{{ 'quality'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
            <a href="{{ path('app_quality_plan') }}" class="hover:text-forest-600 transition-colors">{{ 'plan.title'|trans({}, 'quality') }}</a>
            {% if action %}
                {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
                <a href="{{ path('app_quality_action', {id: action.id.toRfc4122}) }}" class="hover:text-forest-600 transition-colors">{{ action.code }}</a>
            {% endif %}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ heading }}</h1>
        {% if not action %}<p class="mt-1 text-sm text-gray-500">{{ 'plan.new_intro'|trans({'%year%': centre.activeAcademicYear.name}, 'quality') }}</p>{% endif %}
    </div>

    <form method="post" class="space-y-5 rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-xs">
        <input type="hidden" name="_token" value="{{ csrf_token('quality_plan_action') }}">

        <fieldset class="space-y-1.5">
            <legend class="mb-1.5 block text-sm font-semibold text-gray-900">{{ 'action.type'|trans({}, 'quality') }}</legend>
            <div class="grid gap-2 sm:grid-cols-2">
                {% for t in types %}
                    <label class="flex cursor-pointer flex-col gap-0.5 rounded-xl border bg-white p-3 text-sm has-[:checked]:border-forest-500 has-[:checked]:ring-2 has-[:checked]:ring-forest-500/20 border-gray-200 hover:border-gray-300">
                        <span class="flex items-center gap-2 font-medium text-gray-900">
                            <input type="radio" name="type" value="{{ t.value }}" {{ values.type == t.value ? 'checked' : '' }} class="text-forest-600 focus:ring-forest-500">
                            {{ ('action_type.' ~ t.value)|trans({}, 'quality') }}
                        </span>
                        <span class="text-xs text-gray-500">{{ ('action_type.help.' ~ t.value)|trans({}, 'quality') }}</span>
                    </label>
                {% endfor %}
            </div>
            {% if errors.type is defined %}<p class="text-xs text-red-600">{{ errors.type }}</p>{% endif %}
        </fieldset>

        <div class="space-y-1.5">
            <label for="plan-description" class="block text-sm font-semibold text-gray-900">{{ 'action.description'|trans({}, 'quality') }}</label>
            <textarea id="plan-description" name="description" rows="3" required {{ action ? '' : 'autofocus' }}
                      placeholder="{{ 'plan.description_placeholder'|trans({}, 'quality') }}"
                      class="{{ field }} {{ errors.description is defined ? 'border-red-300' : 'border-gray-200' }}">{{ values.description }}</textarea>
            {% if errors.description is defined %}<p class="text-xs text-red-600">{{ errors.description }}</p>{% endif %}
        </div>

        <div class="space-y-1.5">
            <label for="plan-goal" class="block text-sm font-semibold text-gray-900">{{ 'plan.goal'|trans({}, 'quality') }} <span class="font-normal text-gray-500">{{ 'report.optional'|trans({}, 'quality') }}</span></label>
            <textarea id="plan-goal" name="goal" rows="2"
                      placeholder="{{ 'plan.goal_placeholder'|trans({}, 'quality') }}"
                      class="{{ field }} border-gray-200">{{ values.goal }}</textarea>
        </div>

        <div class="space-y-1.5">
            <label for="plan-section" class="block text-sm font-semibold text-gray-900">{{ 'classify.section'|trans({}, 'quality') }} <span class="font-normal text-gray-500">{{ 'report.optional'|trans({}, 'quality') }}</span></label>
            <select id="plan-section" name="section" class="{{ field }} border-gray-200">
                <option value="">—</option>
                {% for choice in sections %}
                    <option value="{{ choice.id }}" {{ values.section == choice.id ? 'selected' : '' }}>{{ choice.indented }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-1.5">
                <label for="plan-responsible" class="block text-sm font-semibold text-gray-900">{{ 'action.responsible'|trans({}, 'quality') }}</label>
                <select id="plan-responsible" name="responsible" class="{{ field }} {{ errors.responsible is defined ? 'border-red-300' : 'border-gray-200' }}">
                    <option value="">{{ 'action.responsible_me'|trans({}, 'quality') }}</option>
                    <optgroup label="{{ 'action.responsible_teachers'|trans({}, 'quality') }}">
                        {% for t in teachers %}
                            <option value="t:{{ t.id.toRfc4122 }}" {{ values.responsible == 't:' ~ t.id.toRfc4122 ? 'selected' : '' }}>{{ t.name.lastName }}, {{ t.name.firstName }}</option>
                        {% endfor %}
                    </optgroup>
                    {% if profiles is not empty %}
                        <optgroup label="{{ 'action.responsible_profiles'|trans({}, 'quality') }}">
                            {% for p in profiles %}
                                <option value="p:{{ p.id.toRfc4122 }}" {{ values.responsible == 'p:' ~ p.id.toRfc4122 ? 'selected' : '' }}>{{ p.name }}</option>
                            {% endfor %}
                        </optgroup>
                    {% endif %}
                </select>
                {% if errors.responsible is defined %}<p class="text-xs text-red-600">{{ errors.responsible }}</p>{% endif %}
            </div>
            <div class="space-y-1.5">
                <label for="plan-due" class="block text-sm font-semibold text-gray-900">{{ 'action.due'|trans({}, 'quality') }}</label>
                <input id="plan-due" type="date" name="dueDate" value="{{ values.dueDate }}" required
                       class="{{ field }} {{ errors.dueDate is defined ? 'border-red-300' : 'border-gray-200' }}">
                {% if errors.dueDate is defined %}<p class="text-xs text-red-600">{{ errors.dueDate }}</p>{% endif %}
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-3">
            <a href="{{ action ? path('app_quality_action', {id: action.id.toRfc4122}) : path('app_quality_plan') }}" class="text-sm font-medium text-gray-500 hover:text-gray-700">{{ 'cancel'|trans({}, 'quality') }}</a>
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 transition-colors">
                {{ ux_icon(action ? 'heroicons:check' : 'heroicons:plus', {class: 'h-4 w-4'}) }}
                {{ (action ? 'plan.save' : 'plan.submit')|trans({}, 'quality') }}
            </button>
        </div>
    </form>
</div>
{% endblock %}
