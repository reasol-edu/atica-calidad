<div {{ attributes }}>

    {% set rows = this.rows %}

    {% if rows is empty %}
        <div class="flex items-center justify-center gap-2 py-10 px-6 text-center">
            {{ ux_icon('heroicons:check-circle', {class: 'h-5 w-5 text-emerald-500'}) }}
            <p class="text-sm text-gray-500">{{ 'settings.no_settings_for_scope'|trans({}, 'settings') }}</p>
        </div>
    {% else %}
        {# Index of the categories on screen: the global scope has many, so jump straight to one instead of scrolling. #}
        {% set categories = [] %}
        {% for row in rows %}
            {% if row.definition.category not in categories %}{% set categories = categories|merge([row.definition.category]) %}{% endif %}
        {% endfor %}
        {% if categories|length > 1 %}
            <nav aria-label="{{ 'settings.index.label'|trans({}, 'settings') }}" class="flex flex-wrap gap-2 border-b border-gray-100 bg-gray-50/60 px-6 py-3">
                {% for category in categories %}
                    <a href="#settings-category-{{ category }}"
                       class="rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-gray-700 transition-colors hover:border-forest-300 hover:text-forest-700 max-sm:py-2">
                        {{ (category ~ '.label')|trans({}, 'settings') }}
                    </a>
                {% endfor %}
            </nav>
        {% endif %}
        {% set currentCategory = null %}
        {% for row in rows %}
            {% set def        = row.definition %}
            {% set key        = def.key %}
            {% set keySlug    = key|replace({'.': '_', '-': '_'}) %}
            {% set stored     = row.storedValue %}
            {% set effective  = row.effectiveValue %}
            {% set isSaved      = lastSaved == key %}
            {% set isError      = lastError == key %}
            {% set isLocked     = row.isLocked %}
            {% set parentLock   = row.parentLock %}
            {# When there is a parent lock, the control shows the value inherited from above #}
            {% set displayValue = parentLock is not null ? effective : stored %}

            {% if def.category != currentCategory %}
                {% if currentCategory is not null %}
                        </ul>
                    </section>
                {% endif %}
                {% set currentCategory = def.category %}
                <section id="settings-category-{{ def.category }}" class="scroll-mt-4 {{ loop.first ? '' : 'border-t border-gray-100' }}">
                    <h3 class="px-6 pt-5 pb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
                        {{ (def.category ~ '.label')|trans({}, 'settings') }}
                    </h3>
                    <ul class="divide-y divide-gray-100">
            {% endif %}

            {# The richtext and pdf settings stack vertically: they need the full width #}
            {% set isRichText = def.type.value == 'richtext' %}
            {% set isPdf      = def.type.value == 'pdf' %}
            {% set isLayout   = def.type.value in ['layout', 'image'] %}
            <li class="flex flex-col gap-3 px-6 py-4 {{ (isRichText or isPdf or isLayout) ? '' : 'sm:flex-row sm:items-center sm:gap-6' }}
                        {{ parentLock is not null ? 'opacity-60' : '' }}">

                {# ── Label + description ── #}
                <div class="flex-1 min-w-0">
                    {# A real <label> for the controls that are one field; the compound ones (day + month, editor, PDF) are
                       named through the group they sit in (aria-labelledby on the control wrapper below). #}
                    {% set hasSingleField = def.type.value in ['boolean', 'integer', 'choice', 'string'] %}
                    <div class="flex items-center gap-1.5">
                        {% if hasSingleField %}
                            <label for="setting-control-{{ keySlug }}" class="text-sm font-medium text-gray-900">
                                {{ ('settings.key.' ~ keySlug ~ '.label')|trans({}, 'settings') }}
                            </label>
                        {% else %}
                            <p id="setting-label-{{ keySlug }}" class="text-sm font-medium text-gray-900">
                                {{ ('settings.key.' ~ keySlug ~ '.label')|trans({}, 'settings') }}
                            </p>
                        {% endif %}
                        {% if isRichText %}
                            <div class="relative" data-controller="dropdown">
                                <button type="button"
                                        data-action="dropdown#toggle"
                                        class="text-gray-300 hover:text-forest-600 transition-colors"
                                        aria-label="{{ 'settings.placeholder_help.title'|trans({}, 'settings') }}"
                                        title="{{ 'settings.placeholder_help.title'|trans({}, 'settings') }}">
                                    {{ ux_icon('heroicons:information-circle', {class: 'h-4 w-4'}) }}
                                </button>
                                <div data-dropdown-target="menu" class="hidden">
                                    {# On mobile the popover is centered as a fixed panel with a dimmed background, instead
                                       of being positioned relative to the icon: this way it never runs off the screen if the
                                       icon is near the edge. On wider screens it keeps the
                                       dropdown anchored to the icon, as before. #}
                                    <div class="fixed inset-0 z-40 bg-black/40 sm:hidden"
                                         data-action="click->dropdown#close"></div>
                                    <div class="fixed inset-x-4 top-1/2 z-50 -translate-y-1/2 max-h-[80vh] overflow-y-auto
                                                rounded-xl border border-gray-200 bg-white shadow-lg
                                                sm:absolute sm:inset-x-auto sm:top-auto sm:left-0 sm:z-40 sm:mt-1
                                                sm:translate-y-0 sm:max-h-none sm:overflow-visible">
                                        {{ include('components/_settings_placeholder_help.html.twig') }}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                    {% set descKey = 'settings.key.' ~ keySlug ~ '.description' %}
                    {% set descVal = descKey|trans({}, 'settings') %}
                    {% if descVal != descKey %}
                        <p class="text-xs text-gray-500 mt-0.5">{{ descVal }}</p>
                    {% endif %}

                    {# ── Parent-lock notice ── #}
                    {% if parentLock is not null %}
                        <p class="flex items-center gap-1 text-xs text-amber-600 mt-1">
                            {{ ux_icon('heroicons:lock-closed', {class: 'h-3.5 w-3.5 shrink-0'}) }}
                            {{ parentLock == 'global'
                                ? 'settings.locked_by_global'|trans({}, 'settings')
                                : 'settings.locked_by_centre'|trans({}, 'settings') }}
                        </p>
                    {% endif %}
                </div>

                {# ── Control ── #}
                <div class="flex gap-3 {{ (isRichText or isPdf or isLayout) ? 'w-full items-start' : 'items-center max-w-full sm:shrink-0' }}"
                     {% if not hasSingleField %}role="group" aria-labelledby="setting-label-{{ keySlug }}"{% endif %}>

                    {% if def.type.value == 'boolean' %}
                        <select
                            id="setting-control-{{ keySlug }}"
                            class="min-w-0 max-w-full rounded-lg border border-gray-200 bg-gray-50 py-1.5 pl-3 pr-8 text-sm text-gray-900
                                   focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20
                                   transition-colors cursor-pointer
                                   disabled:cursor-not-allowed disabled:opacity-50"
                            {{ parentLock is not null ? 'disabled' : '' }}
                            data-controller="setting-save"
                            data-action="change->setting-save#save"
                            data-setting-key="{{ key }}">
                            <option value="__default__" {{ displayValue is null ? 'selected' : '' }} {{ isLocked ? 'disabled' : '' }}>
                                {{ 'settings.default_label'|trans({}, 'settings') }}
                                ({{ effective == 'true' ? 'settings.on'|trans({}, 'settings') : 'settings.off'|trans({}, 'settings') }})
                            </option>
                            <option value="true"  {{ displayValue == 'true'  ? 'selected' : '' }}>
                                {{ 'settings.on'|trans({}, 'settings') }}
                            </option>
                            <option value="false" {{ displayValue == 'false' ? 'selected' : '' }}>
                                {{ 'settings.off'|trans({}, 'settings') }}
                            </option>
                        </select>

                    {% elseif def.type.value == 'integer' %}
                        {% if def.minValue is not null and def.maxValue is not null %}
                            {% set intPlaceholder = effective ~ ' (' ~ def.minValue ~ '–' ~ def.maxValue ~ ')' %}
                        {% else %}
                            {% set intPlaceholder = effective %}
                        {% endif %}

                        <input
                            id="setting-control-{{ keySlug }}"
                            type="number"
                            {% if def.minValue is not null %}min="{{ def.minValue }}"{% endif %}
                            {% if def.maxValue is not null %}max="{{ def.maxValue }}"{% endif %}
                            value="{{ displayValue ?? '' }}"
                            placeholder="{{ intPlaceholder }}"
                            {{ parentLock is not null ? 'disabled' : '' }}
                            class="w-28 rounded-lg border py-1.5 px-3 text-sm text-gray-900
                                   placeholder-gray-400 focus:outline-none focus:ring-3 transition-colors
                                   disabled:cursor-not-allowed disabled:opacity-50
                                   {{ isError
                                       ? 'border-red-400 bg-red-50 focus:border-red-400 focus:ring-red-500/20'
                                       : 'border-gray-200 bg-gray-50 focus:border-forest-500 focus:ring-forest-500/20' }}"
                            data-controller="setting-save"
                            data-action="change->setting-save#save"
                            data-setting-key="{{ key }}">

                    {% elseif def.type.value == 'choice' %}
                        <select
                            id="setting-control-{{ keySlug }}"
                            class="min-w-0 max-w-full rounded-lg border border-gray-200 bg-gray-50 py-1.5 pl-3 pr-8 text-sm text-gray-900
                                   focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20
                                   transition-colors cursor-pointer
                                   disabled:cursor-not-allowed disabled:opacity-50"
                            {{ parentLock is not null ? 'disabled' : '' }}
                            data-controller="setting-save"
                            data-action="change->setting-save#save"
                            data-setting-key="{{ key }}">
                            <option value="__default__" {{ displayValue is null ? 'selected' : '' }} {{ isLocked ? 'disabled' : '' }}>
                                {{ 'settings.default_label'|trans({}, 'settings') }}
                                ({{ ('settings.key.' ~ keySlug ~ '.choice.' ~ effective)|trans({}, 'settings') }})
                            </option>
                            {% for choice in def.choicesArray %}
                                <option value="{{ choice }}" {{ displayValue == choice ? 'selected' : '' }}>
                                    {{ ('settings.key.' ~ keySlug ~ '.choice.' ~ choice)|trans({}, 'settings') }}
                                </option>
                            {% endfor %}
                        </select>

                    {% elseif def.type.value == 'day_month' %}
                        {# Stored as "MM-DD". The month select carries the "default" option; the day
                           select alone can't express it, so changing the day while on the default
                           keeps the default's month (see setting_save_controller.js). #}
                        {% set effectiveParts = effective|split('-') %}
                        {% set shownParts     = (displayValue ?? effective)|split('-') %}
                        {% set shownDay       = shownParts|last|number_format %}
                        {% set shownMonth     = displayValue is null ? '__default__' : shownParts|first|number_format %}
                        <div class="flex min-w-0 items-center gap-2"
                             data-controller="setting-save"
                             data-setting-key="{{ key }}"
                             data-setting-save-default-month-value="{{ effectiveParts|first|number_format }}">
                            {% set selectClasses = 'min-w-0 max-w-full rounded-lg border py-1.5 pl-3 pr-8 text-sm text-gray-900 focus:outline-none focus:ring-3 transition-colors cursor-pointer disabled:cursor-not-allowed disabled:opacity-50 '
                                ~ (isError ? 'border-red-400 bg-red-50 focus:border-red-400 focus:ring-red-500/20' : 'border-gray-200 bg-gray-50 focus:border-forest-500 focus:ring-forest-500/20') %}
                            <select class="{{ selectClasses }}"
                                    aria-label="{{ 'settings.day_month.day'|trans({}, 'settings') }}"
                                    {{ parentLock is not null ? 'disabled' : '' }}
                                    data-setting-save-target="day"
                                    data-action="change->setting-save#save">
                                {% for d in 1..31 %}
                                    <option value="{{ d }}" {{ shownDay == d ? 'selected' : '' }}>{{ d }}</option>
                                {% endfor %}
                            </select>
                            <select class="{{ selectClasses }}"
                                    aria-label="{{ 'settings.day_month.month'|trans({}, 'settings') }}"
                                    {{ parentLock is not null ? 'disabled' : '' }}
                                    data-setting-save-target="month"
                                    data-action="change->setting-save#save">
                                <option value="__default__" {{ shownMonth == '__default__' ? 'selected' : '' }} {{ isLocked ? 'disabled' : '' }}>
                                    {{ 'settings.default_label'|trans({}, 'settings') }}
                                    ({{ 'settings.day_month.format'|trans({
                                        '%day%': effectiveParts|last|number_format,
                                        '%month%': ('month.' ~ effectiveParts|first|number_format)|trans({}, 'calendar')|lower,
                                    }, 'settings') }})
                                </option>
                                {% for m in 1..12 %}
                                    <option value="{{ m }}" {{ shownMonth == m ? 'selected' : '' }}>
                                        {{ ('month.' ~ m)|trans({}, 'calendar') }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                    {% elseif def.type.value == 'layout' %}
                        {# The running header or footer of the documents: a table editor (Tiptap) kept out of the LiveComponent's morphing. #}
                        {% if parentLock is not null %}
                            <div class="w-full overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-500">
                                {{ effective|sanitize_html('app.doc_layout') }}
                            </div>
                        {% else %}
                            {{ include('components/_doc_layout_editor.html.twig', {
                                id: 'setting-layout-' ~ keySlug,
                                value: displayValue ?? effective ?? '',
                                default: def.defaultValue,
                                input: 'data-controller="setting-save" data-action="change->setting-save#save" data-setting-key="' ~ key|e('html_attr') ~ '"',
                            }) }}
                        {% endif %}

                    {% elseif def.type.value == 'richtext' %}
                        {% if parentLock is not null %}
                            <div class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 prose prose-sm max-w-none text-gray-500">
                                {{ effective|sanitize_html('app.rich_text') }}
                            </div>
                        {% else %}
                            {# data-live-ignore: Quill generates its own DOM (toolbar)
                               and LiveComponent's morphing would wreck it on every re-render #}
                            <div id="setting-richtext-{{ keySlug }}" class="w-full min-w-0" data-live-ignore data-controller="rich-editor">
                                <div data-rich-editor-target="editor" class="bg-white text-sm"></div>
                                <textarea data-rich-editor-target="input"
                                          class="hidden"
                                          data-controller="setting-save"
                                          data-action="change->setting-save#save"
                                          data-setting-key="{{ key }}">{{ displayValue ?? '' }}</textarea>
                            </div>
                        {% endif %}

                    {% elseif def.type.value == 'image' %}
                        {# An image (a logo): the one stored at this level with its preview, or the dropzone. Plain forms, like the PDF
                           templates, so the LiveComponent's morphing must leave them alone. #}
                        <div class="w-full" data-live-ignore>
                            {% if parentLock is not null %}
                                <p class="text-sm text-gray-500">{{ 'settings.image.locked'|trans({}, 'settings') }}</p>
                            {% elseif row.storedFile is not null %}
                                <div class="flex items-center gap-3 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm">
                                    <img src="{{ path('app_settings_image_view', {scope: scope, key: key}) }}?v={{ row.storedFile.hash|slice(0, 8) }}" alt="{{ stored }}"
                                         class="h-14 max-w-40 shrink-0 rounded border border-gray-200 bg-white object-contain p-1">
                                    <span class="min-w-0 flex-1 truncate text-gray-700">{{ stored }}</span>
                                    <span class="shrink-0 text-xs text-gray-400">{{ (row.storedFile.size / 1024)|round }} KB</span>
                                    <form method="post" action="{{ path('app_settings_image_delete', {scope: scope, key: key}) }}" class="shrink-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('settings_image_delete_' ~ key) }}">
                                        <button type="submit" class="text-xs font-medium text-red-600 hover:text-red-700">{{ 'settings.image.delete'|trans({}, 'settings') }}</button>
                                    </form>
                                </div>
                            {% else %}
                                <form method="post" action="{{ path('app_settings_image_upload', {scope: scope, key: key}) }}" enctype="multipart/form-data">
                                    <input type="hidden" name="_token" value="{{ csrf_token('settings_image_' ~ key) }}">
                                    <twig:Form:PdfDropzone id="setting-image-{{ keySlug }}" name="file" accept="image/png,image/jpeg"
                                        :hint="'settings.image.dropzone_hint'|trans({}, 'settings')" :thumbs="true" />
                                </form>
                            {% endif %}
                        </div>

                    {% elseif def.type.value == 'pdf' %}
                        {# data-live-ignore: these are regular forms (multipart upload, not supported by
                           LiveAction) that must not be affected by LiveComponent's morphing on every
                           save of another row #}
                        <div class="w-full" data-live-ignore>
                            {% if row.storedFile is not null %}
                                {# With a template already uploaded, it must be removed before another can be uploaded:
                                   this way the dropzone never coexists with a file already saved on the row. #}
                                <div class="flex items-center gap-3 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm">
                                    {{ ux_icon('heroicons:document', {class: 'h-4 w-4 shrink-0 text-gray-400'}) }}
                                    <span class="flex-1 min-w-0 truncate text-gray-700">{{ stored }}</span>
                                    <span class="shrink-0 text-xs text-gray-400">{{ (row.storedFile.size / 1024)|round }} KB</span>
                                    <a href="{{ path('app_settings_pdf_template_download', {key: key}) }}"
                                       class="shrink-0 text-xs font-medium text-forest-600 hover:text-forest-700">
                                        {{ 'settings.pdf_template.view'|trans({}, 'settings') }}
                                    </a>
                                    <form method="post" action="{{ path('app_settings_pdf_template_delete', {key: key}) }}" class="shrink-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('settings_pdf_template_delete_' ~ key) }}">
                                        <button type="submit" class="text-xs font-medium text-red-600 hover:text-red-700">
                                            {{ 'settings.pdf_template.delete'|trans({}, 'settings') }}
                                        </button>
                                    </form>
                                </div>
                            {% else %}
                                <form method="post" action="{{ path('app_settings_pdf_template_upload', {key: key}) }}" enctype="multipart/form-data">
                                    <input type="hidden" name="_token" value="{{ csrf_token('settings_pdf_template_' ~ key) }}">
                                    {# The "Subir" button is inside the dropzone: it only shows once a file is picked or dropped. #}
                                    <twig:Form:PdfDropzone id="pdf-template-{{ keySlug }}" name="file" />
                                </form>
                            {% endif %}
                        </div>

                    {% else %}
                        <input
                            id="setting-control-{{ keySlug }}"
                            type="text"
                            {% if def.minValue is not null %}minlength="{{ def.minValue }}"{% endif %}
                            {% if def.maxValue is not null %}maxlength="{{ def.maxValue }}"{% endif %}
                            value="{{ displayValue ?? '' }}"
                            placeholder="{{ 'settings.default_label'|trans({}, 'settings') }}: {{ effective }}"
                            {{ parentLock is not null ? 'disabled' : '' }}
                            class="w-48 rounded-lg border py-1.5 px-3 text-sm text-gray-900
                                   placeholder-gray-400 focus:outline-none focus:ring-3 transition-colors
                                   disabled:cursor-not-allowed disabled:opacity-50
                                   {{ isError
                                       ? 'border-red-400 bg-red-50 focus:border-red-400 focus:ring-red-500/20'
                                       : 'border-gray-200 bg-gray-50 focus:border-forest-500 focus:ring-forest-500/20' }}"
                            data-controller="setting-save"
                            data-action="change->setting-save#save"
                            data-setting-key="{{ key }}">
                    {% endif %}

                    {# ── Lock toggle (global and centre scopes) ── #}
                    {% if parentLock is null and scope != 'teacher' %}
                        {% set lockDisabled = stored is null %}
                        <button type="button"
                                class="transition-colors {{ isLocked ? 'text-amber-500 hover:text-amber-600' : (lockDisabled ? 'text-gray-200 cursor-not-allowed' : 'text-gray-300 hover:text-amber-400') }}"
                                {{ lockDisabled ? 'disabled' : '' }}
                                data-action="click->live#action:prevent"
                                data-live-action-param="toggleLock"
                                data-live-key-param="{{ key }}"
                                {% set lockTitle = isLocked ? 'settings.unlock.title'|trans({}, 'settings') : (lockDisabled ? 'settings.lock.no_value_title'|trans({}, 'settings') : 'settings.lock.title'|trans({}, 'settings')) %}
                                aria-label="{{ lockTitle }}"
                                title="{{ lockTitle }}">
                            {{ ux_icon(isLocked ? 'heroicons:lock-closed' : 'heroicons:lock-open', {class: 'h-4 w-4'}) }}
                        </button>
                    {% endif %}

                    {# ── Saved feedback ── #}
                    {% if isSaved %}
                        <span class="flex items-center gap-1 text-xs font-medium text-emerald-600">
                            {{ ux_icon('heroicons:check', {class: 'h-3.5 w-3.5'}) }}
                            {{ 'settings.saved'|trans({}, 'settings') }}
                        </span>
                    {% endif %}

                    {# ── Error feedback ── #}
                    {% if isError %}
                        <span class="flex items-center gap-1 text-xs font-medium text-red-600">
                            {{ ux_icon('heroicons:exclamation-circle', {class: 'h-3.5 w-3.5'}) }}
                            {% if def.type.value == 'integer' and def.minValue is not null and def.maxValue is not null %}
                                {{ 'settings.error.integer_range'|trans({'%min%': def.minValue, '%max%': def.maxValue}, 'settings') }}
                            {% elseif def.type.value == 'day_month' %}
                                {{ 'settings.error.invalid_day_month'|trans({}, 'settings') }}
                            {% else %}
                                {{ 'settings.error.invalid_value'|trans({}, 'settings') }}
                            {% endif %}
                        </span>
                    {% endif %}

                </div>
            </li>
        {% endfor %}
                </ul>
            </section>
    {% endif %}

</div>
