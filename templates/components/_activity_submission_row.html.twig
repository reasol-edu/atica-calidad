{% set read_only = read_only|default(false) %}
{% set index = index|default(0) %}
{% set aid = activity.id.toRfc4122 %}
{% set can_manage = this.canManageFolder(folder) %}
{% set can_review = this.canReviewFolder(folder) %}

{% if document is not null %}
    {% set did = document.id.toRfc4122 %}
    {% set active = document.activeRevision %}
    {% set pending = document.pendingRevision %}
    {% set can_manage_as_uploader = this.canManageDocumentAsUploader(document) %}
    {# Narrower than can_manage_as_uploader: lets the teacher who submitted this — and nobody
       else — take it back (or, by re-opening the slot, replace it) while nothing has been
       decided on it yet. See ActivityBrowserComponent::canWithdrawOwnSubmission(). #}
    {% set can_withdraw = this.canWithdrawOwnSubmission(document) %}
    {# Turned down and not replaced yet: the reason and a way to answer it, right under the row. #}
    {% set rejected_revision = document.lastRejectedRevision %}
    {% set highlighted = highlightedDocumentId == did or (highlightedSlotKey != '' and this.getSlotToHighlight(activity) == slot.key) %}

    {% if not read_only %}
        <input type="hidden" name="items[{{ index }}][slotKey]" value="{{ slot.key }}" form="{{ form_id }}">
        <input type="file" name="files[{{ index }}]" class="sr-only" form="{{ form_id }}" data-activity-submissions-target="input" data-action="change->activity-submissions#change">
    {% endif %}

    <div data-role="submission-row" {{ (highlighted ? 'data-controller="scroll-into-view"' : '')|raw }}
         class="group flex items-center gap-2 rounded-lg border border-gray-100 bg-white px-2.5 py-1.5 {{ highlighted ? 'document-highlight-pulse' : '' }}">
        {% if active %}
            <a href="{{ path('app_folder_document_revision_download', {folderId: folder.id.toRfc4122, documentId: did, revisionId: active.id.toRfc4122}) }}"
               class="shrink-0 text-gray-300 hover:text-forest-600 transition-colors" title="{{ 'download'|trans({}, 'document_content') }}">
                {{ ux_icon('heroicons:arrow-down-tray', {class: 'h-4 w-4'}) }}
            </a>
        {% else %}
            <span class="shrink-0 text-gray-200" title="{{ 'status.no_revision'|trans({}, 'activity_content') }}">
                {{ ux_icon('heroicons:clock', {class: 'h-4 w-4'}) }}
            </span>
        {% endif %}

        <div class="min-w-0 flex-1">
            {% if slot.teacher %}
                {# Individual scope: several rows can share the exact same displayName (e.g. two
                   teachers both holding "Tutor/a 1º DAW"), so the teacher is what actually tells
                   them apart — lead with it, not the profile/subprofile label. #}
                <p class="truncate text-sm font-medium text-gray-800">{{ slot.teacher.name.lastName }}, {{ slot.teacher.name.firstName }}</p>
            {% endif %}
            <div class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5">
                <span class="min-w-0 max-w-full truncate text-sm {{ slot.teacher ? 'text-gray-500' : 'text-gray-800' }}">{{ document.name }}</span>
                {% if pending %}
                    <span class="shrink-0 inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                        {{ 'status.pending'|trans({}, 'activity_content') }}
                    </span>
                {% elseif rejected_revision %}
                    <span class="shrink-0 inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">
                        {{ 'status.rejected'|trans({}, 'activity_content') }}
                    </span>
                {% elseif not active %}
                    <span class="shrink-0 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-400">
                        {{ 'status.no_revision'|trans({}, 'activity_content') }}
                    </span>
                {% endif %}
            </div>
            {% if active %}
                <p class="truncate text-xs text-gray-400">
                    {% if slot.teacher %}
                        {{ active.revisedAt|date('d/m/Y') }}
                    {% else %}
                        {{ active.revisedAt|date('d/m/Y') }} · {{ active.uploadedBy.name.lastName }}, {{ active.uploadedBy.name.firstName }}
                    {% endif %}
                </p>
            {% endif %}
        </div>

        {% if can_manage or can_manage_as_uploader or can_review %}
            <button type="button" data-action="live#action" data-live-action-param="toggleRevisionPanel" data-live-id-param="{{ did }}"
                    class="shrink-0 transition-colors {{ revisionPanelDocumentId == did ? 'text-forest-600' : 'text-gray-300 hover:text-forest-600' }}"
                    title="{{ 'revision.manage'|trans({}, 'activity_content') }}">
                {{ ux_icon('heroicons:clock', {class: 'h-4 w-4'}) }}
            </button>
        {% endif %}

        {% if can_manage or can_manage_as_uploader or can_review or can_withdraw %}
            {% if confirmingDeleteDocumentId == did %}
                <span class="shrink-0 inline-flex items-center gap-1">
                    <button type="button" data-action="live#action" data-live-action-param="deleteDocument" data-live-id-param="{{ did }}"
                            class="rounded-md bg-red-600 px-1.5 py-0.5 text-xs font-medium text-white">{{ 'confirm_yes'|trans({}, 'activity_content') }}</button>
                    <button type="button" data-action="live#action" data-live-action-param="cancelDeleteDocument"
                            class="rounded-md border border-gray-200 px-1.5 py-0.5 text-xs text-gray-600">{{ 'cancel'|trans({}, 'activity_content') }}</button>
                </span>
            {% else %}
                {# A teacher who can only withdraw their own submission (no folder permission at
                   all) gets a tooltip that actually explains what the trash icon does here,
                   instead of the generic "delete" a folder manager already knows the meaning of. #}
                <button type="button" data-action="live#action" data-live-action-param="askDeleteDocument" data-live-id-param="{{ did }}"
                        class="shrink-0 text-gray-300 hover:text-red-600 transition-colors"
                        title="{{ ((can_manage or can_manage_as_uploader or can_review) ? 'delete'|trans({}, 'activity_content') : 'submission.withdraw_hint'|trans({}, 'activity_content')) }}">
                    {{ ux_icon('heroicons:trash', {class: 'h-4 w-4'}) }}
                </button>
            {% endif %}
        {% endif %}
    </div>

    {% if rejected_revision and not read_only %}
        <div class="ml-4 space-y-1.5 rounded-lg border border-red-100 bg-red-50/40 px-3 py-2.5">
            <p class="flex flex-wrap items-center gap-x-1.5 text-xs font-medium text-red-700">
                {{ ux_icon('heroicons:exclamation-circle', {class: 'h-4 w-4 shrink-0'}) }}
                {% if rejected_revision.reviewedBy %}
                    {{ 'revision.rejected_by'|trans({'%name%': rejected_revision.reviewedBy.name.firstName ~ ' ' ~ rejected_revision.reviewedBy.name.lastName, '%version%': rejected_revision.version}, 'activity_content') }}
                {% else %}
                    {{ 'revision.rejected_plain'|trans({'%version%': rejected_revision.version}, 'activity_content') }}
                {% endif %}
            </p>
            <p class="whitespace-pre-line border-l-2 border-red-200 pl-3 text-sm text-gray-700">{{ rejected_revision.reviewResult ?: 'revision.rejected_no_reason'|trans({}, 'activity_content') }}</p>
            {% if can_manage_as_uploader or this.canResubmitRejected(document) %}
                <p class="text-xs text-gray-500">{{ 'revision.rejected_hint'|trans({}, 'activity_content') }}</p>
                {% include 'components/_activity_new_revision_form.html.twig' with {folder: folder, document: document} only %}
            {% endif %}
        </div>
    {% endif %}

{% elseif read_only %}
    <div class="flex items-center gap-2 rounded-lg border border-dashed border-gray-100 bg-gray-50/40 px-2.5 py-1.5">
        {{ ux_icon('heroicons:clock', {class: 'h-4 w-4 text-gray-300 shrink-0'}) }}
        <div class="min-w-0 flex-1">
            {% if slot.teacher %}
                <p class="truncate text-sm font-medium text-gray-600">{{ slot.teacher.name.lastName }}, {{ slot.teacher.name.firstName }}</p>
            {% endif %}
            <span class="block truncate text-sm text-gray-500">{{ slot.displayName }}</span>
        </div>
        <span class="shrink-0 text-xs italic text-gray-400">{{ 'status.no_revision'|trans({}, 'activity_content') }}</span>
    </div>
{% else %}
    {# The row a link landed on (…&slot=…): scrolled to, pulsed, and focused so Enter opens its file chooser. #}
    {% set slot_landed = highlightedSlotKey != '' and this.getSlotToHighlight(activity) == slot.key %}
    <input type="hidden" name="items[{{ index }}][slotKey]" value="{{ slot.key }}" form="{{ form_id }}">
    <div data-role="submission-row"
         data-activity-submissions-target="dropzone"
         data-slot-name="{{ slot.displayName }}"
         tabindex="0"
         {{ (slot_landed ? 'data-controller="scroll-into-view" data-scroll-into-view-focus-value="true"' : '')|raw }}
         data-action="dragenter->activity-submissions#dragEnter dragover->activity-submissions#dragOver dragleave->activity-submissions#dragLeave drop->activity-submissions#drop click->activity-submissions#triggerBrowse keydown->activity-submissions#rowKey"
         class="flex items-center gap-3 rounded-lg border-2 border-dashed {{ slot_landed ? 'border-forest-400 document-highlight-pulse' : 'border-gray-200' }} bg-white px-3 py-2.5 cursor-pointer hover:border-forest-300 hover:bg-forest-50/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-forest-500/40 transition-colors">
        {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-4 w-4 text-gray-400 shrink-0'}) }}
        <div class="min-w-0 flex-1">
            {% if slot.teacher %}
                <p class="truncate text-sm font-medium text-gray-700">{{ slot.teacher.name.lastName }}, {{ slot.teacher.name.firstName }}</p>
            {% endif %}
            <span class="block truncate text-sm text-gray-600">{{ slot.displayName }}</span>
            <span data-activity-submissions-target="preview" class="block truncate text-xs text-gray-400">{{ 'submission.dropzone_hint'|trans({}, 'activity_content') }}</span>
        </div>
        <input type="file" name="files[{{ index }}]" class="sr-only" form="{{ form_id }}" data-activity-submissions-target="input" data-action="change->activity-submissions#change">
    </div>
{% endif %}
