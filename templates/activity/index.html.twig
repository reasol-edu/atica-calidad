{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'page_title'|trans({}, 'activity_content') }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-7xl mx-auto space-y-6">

    <h1 class="text-2xl font-bold text-gray-900">{{ 'page_title'|trans({}, 'activity_content') }}</h1>

    {# ── Tabs ─────────────────────────────────────────────────────────── #}
    <nav class="flex gap-4 overflow-x-auto border-b border-gray-200 sm:gap-6" aria-label="{{ 'tabs.aria'|trans({}, 'activity_content') }}">
        <a href="{{ path('app_activities', {tab: 'mine'}) }}"
           {% if tab == 'mine' %}aria-current="page"{% endif %}
           class="-mb-px inline-flex shrink-0 items-center gap-2 whitespace-nowrap border-b-2 px-1 py-3 text-sm font-medium transition-colors
                  {{ tab == 'mine' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
            {{ ux_icon('heroicons:clipboard-document-check', {class: 'h-4 w-4'}) }}
            {{ 'tabs.mine'|trans({}, 'activity_content') }}
        </a>
        <a href="{{ path('app_activities', {tab: 'view'}) }}"
           {% if tab == 'view' %}aria-current="page"{% endif %}
           class="-mb-px inline-flex shrink-0 items-center gap-2 whitespace-nowrap border-b-2 px-1 py-3 text-sm font-medium transition-colors
                  {{ tab == 'view' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
            {{ ux_icon('heroicons:eye', {class: 'h-4 w-4'}) }}
            {{ 'tabs.view'|trans({}, 'activity_content') }}
        </a>
        {% if canEdit %}
        <a href="{{ path('app_activities', {tab: 'edit'}) }}"
           {% if tab == 'edit' %}aria-current="page"{% endif %}
           class="-mb-px inline-flex shrink-0 items-center gap-2 whitespace-nowrap border-b-2 px-1 py-3 text-sm font-medium transition-colors
                  {{ tab == 'edit' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
            {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4'}) }}
            {{ 'tabs.edit_categories'|trans({}, 'activity_content') }}
        </a>
        {% endif %}
        {% if canEdit or is_granted('educational_centre.reports', centre) %}
        <a href="{{ path('app_activity_tracking') }}"
           class="-mb-px inline-flex shrink-0 items-center gap-2 whitespace-nowrap border-b-2 border-transparent px-1 py-3 text-sm font-medium text-gray-500 transition-colors hover:border-gray-300 hover:text-gray-700">
            {{ ux_icon('heroicons:chart-bar', {class: 'h-4 w-4'}) }}
            {{ 'tabs.tracking'|trans({}, 'activity_content') }}
        </a>
        {% endif %}
    </nav>

    {% if tab == 'edit' and canEdit %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
            <twig:Admin:ActivityCategoryTreeComponent :centre="centre" />
        </div>
    {% elseif tab == 'mine' %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6">
            <twig:MyActivitiesComponent :centre="centre" />
        </div>
    {% else %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6">
            <twig:ActivityBrowserComponent :centre="centre"
                initialCategoryId="{{ app.request.query.get('category', '') }}"
                initialActivityId="{{ app.request.query.get('activity', '') }}"
                initialHighlightDocumentId="{{ app.request.query.get('highlight', '') }}"
                initialSlotKey="{{ app.request.query.get('slot', '') }}" />
        </div>
    {% endif %}

</div>
{% endblock %}
