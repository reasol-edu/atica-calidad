<div {{ attributes }} class="space-y-5">

    {# ── Statistics ─────────────────────────────────────────────────────
       By whose move it is (ActivityObligationStatus::group()): what the teacher has to do — with
       the overdue ones called out inside it rather than as a separate total —, what's waiting for
       someone's approval, what's done and what hasn't opened yet. #}
    {% set overdue_count = this.overdueCount %}
    {# Each tile is also a filter: pressing it lists only that group, pressing it again lists all. #}
    {% set tile_class = 'rounded-xl border px-4 py-3 text-left transition focus:outline-none focus-visible:ring-2 focus-visible:ring-forest-500/40' %}
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <button type="button" data-action="live#action" data-live-action-param="filterByGroup" data-live-group-param="todo"
                aria-pressed="{{ statusFilter == 'todo' ? 'true' : 'false' }}"
                class="{{ tile_class }} border-amber-100 bg-amber-50 hover:border-amber-300 {{ statusFilter == 'todo' ? 'ring-2 ring-amber-400' : '' }}">
            <span class="block text-2xl font-bold text-amber-700">{{ this.countInGroup('todo') }}</span>
            <span class="block text-xs font-medium text-amber-600">{{ 'mine.stat.todo'|trans({}, 'activity_content') }}</span>
            {% if overdue_count > 0 %}
                <span class="mt-0.5 block text-xs font-semibold text-red-600">{{ 'mine.stat.overdue_within'|trans({'%count%': overdue_count}, 'activity_content') }}</span>
            {% endif %}
        </button>
        <button type="button" data-action="live#action" data-live-action-param="filterByGroup" data-live-group-param="waiting"
                aria-pressed="{{ statusFilter == 'waiting' ? 'true' : 'false' }}"
                class="{{ tile_class }} border-sky-100 bg-sky-50 hover:border-sky-300 {{ statusFilter == 'waiting' ? 'ring-2 ring-sky-400' : '' }}">
            <span class="block text-2xl font-bold text-sky-700">{{ this.countInGroup('waiting') }}</span>
            <span class="block text-xs font-medium text-sky-600">{{ 'mine.stat.in_review'|trans({}, 'activity_content') }}</span>
        </button>
        <button type="button" data-action="live#action" data-live-action-param="filterByGroup" data-live-group-param="done"
                aria-pressed="{{ statusFilter == 'done' ? 'true' : 'false' }}"
                class="{{ tile_class }} border-forest-100 bg-forest-50 hover:border-forest-300 {{ statusFilter == 'done' ? 'ring-2 ring-forest-400' : '' }}">
            <span class="block text-2xl font-bold text-forest-700">{{ this.countInGroup('done') }}</span>
            <span class="block text-xs font-medium text-forest-600">{{ 'mine.stat.completed'|trans({}, 'activity_content') }}</span>
        </button>
        <button type="button" data-action="live#action" data-live-action-param="filterByGroup" data-live-group-param="upcoming"
                aria-pressed="{{ statusFilter == 'upcoming' ? 'true' : 'false' }}"
                class="{{ tile_class }} border-gray-100 bg-gray-50 hover:border-gray-300 {{ statusFilter == 'upcoming' ? 'ring-2 ring-gray-400' : '' }}">
            <span class="block text-2xl font-bold text-gray-700">{{ this.countInGroup('upcoming') }}</span>
            <span class="block text-xs font-medium text-gray-500">{{ 'mine.stat.upcoming'|trans({}, 'activity_content') }}</span>
        </button>
    </div>

    {# ── Filter and sort/group ────────────────────────────────────────── #}
    {# The search box keeps a usable minimum width (min-w-64) and the controls wrap onto their own
       line when there isn't room, instead of squeezing the box down to a sliver. #}
    <div class="flex flex-col gap-3 lg:flex-row lg:flex-wrap lg:items-center lg:justify-between">
        <form data-action="submit->live#action:prevent" class="relative w-full lg:w-auto lg:min-w-64 lg:max-w-2xl lg:flex-1">
            {{ ux_icon('heroicons:magnifying-glass', {class: 'pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400'}) }}
            <input type="search" data-model="debounce(300)|searchQuery" value="{{ searchQuery }}"
                   placeholder="{{ 'mine.search_placeholder'|trans({}, 'activity_content') }}"
                   class="w-full rounded-xl border border-gray-200 bg-white py-2 pl-9 {{ searchQuery is not empty ? 'pr-9' : 'pr-3' }} text-sm focus:outline-none focus:ring-2 focus:ring-forest-500/20">
            {% if searchQuery is not empty %}
                <button type="button" data-action="live#action" data-live-action-param="clearSearch"
                        class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-300 hover:text-gray-600">
                    {{ ux_icon('heroicons:x-mark', {class: 'h-4 w-4'}) }}
                </button>
            {% endif %}
        </form>

        <div class="flex flex-wrap items-center gap-3">
            {# A real switch, not another pill: this is an independent on/off filter, not one more
               option in the segmented ordenar/agrupar control right next to it — using the same
               pill shape for both reads as "pick one of five", which it isn't. #}
            <button type="button" role="switch" aria-checked="{{ onlyPending ? 'true' : 'false' }}"
                    data-action="live#action" data-live-action-param="toggleOnlyPending"
                    class="inline-flex shrink-0 items-center gap-2 text-xs font-medium text-gray-600 max-sm:min-h-11">
                <span class="relative inline-flex h-5 w-9 shrink-0 items-center rounded-full transition-colors
                             {{ onlyPending ? 'bg-forest-600' : 'bg-gray-200' }}">
                    <span class="inline-block h-3.5 w-3.5 transform rounded-full bg-white shadow transition-transform
                                 {{ onlyPending ? 'translate-x-[18px]' : 'translate-x-1' }}"></span>
                </span>
                {{ 'mine.only_pending'|trans({}, 'activity_content') }}
            </button>

            <span class="hidden sm:block h-4 w-px bg-gray-200"></span>

            <span class="text-xs font-medium text-gray-500">{{ 'mine.group.label'|trans({}, 'activity_content') }}</span>
            <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="{{ 'mine.group.label'|trans({}, 'activity_content') }}">
                {% for mode in [
                    {key: 'deadline', label: 'mine.group.by_deadline', icon: 'heroicons:clock'},
                    {key: 'profile',  label: 'mine.group.by_profile',  icon: 'heroicons:user'},
                    {key: 'category', label: 'mine.group.by_category', icon: 'heroicons:folder'},
                    {key: 'status',   label: 'mine.group.by_status',   icon: 'heroicons:check-circle'},
                ] %}
                    <button type="button" data-action="live#action" data-live-action-param="setGroupBy" data-live-mode-param="{{ mode.key }}"
                            aria-pressed="{{ groupBy == mode.key ? 'true' : 'false' }}"
                            class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium transition-colors max-sm:min-h-11
                                   {{ groupBy == mode.key ? 'bg-forest-600 text-white' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' }}">
                        {{ ux_icon(mode.icon, {class: 'h-3.5 w-3.5'}) }}
                        {{ mode.label|trans({}, 'activity_content') }}
                    </button>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ── List ─────────────────────────────────────────────────────────── #}
    {% if this.total == 0 %}
        <div class="rounded-xl border border-forest-100 bg-forest-50 px-4 py-10 text-center">
            {{ ux_icon('heroicons:check-badge', {class: 'mx-auto mb-2 h-9 w-9 text-forest-400'}) }}
            <p class="text-sm font-medium text-forest-700">{{ 'mine.empty'|trans({}, 'activity_content') }}</p>
        </div>
    {% elseif groupBy == 'deadline' %}
        {% set rows = this.rows %}
        {% if rows is empty %}
            <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-8 text-center">
                <p class="text-sm text-gray-500">{{ 'mine.no_results'|trans({}, 'activity_content') }}</p>
            </div>
        {% else %}
            <ul class="divide-y divide-gray-100 rounded-xl border border-gray-200 overflow-hidden bg-white">
                {% for row in rows %}
                    {% include 'components/_my_activity_group_row.html.twig' with {row: row} %}
                {% endfor %}
            </ul>
        {% endif %}
    {% else %}
        {% set groups = this.groups %}
        {% if groups is empty %}
            <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-8 text-center">
                <p class="text-sm text-gray-500">{{ 'mine.no_results'|trans({}, 'activity_content') }}</p>
            </div>
        {% else %}
            <div class="space-y-5">
                {% for group in groups %}
                    <div>
                        <h3 class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-gray-500">
                            {{ group.label }}
                            <span class="rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-medium text-gray-500">{{ group.items|length }}</span>
                        </h3>
                        <ul class="divide-y divide-gray-100 rounded-xl border border-gray-200 overflow-hidden bg-white">
                            {% for row in group.rows %}
                                {% include 'components/_my_activity_group_row.html.twig' with {row: row} %}
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}

</div>
