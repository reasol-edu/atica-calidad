{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'page_title'|trans({}, 'document_tree') }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-7xl mx-auto space-y-6">

    <h1 class="text-2xl font-bold text-gray-900">{{ 'page_title'|trans({}, 'document_tree') }}</h1>

    {% if canEdit %}
    {# ── Pestañas ─────────────────────────────────────────────────────── #}
    <nav class="flex gap-6 border-b border-gray-200" aria-label="{{ 'tabs.aria'|trans({}, 'document_tree') }}">
        <a href="{{ path('app_document_tree', {tab: 'view'}) }}"
           {% if tab == 'view' %}aria-current="page"{% endif %}
           class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
                  {{ tab == 'view' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
            {{ ux_icon('heroicons:eye', {class: 'h-4 w-4'}) }}
            {{ 'tabs.view'|trans({}, 'document_tree') }}
        </a>
        <a href="{{ path('app_document_tree', {tab: 'edit'}) }}"
           {% if tab == 'edit' %}aria-current="page"{% endif %}
           class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
                  {{ tab == 'edit' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
            {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4'}) }}
            {{ 'tabs.edit'|trans({}, 'document_tree') }}
        </a>
    </nav>
    {% endif %}

    {% if tab == 'edit' and canEdit %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
            <twig:Admin:DocumentSectionTreeComponent :centre="centre" />
        </div>
    {% else %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs px-6 py-16 text-center">
            {{ ux_icon('heroicons:folder-open', {class: 'mx-auto h-10 w-10 text-gray-300 mb-3'}) }}
            <p class="text-sm text-gray-500">{{ 'view.empty'|trans({}, 'document_tree') }}</p>
        </div>
    {% endif %}

</div>
{% endblock %}
