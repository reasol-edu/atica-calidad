<div {{ attributes.defaults(stimulus_controller('nested-sortable', {
    idAttr: 'listItemId',
    moveAction: 'moveListItem',
    group: 'list-items',
})) }} class="js-list-item-tree space-y-3">
    {% set tree = this.tree %}
    {% set sel  = this.selected %}

    {# ── Desktop (>= lg): full tree, drag and drop ────────────────────────── #}
    <div class="hidden lg:block">
        <div class="mb-3 flex items-center justify-between gap-2">
            <h2 class="text-sm font-semibold text-gray-700">{{ root ? root.name : 'responsibilities.lists.title'|trans({}, 'admin') }}</h2>
            <div class="flex items-center gap-2">
                {% if root and not bulkSelectMode %}
                    <button type="button" data-action="live#action" data-live-action-param="selectItem" data-live-id-param="{{ root.id }}"
                            class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                        {{ ux_icon('heroicons:pencil-square', {class: 'h-3.5 w-3.5'}) }}
                        {{ 'responsibilities.lists.edit_list'|trans({}, 'admin') }}
                    </button>
                {% endif %}
                {% include 'components/Admin/_list_item_teacher_tools.html.twig' %}
                {% include 'components/Admin/_list_item_bulk_toggle.html.twig' %}
                <button type="button" data-action="live#action" data-live-action-param="toggleAdd" data-live-parent-id-param="{{ this.rootSentinel }}"
                        class="inline-flex items-center gap-1.5 rounded-lg bg-forest-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-forest-700 transition-colors">
                    {{ ux_icon('heroicons:plus', {class: 'h-3.5 w-3.5'}) }}
                    {{ 'responsibilities.lists.add_root'|trans({}, 'admin') }}
                </button>
            </div>
        </div>

        {% if addingParentId == this.rootSentinel %}
            <form data-action="submit->live#action:prevent" data-live-action-param="addItem" data-live-parent-id-param=""
                  class="mb-3 flex items-center gap-2">
                <input type="text" data-model="norender|addName" value="{{ addName }}" autofocus
                       placeholder="{{ 'responsibilities.lists.field.name_placeholder'|trans({}, 'admin') }}" aria-label="{{ 'responsibilities.lists.field.name'|trans({}, 'admin') }}"
                       class="min-w-0 flex-1 rounded-md border border-gray-200 bg-white px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-forest-500/20">
                <button type="submit" class="shrink-0 rounded-md bg-forest-600 px-2.5 py-1.5 text-white hover:bg-forest-700">
                    {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
                </button>
            </form>
            {% if errors.add is defined %}<p class="mb-3 text-xs text-red-600">{{ errors.add }}</p>{% endif %}
        {% endif %}

        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white p-2">
            {% if tree is empty %}
                <p class="px-2 py-6 text-center text-xs italic text-gray-400">{{ 'responsibilities.lists.items.empty'|trans({}, 'admin') }}</p>
            {% endif %}
            <ul class="js-list-item-list" data-parent-id="{{ this.scopeParentId }}">
                {% for node in tree %}
                    {% include 'components/Admin/_list_item_node.html.twig' with {node: node, depth: 0} %}
                {% endfor %}
            </ul>
        </div>
    </div>

    {# ── Mobile (< lg): breadcrumbs, no dragging ───────────────────────────── #}
    <div class="lg:hidden space-y-3">
        {% set visible    = this.visibleItems %}
        {% set breadcrumb = this.breadcrumb %}

        <nav class="flex flex-wrap items-center gap-1 text-sm">
            <button type="button" data-action="live#action" data-live-action-param="openLevel" data-live-id-param="{{ this.scopeParentId }}"
                    class="inline-flex items-center gap-1 rounded-md px-2 py-1 font-medium
                           {{ currentParentId == this.scopeParentId ? 'bg-forest-50 text-forest-700' : 'text-gray-500 hover:bg-gray-100' }}">
                {{ ux_icon('heroicons:home', {class: 'h-4 w-4'}) }}
                {{ root ? root.name : 'responsibilities.lists.root'|trans({}, 'admin') }}
            </button>
            {% for crumb in breadcrumb %}
                {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 text-gray-300 shrink-0'}) }}
                <button type="button" data-action="live#action" data-live-action-param="openLevel" data-live-id-param="{{ crumb.id }}"
                        class="rounded-md px-2 py-1 font-medium
                               {{ currentParentId == crumb.id.toRfc4122 ? 'bg-forest-50 text-forest-700' : 'text-gray-500 hover:bg-gray-100' }}">
                    {{ crumb.name }}
                </button>
            {% endfor %}
        </nav>

        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
            <div class="flex flex-wrap items-center gap-2 bg-gray-50/70 px-4 py-2.5 border-b border-gray-100">
                {{ ux_icon('heroicons:rectangle-group', {class: 'h-4 w-4 text-gray-400'}) }}
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                    {{ breadcrumb is empty and not root ? 'responsibilities.lists.col.roots'|trans({}, 'admin') : 'responsibilities.lists.col.children'|trans({}, 'admin') }}
                </span>
                {% if visible|length > 1 %}
                    <button type="button" data-action="live#action" data-live-action-param="sortAlphabetically"
                            class="shrink-0 inline-flex items-center justify-center rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors"
                            aria-label="{{ 'responsibilities.lists.sort_alphabetically'|trans({}, 'admin') }}" title="{{ 'responsibilities.lists.sort_alphabetically'|trans({}, 'admin') }}">
                        {{ ux_icon('heroicons:bars-arrow-down', {class: 'h-4 w-4'}) }}
                    </button>
                {% endif %}
                <span class="text-xs text-gray-400">{{ visible|length }}</span>
                <span class="ml-auto flex items-center gap-2">
                    {% if root and not bulkSelectMode %}
                        <button type="button" data-action="live#action" data-live-action-param="selectItem" data-live-id-param="{{ root.id }}"
                                class="inline-flex items-center gap-1 rounded-md border border-gray-200 bg-white px-2 py-1 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                            {{ ux_icon('heroicons:pencil-square', {class: 'h-3.5 w-3.5'}) }}
                            {{ 'responsibilities.lists.edit_list'|trans({}, 'admin') }}
                        </button>
                    {% endif %}
                    {% include 'components/Admin/_list_item_teacher_tools.html.twig' %}
                    {% include 'components/Admin/_list_item_bulk_toggle.html.twig' %}
                </span>
            </div>

            {% if visible is empty %}
                <p class="px-4 py-6 text-center text-xs italic text-gray-400">{{ 'responsibilities.lists.items.empty'|trans({}, 'admin') }}</p>
            {% else %}
                <ul class="divide-y divide-gray-50">
                    {% for item in visible %}
                        {% set is_sel = selectedId == item.id.toRfc4122 %}
                        <li class="flex items-center">
                            {% if bulkSelectMode %}
                                <label class="flex flex-1 items-center gap-2 px-4 py-2.5 min-w-0 cursor-pointer">
                                    <input type="checkbox" value="{{ item.id }}" data-model="bulkSelectedIds" {{ item.id.toRfc4122 in bulkSelectedIds ? 'checked' : '' }}
                                           class="h-4 w-4 shrink-0 rounded border-gray-300 text-violet-600 focus:ring-violet-500">
                                    <span class="flex-1 min-w-0 truncate text-sm text-gray-800">{{ item.name }}</span>
                                    {% if not item.active %}
                                        <span title="{{ 'responsibilities.lists.inactive'|trans({}, 'admin') }}"
                                              class="shrink-0 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-400">
                                            {{ ux_icon('heroicons:eye-slash', {class: 'h-3 w-3'}) }}
                                        </span>
                                    {% endif %}
                                </label>
                            {% else %}
                                <button type="button"
                                        data-action="live#action"
                                        data-live-action-param="selectItem"
                                        data-live-id-param="{{ item.id }}"
                                        class="flex flex-1 items-center gap-2 px-4 py-2.5 text-left transition-colors min-w-0
                                               {{ is_sel ? 'bg-forest-50 ring-1 ring-inset ring-forest-200' : 'hover:bg-gray-50' }}">
                                    <span class="flex-1 min-w-0 truncate text-sm {{ is_sel ? 'font-semibold text-forest-800' : 'text-gray-800' }}">
                                        {{ item.name }}
                                    </span>
                                    {% if not item.active %}
                                        <span title="{{ 'responsibilities.lists.inactive'|trans({}, 'admin') }}"
                                              class="shrink-0 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-400">
                                            {{ ux_icon('heroicons:eye-slash', {class: 'h-3 w-3'}) }}
                                        </span>
                                    {% endif %}
                                    {% if item.children|length > 0 %}
                                        <span class="shrink-0 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">
                                            {{ item.children|length }}
                                        </span>
                                    {% endif %}
                                </button>
                            {% endif %}
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="openLevel"
                                    data-live-id-param="{{ item.id }}"
                                    aria-label="{{ 'responsibilities.lists.action.open'|trans({}, 'admin') }}" title="{{ 'responsibilities.lists.action.open'|trans({}, 'admin') }}"
                                    class="shrink-0 inline-flex items-center justify-center p-2.5 text-gray-300 hover:text-forest-500 transition-colors">
                                {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <form data-action="submit->live#action:prevent"
                  data-live-action-param="addItem"
                  data-live-parent-id-param="{{ currentParentId }}"
                  class="flex items-center gap-2 border-t border-gray-100 bg-gray-50/40 px-3 py-2.5">
                <input type="text"
                       data-model="norender|addName"
                       value="{{ addName }}"
                       placeholder="{{ 'responsibilities.lists.field.name_placeholder'|trans({}, 'admin') }}" aria-label="{{ 'responsibilities.lists.field.name'|trans({}, 'admin') }}"
                       class="min-w-0 flex-1 rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-sm
                              placeholder-gray-400 focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-500/20">
                <button type="submit"
                        class="inline-flex shrink-0 items-center justify-center rounded-lg bg-forest-600 p-1.5 text-white
                               hover:bg-forest-700 transition-colors"
                        aria-label="{{ 'responsibilities.lists.add'|trans({}, 'admin') }}" title="{{ 'responsibilities.lists.add'|trans({}, 'admin') }}">
                    {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
                </button>
            </form>
            {% if errors.add is defined %}<p class="px-3 pb-2 text-xs text-red-600">{{ errors.add }}</p>{% endif %}
        </div>
    </div>

    {# ── Bulk association action bar (both views feed the same bulkSelectedIds) ── #}
    {% if bulkSelectMode %}
        <div class="overflow-hidden rounded-xl border border-violet-200 bg-violet-50/60 px-4 py-3">
            {% set bulk_groups = this.associationGroups %}
            {# «Marcar por nombre»: checks every leaf with that name (or containing it, «Búsqueda parcial») under the chosen branch, replacing
               what was checked. #}
            {% set mark_within = this.markWithinOptions %}
            {% if mark_within is not empty %}
                <form data-action="submit->live#action:prevent" data-live-action-param="markByName"
                      class="mb-2 flex flex-wrap items-center gap-2" data-testid="mark-by-name">
                    <span class="text-sm font-medium text-violet-800">{{ 'responsibilities.lists.bulk.mark.label'|trans({}, 'admin') }}</span>
                    <input type="text" data-model="norender|markName" value="{{ markName }}"
                           placeholder="{{ 'responsibilities.lists.bulk.mark.placeholder'|trans({}, 'admin') }}"
                           aria-label="{{ 'responsibilities.lists.bulk.mark.label'|trans({}, 'admin') }}"
                           class="min-w-[12rem] flex-1 rounded-lg border border-violet-200 bg-white px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-violet-500/20">
                    <select data-model="norender|markWithinId" aria-label="{{ 'responsibilities.lists.bulk.mark.within'|trans({}, 'admin') }}"
                            class="max-w-[16rem] rounded-lg border border-violet-200 bg-white px-2 py-1.5 text-xs text-gray-700">
                        {% for option in mark_within %}
                            <option value="{{ option.id }}" {{ option.id == markWithinId ? 'selected' : '' }}>{{ 'responsibilities.lists.bulk.mark.within_option'|trans({'%name%': option.label}, 'admin') }}</option>
                        {% endfor %}
                    </select>
                    <label class="inline-flex shrink-0 cursor-pointer items-center gap-1.5 text-xs text-violet-800"
                           title="{{ 'responsibilities.lists.bulk.mark.partial_title'|trans({}, 'admin') }}">
                        <input type="checkbox" data-model="norender|markPartial" {{ markPartial ? 'checked' : '' }} data-testid="mark-partial"
                               class="h-4 w-4 rounded border-violet-300 text-violet-600 focus:ring-violet-500">
                        {{ 'responsibilities.lists.bulk.mark.partial'|trans({}, 'admin') }}
                    </label>
                    <button type="submit" class="shrink-0 rounded-lg border border-violet-300 bg-white px-3 py-1.5 text-xs font-medium text-violet-700 hover:bg-violet-50 transition-colors">
                        {{ 'responsibilities.lists.bulk.mark.submit'|trans({}, 'admin') }}
                    </button>
                </form>
            {% endif %}
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-medium text-violet-800">
                    {{ 'responsibilities.lists.bulk.count'|trans({'%count%': bulkSelectedIds|length}, 'admin') }}
                </span>

                {% if bulk_groups is not empty %}
                    <select data-model="bulkAssociationMode" aria-label="{{ 'responsibilities.lists.bulk.mode'|trans({}, 'admin') }}"
                            class="rounded-lg border border-violet-200 bg-white px-2 py-1.5 text-xs text-gray-700">
                        {% for mode in ['add', 'replace', 'remove'] %}
                            <option value="{{ mode }}" {{ bulkAssociationMode == mode ? 'selected' : '' }}>{{ ('responsibilities.lists.bulk.mode_' ~ mode)|trans({}, 'admin') }}</option>
                        {% endfor %}
                    </select>
                    {# data-live-ignore so it survives the re-renders bulkSelectedIds triggers on every checkbox click (kept live, unlike
                       associationKeys, so the count above updates). Keyed by bulkAssociationRound on a wrapper outside the ignored part,
                       like the teacher picker: after «Asignar» or «Quitar» a fresh, empty picker replaces it — otherwise the profiles
                       just assigned stayed chosen and were sent again with the next ones. #}
                    <div id="bulk-association-picker-{{ bulkAssociationRound }}" class="min-w-[14rem] flex-1"><div data-live-ignore>
                        <select multiple data-controller="tom-select"
                                data-tom-select-placeholder-value="{{ 'responsibilities.lists.association.picker_placeholder'|trans({}, 'admin') }}"
                                data-tom-select-no-results-value="{{ 'responsibilities.lists.association.picker_no_results'|trans({}, 'admin') }}"
                                data-model="norender|bulkAssociationKeys"
                                aria-label="{{ 'responsibilities.lists.association.title'|trans({}, 'admin') }}"
                                class="w-full text-sm ts-local">
                            {% for group in bulk_groups %}
                                <optgroup label="{{ group.name }}">
                                    {% for option in group.options %}
                                        <option value="{{ option.key }}" {{ option.key in bulkAssociationKeys ? 'selected' : '' }}>{{ option.label }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                    </div></div>
                    <button type="button" data-action="live#action" data-live-action-param="bulkSaveAssociation"
                            {{ bulkSelectedIds is empty ? 'disabled' : '' }}
                            class="shrink-0 rounded-lg bg-violet-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-violet-700 transition-colors disabled:cursor-not-allowed disabled:opacity-50">
                        {{ 'responsibilities.lists.bulk.assign'|trans({}, 'admin') }}
                    </button>
                    <button type="button" data-action="live#action" data-live-action-param="bulkClearAssociations"
                            {{ bulkSelectedIds is empty ? 'disabled' : '' }}
                            class="shrink-0 rounded-lg border border-violet-300 bg-white px-3 py-1.5 text-xs font-medium text-violet-700 hover:bg-violet-50 transition-colors disabled:cursor-not-allowed disabled:opacity-50">
                        {{ 'responsibilities.lists.bulk.clear'|trans({}, 'admin') }}
                    </button>
                {% endif %}

                {% set move_options = this.bulkMoveTargetOptions %}
                {# Keyed by the current selection (not a stable id like #bulk-association-picker):
                   the option list itself depends on which items are checked (a checked branch and
                   its own descendants are never valid destinations), so it must be torn down and
                   rebuilt with fresh options whenever the selection changes, not just preserved
                   across re-renders. The id goes on a wrapper that is NOT data-live-ignore: an ignored element
                   whose id changes is never removed by the re-render, and the old pickers piled up. #}
                <div id="bulk-move-picker-{{ bulkSelectedIds|join('_') }}" class="min-w-[14rem] flex-1"><div data-live-ignore>
                    <select data-controller="tom-select"
                            data-tom-select-placeholder-value="{{ 'responsibilities.lists.bulk.move_picker_placeholder'|trans({}, 'admin') }}"
                            data-tom-select-no-results-value="{{ 'responsibilities.lists.association.picker_no_results'|trans({}, 'admin') }}"
                            data-model="norender|bulkMoveTargetId"
                            class="w-full text-sm ts-local">
                        <option value="">{{ 'responsibilities.lists.bulk.move_root_option'|trans({}, 'admin') }}</option>
                        {% for option in move_options %}
                            <option value="{{ option.id }}" {{ option.id == bulkMoveTargetId ? 'selected' : '' }}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                </div></div>
                {% if bulkMoveConfirmKey != '' and bulkMoveConfirmKey == this.bulkMoveKey %}
                    {% set impact = this.moveImpact %}
                    <span class="basis-full text-xs text-amber-800">
                        {% if impact.forms > 0 %}<span data-testid="move-form-usage">{{ 'responsibilities.lists.bulk.move_confirm_forms'|trans({'%count%': impact.forms}, 'admin') }}</span>{% endif %}
                        {% if impact.profiles %}{{ 'responsibilities.lists.bulk.move_confirm'|trans({}, 'admin') }}{% else %}{{ 'responsibilities.lists.bulk.move_confirm_ask'|trans({}, 'admin') }}{% endif %}
                    </span>
                    <button type="button" data-action="live#action" data-live-action-param="confirmBulkMove"
                            class="shrink-0 rounded-lg bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-700 transition-colors">
                        {{ 'responsibilities.lists.bulk.move_confirm_yes'|trans({}, 'admin') }}
                    </button>
                    <button type="button" data-action="live#action" data-live-action-param="cancelBulkMove"
                            class="shrink-0 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                        {{ 'responsibilities.lists.detail.cancel'|trans({}, 'admin') }}
                    </button>
                {% else %}
                    <button type="button" data-action="live#action" data-live-action-param="bulkMoveSelected"
                            {{ bulkSelectedIds is empty ? 'disabled' : '' }}
                            class="shrink-0 rounded-lg bg-violet-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-violet-700 transition-colors disabled:cursor-not-allowed disabled:opacity-50">
                        {{ 'responsibilities.lists.bulk.move'|trans({}, 'admin') }}
                    </button>
                {% endif %}
                {% if errors.bulkMove is defined %}
                    <span class="text-xs text-red-600">{{ errors.bulkMove }}</span>
                {% endif %}

                <span class="ml-auto"></span>

                {% if confirmingBulkDelete %}
                    <span class="text-xs text-violet-800">
                        {{ 'responsibilities.lists.bulk.delete_confirm'|trans({'%count%': bulkSelectedIds|length}, 'admin') }}
                        {% set usage = this.formUsage %}{% if usage > 0 %}<strong class="text-amber-800" data-testid="form-usage">{{ 'responsibilities.lists.form_usage'|trans({'%count%': usage}, 'admin') }}</strong>{% endif %}
                    </span>
                    <button type="button" data-action="live#action" data-live-action-param="bulkDeleteSelected"
                            class="shrink-0 inline-flex items-center rounded-lg bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-700 transition-colors">
                        {{ 'responsibilities.lists.detail.confirm_yes'|trans({}, 'admin') }}
                    </button>
                    <button type="button" data-action="live#action" data-live-action-param="cancelBulkDelete"
                            class="shrink-0 inline-flex items-center rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                        {{ 'responsibilities.lists.detail.cancel'|trans({}, 'admin') }}
                    </button>
                {% else %}
                    {# Kept next to the trigger, not instead of it: unlike the single-item panel,
                       losing this selection to dismiss the error would cost a lot of re-checking. #}
                    {% if errors.bulkDelete is defined %}
                        <span class="text-xs text-red-600">{{ errors.bulkDelete }}</span>
                    {% endif %}
                    <button type="button" data-action="live#action" data-live-action-param="askBulkDelete"
                            {{ bulkSelectedIds is empty ? 'disabled' : '' }}
                            class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors disabled:cursor-not-allowed disabled:opacity-50">
                        {{ ux_icon('heroicons:trash', {class: 'h-3.5 w-3.5'}) }}
                        {{ 'responsibilities.lists.bulk.delete'|trans({}, 'admin') }}
                    </button>
                {% endif %}
            </div>
            {# Teachers of the checked items: add, remove or replace them. Stable id like the association picker above. #}
            {% set bulk_teacher_options = this.teacherOptions %}
            {% if bulk_teacher_options is not empty %}
                <div class="mt-2 flex flex-wrap items-center gap-2" data-testid="bulk-teachers">
                    <span class="text-sm font-medium text-violet-800">{{ 'responsibilities.lists.teachers.bulk.label'|trans({}, 'admin') }}</span>
                    <select data-model="bulkTeacherMode" aria-label="{{ 'responsibilities.lists.teachers.bulk.mode'|trans({}, 'admin') }}"
                            class="rounded-lg border border-violet-300 bg-white px-2 py-1.5 text-xs text-violet-800">
                        {% for mode in ['add', 'remove', 'replace'] %}
                            <option value="{{ mode }}" {{ bulkTeacherMode == mode ? 'selected' : '' }}>{{ ('responsibilities.lists.teachers.bulk.mode_' ~ mode)|trans({}, 'admin') }}</option>
                        {% endfor %}
                    </select>
                    {# Keyed wrapper outside data-live-ignore, like the move picker: an ignored element whose id changes is never removed. #}
                    <div id="bulk-teacher-picker-{{ bulkTeacherRound }}" class="min-w-[14rem] flex-1"><div data-live-ignore>
                        <select multiple data-controller="tom-select"
                                data-tom-select-placeholder-value="{{ 'responsibilities.lists.teachers.picker_placeholder'|trans({}, 'admin') }}"
                                data-tom-select-no-results-value="{{ 'responsibilities.lists.association.picker_no_results'|trans({}, 'admin') }}"
                                data-model="bulkTeacherIds"
                                aria-label="{{ 'responsibilities.lists.teachers.title'|trans({}, 'admin') }}"
                                class="w-full text-sm ts-local">
                            {% for teacher in bulk_teacher_options %}
                                <option value="{{ teacher.id.toRfc4122 }}" {{ teacher.id.toRfc4122 in bulkTeacherIds ? 'selected' : '' }}>{{ teacher.name.full }} · {{ teacher.username }}</option>
                            {% endfor %}
                        </select>
                    </div></div>
                    <button type="button" data-action="live#action" data-live-action-param="bulkApplyTeachers"
                            {{ bulkSelectedIds is empty or bulkTeacherIds is empty ? 'disabled' : '' }}
                            class="shrink-0 rounded-lg bg-violet-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-violet-700 transition-colors disabled:cursor-not-allowed disabled:opacity-50">
                        {{ 'responsibilities.lists.teachers.bulk.apply'|trans({}, 'admin') }}
                    </button>
                    {% set bulk_teacher_summary = this.bulkTeacherSummary %}
                    {% if bulk_teacher_summary %}
                        <span class="basis-full text-xs text-violet-700" data-testid="bulk-teacher-summary">{{ bulk_teacher_summary }}</span>
                    {% endif %}
                </div>
            {% endif %}
            <p class="mt-1.5 text-xs text-violet-600">{{ 'responsibilities.lists.bulk.hint'|trans({}, 'admin') }}</p>
        </div>
    {% endif %}

    {# ── Detail of the selected item (both views select into the same panel) ── #}
    {% if sel %}
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
            <div class="flex items-center gap-2 bg-gray-50/70 px-4 py-2.5 border-b border-gray-100">
                {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4 text-gray-400'}) }}
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">{{ 'responsibilities.lists.detail.title'|trans({}, 'admin') }}</span>
            </div>

            <div class="px-4 py-4 sm:px-6 space-y-4">
                <form data-action="submit->live#action:prevent" data-live-action-param="saveDetail"
                      class="grid grid-cols-1 gap-3 sm:grid-cols-3">

                    <div class="sm:col-span-2">
                        <label class="mb-1 block text-xs font-medium text-gray-600">{{ 'responsibilities.lists.field.name'|trans({}, 'admin') }}</label>
                        <input type="text"
                               data-model="norender|editName"
                               value="{{ editName }}"
                               class="block w-full rounded-lg border bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2
                                      {{ errors.name is defined ? 'border-red-300 focus:ring-red-400/20' : 'border-gray-200 focus:border-forest-500 focus:ring-forest-500/20' }}">
                        {% if errors.name is defined %}<p class="mt-1 text-xs text-red-600">{{ errors.name }}</p>{% endif %}
                    </div>

                    {# The managed list's own position among the lists is set from the lists page. #}
                    <div class="flex items-end gap-2 sm:col-span-1 {{ root and sel.id == root.id ? 'hidden' : '' }}">
                        <button type="button" data-action="live#action" data-live-action-param="moveUp" data-live-id-param="{{ sel.id }}"
                                class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white p-2 text-gray-500 hover:bg-gray-50 transition-colors"
                                aria-label="{{ 'responsibilities.lists.detail.move_up'|trans({}, 'admin') }}" title="{{ 'responsibilities.lists.detail.move_up'|trans({}, 'admin') }}">
                            {{ ux_icon('heroicons:chevron-up', {class: 'h-4 w-4'}) }}
                        </button>
                        <button type="button" data-action="live#action" data-live-action-param="moveDown" data-live-id-param="{{ sel.id }}"
                                class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white p-2 text-gray-500 hover:bg-gray-50 transition-colors"
                                aria-label="{{ 'responsibilities.lists.detail.move_down'|trans({}, 'admin') }}" title="{{ 'responsibilities.lists.detail.move_down'|trans({}, 'admin') }}">
                            {{ ux_icon('heroicons:chevron-down', {class: 'h-4 w-4'}) }}
                        </button>
                    </div>

                    <div class="sm:col-span-3">
                        <span class="mb-2 block text-xs font-medium text-gray-600">{{ 'responsibilities.lists.field.active'|trans({}, 'admin') }}</span>
                        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                            <twig:Form:RadioCard
                                name="list_item_active"
                                value="1"
                                label="{{ 'responsibilities.lists.field.active_yes'|trans({}, 'admin') }}"
                                help="{{ 'responsibilities.lists.field.active_yes_help'|trans({}, 'admin') }}"
                                :checked="editActive"
                                data-model="editActive"
                            />
                            <twig:Form:RadioCard
                                name="list_item_active"
                                value="0"
                                label="{{ 'responsibilities.lists.field.active_no'|trans({}, 'admin') }}"
                                help="{{ 'responsibilities.lists.field.active_no_help'|trans({}, 'admin') }}"
                                :checked="not editActive"
                                data-model="editActive"
                            />
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-4 py-2 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                            {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}{{ 'responsibilities.lists.detail.save'|trans({}, 'admin') }}
                        </button>
                    </div>
                </form>

                {# ── The lists this list is associated with (on the list itself) ── #}
                {# Every section of the panel carries an id keyed to the selected item: when the selection changes (or the list's own
                   card comes and goes), the re-render replaces each section whole instead of morphing one into the next, which would
                   move a Tom Select picker (data-live-ignore) into the wrong section. #}
                {% if root and sel.id == root.id %}
                    <div id="linked-lists-card-{{ sel.id.toRfc4122 }}" class="border-t border-gray-100 pt-4" data-testid="linked-lists">
                        <label class="mb-1 block text-xs font-medium text-gray-600">{{ 'responsibilities.lists.linked_lists.title'|trans({}, 'admin') }}</label>
                        <p class="mb-2 text-xs text-gray-400">{{ 'responsibilities.lists.linked_lists.help'|trans({'%list%': root.name}, 'admin') }}</p>
                        <form data-action="submit->live#action:prevent" data-live-action-param="saveLinkedLists" class="flex flex-wrap items-center gap-2">
                            <div id="linked-lists-{{ sel.id.toRfc4122 }}" data-live-ignore class="min-w-0 flex-1">
                                <select multiple data-controller="tom-select"
                                        data-tom-select-placeholder-value="{{ 'responsibilities.lists.linked_lists.placeholder'|trans({}, 'admin') }}"
                                        data-tom-select-no-results-value="{{ 'responsibilities.lists.association.picker_no_results'|trans({}, 'admin') }}"
                                        data-model="norender|linkedListIds"
                                        aria-label="{{ 'responsibilities.lists.linked_lists.title'|trans({}, 'admin') }}"
                                        class="w-full text-sm ts-local">
                                    {% for list in this.linkableLists %}
                                        <option value="{{ list.id.toRfc4122 }}" {{ list.id.toRfc4122 in linkedListIds ? 'selected' : '' }}>{{ list.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button type="submit" class="shrink-0 rounded-lg bg-forest-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-forest-700 transition-colors">
                                {{ 'responsibilities.lists.association.save'|trans({}, 'admin') }}
                            </button>
                        </form>
                        {% if linkedListsConfirmKey != '' %}
                            <div class="mt-2 flex flex-wrap items-center gap-2 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800" data-testid="linked-lists-confirm">
                                {% if linkedListsConfirmCount > 0 %}
                                    <span>{{ 'responsibilities.lists.linked_lists.confirm'|trans({'%count%': linkedListsConfirmCount}, 'admin') }}</span>
                                {% endif %}
                                {% if linkedListsConfirmActivities is not empty %}
                                    <span data-testid="linked-lists-confirm-activities">{{ 'responsibilities.lists.linked_lists.confirm_activities'|trans({'%count%': linkedListsConfirmActivities|length, '%titles%': '«' ~ linkedListsConfirmActivities|join('», «') ~ '»'}, 'admin') }}</span>
                                {% endif %}
                                <button type="button" data-action="live#action" data-live-action-param="saveLinkedLists"
                                        class="rounded-md bg-amber-600 px-2 py-1 font-medium text-white hover:bg-amber-700">{{ 'responsibilities.lists.linked_lists.confirm_yes'|trans({}, 'admin') }}</button>
                                <button type="button" data-action="live#action" data-live-action-param="cancelLinkedLists"
                                        class="rounded-md border border-amber-200 bg-white px-2 py-1 text-amber-800 hover:bg-amber-100">{{ 'responsibilities.lists.detail.cancel'|trans({}, 'admin') }}</button>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {# ── Associated with elements of the associated lists, or plain profiles ── #}
                {% set association_options = this.associationOptions %}
                <div id="associations-panel-{{ sel.id.toRfc4122 }}" class="border-t border-gray-100 pt-4" data-testid="associations-panel">
                    <label class="mb-1 block text-xs font-medium text-gray-600">{{ 'responsibilities.lists.association.title'|trans({}, 'admin') }}</label>
                    <p class="mb-2 text-xs text-gray-400">{{ 'responsibilities.lists.association.help'|trans({}, 'admin') }}</p>

                    {% if association_options is empty %}
                        <p class="text-xs italic text-gray-400">{{ 'responsibilities.lists.association.empty'|trans({}, 'admin') }}</p>
                    {% else %}
                        <form data-action="submit->live#action:prevent" data-live-action-param="saveAssociation"
                              class="flex flex-wrap items-center gap-2">
                            {# TomSelect builds its own sibling DOM (.ts-wrapper) next to this <select>. The
                               LiveComponent re-render that follows every selectItem morphs this panel in place and
                               strips that sibling — after the first item, the picker becomes an invisible, dead
                               control (only the first item stays editable). data-live-ignore keeps the widget intact
                               across same-item re-renders; the id keyed on sel.id forces a real teardown/rebuild
                               (Stimulus disconnect -> TomSelect.destroy, then connect) whenever a different item is
                               selected, so its own options/value load fresh. #}
                            <div id="assoc-picker-{{ sel.id.toRfc4122 }}" data-live-ignore class="min-w-0 flex-1">
                                <select multiple data-controller="tom-select"
                                        data-tom-select-placeholder-value="{{ 'responsibilities.lists.association.picker_placeholder'|trans({}, 'admin') }}"
                                        data-tom-select-no-results-value="{{ 'responsibilities.lists.association.picker_no_results'|trans({}, 'admin') }}"
                                        data-model="norender|associationKeys"
                                        aria-label="{{ 'responsibilities.lists.association.title'|trans({}, 'admin') }}"
                                        class="w-full text-sm ts-local">
                                    {% for group in this.associationGroups %}
                                        <optgroup label="{{ group.name }}">
                                            {% for option in group.options %}
                                                <option value="{{ option.key }}" {{ option.key in associationKeys ? 'selected' : '' }}>{{ option.label }}</option>
                                            {% endfor %}
                                        </optgroup>
                                    {% endfor %}
                                </select>
                            </div>
                            <button type="submit"
                                    class="shrink-0 rounded-lg bg-forest-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-forest-700 transition-colors">
                                {{ 'responsibilities.lists.association.save'|trans({}, 'admin') }}
                            </button>
                        </form>
                    {% endif %}

                    {# Own associations that an ancestor already gives: redundant, can be removed. #}
                    {% for own in sel.associations %}
                        {% set covering = sel.getAncestorCovering(own) %}
                        {% if covering %}
                            <p class="mt-2 text-xs text-amber-700" data-testid="association-redundant">
                                {% if covering.exact %}
                                    {{ 'responsibilities.lists.association.redundant'|trans({'%association%': own.label, '%name%': covering.item.name}, 'admin') }}
                                {% else %}
                                    {{ 'responsibilities.lists.association.covered'|trans({'%association%': own.label, '%covering%': covering.association.label, '%name%': covering.item.name}, 'admin') }}
                                {% endif %}
                            </p>
                        {% endif %}
                    {% endfor %}

                    {# What it inherits as well, grouped by the element it comes from. #}
                    {% set inherited_groups = {} %}
                    {% for pair in sel.inheritedAssociations %}
                        {% set label = pair.association.label %}
                        {% set gid = pair.item.id.toRfc4122 %}
                        {% set group = inherited_groups[gid] ?? {name: pair.item.name, labels: []} %}
                        {% set inherited_groups = inherited_groups|merge({(gid): {name: group.name, labels: group.labels|merge([label])}}) %}
                    {% endfor %}
                    {% for group in inherited_groups %}
                        <p class="mt-2 text-xs text-gray-500" data-testid="association-inherited">
                            {{ 'responsibilities.lists.association.inherited'|trans({'%name%': group.name, '%profile%': group.labels|join(', ')}, 'admin') }}
                        </p>
                    {% endfor %}
                </div>

                {# ── Associated teachers ──────────────────────────────── #}
                {% set teacher_options = this.teacherOptionsFor(sel) %}
                <div id="teachers-panel-{{ sel.id.toRfc4122 }}" class="border-t border-gray-100 pt-4" data-testid="teachers-panel">
                    <label class="mb-1 block text-xs font-medium text-gray-600">{{ 'responsibilities.lists.teachers.title'|trans({}, 'admin') }}</label>
                    <p class="mb-2 text-xs text-gray-400">{{ 'responsibilities.lists.teachers.help'|trans({}, 'admin') }}</p>

                    {% if teacher_options is empty %}
                        <p class="text-xs italic text-gray-400">{{ 'responsibilities.lists.teachers.empty'|trans({}, 'admin') }}</p>
                    {% else %}
                        <form data-action="submit->live#action:prevent" data-live-action-param="saveTeachers"
                              class="flex flex-wrap items-center gap-2">
                            {# Same trap as the profile picker above: Tom Select's own sibling DOM is stripped by the re-render that
                               follows each selection unless it sits inside data-live-ignore, and the id keyed on the selected item
                               makes a different item build a new one with its own value. #}
                            <div id="teachers-{{ sel.id.toRfc4122 }}" data-live-ignore class="min-w-0 flex-1">
                                <select multiple data-controller="tom-select"
                                        data-tom-select-placeholder-value="{{ 'responsibilities.lists.teachers.picker_placeholder'|trans({}, 'admin') }}"
                                        data-tom-select-no-results-value="{{ 'responsibilities.lists.association.picker_no_results'|trans({}, 'admin') }}"
                                        data-model="norender|teacherIds"
                                        aria-label="{{ 'responsibilities.lists.teachers.title'|trans({}, 'admin') }}"
                                        class="w-full text-sm ts-local">
                                    {% for teacher in teacher_options %}
                                        <option value="{{ teacher.id.toRfc4122 }}" {{ teacher.id.toRfc4122 in teacherIds ? 'selected' : '' }}>
                                            {{- teacher.name.full }} · {{ teacher.username }}{{ this.isTeacherOutOfCourse(teacher) ? ' (' ~ 'responsibilities.lists.teachers.out_of_course'|trans({}, 'admin') ~ ')' : '' -}}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button type="submit"
                                    class="shrink-0 rounded-lg bg-forest-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-forest-700 transition-colors">
                                {{ 'responsibilities.lists.teachers.save'|trans({}, 'admin') }}
                            </button>
                        </form>
                    {% endif %}

                    {% set own_out = [] %}
                    {% for teacher in sel.teachers %}
                        {% if this.isTeacherOutOfCourse(teacher) %}{% set own_out = own_out|merge([teacher.name.full]) %}{% endif %}
                    {% endfor %}
                    {% if own_out is not empty %}
                        <p class="mt-2 text-xs text-red-700" data-testid="teachers-out-of-course">
                            {{ 'responsibilities.lists.teachers.out_of_course_note'|trans({'%names%': own_out|join(', ')}, 'admin') }}
                        </p>
                    {% endif %}

                    {# What it inherits as well, grouped by the element it comes from. #}
                    {% set inherited_teacher_groups = {} %}
                    {% for pair in sel.inheritedTeachers %}
                        {% set gid = pair.item.id.toRfc4122 %}
                        {% set group = inherited_teacher_groups[gid] ?? {name: pair.item.name, names: []} %}
                        {% set label = pair.teacher.name.full ~ (this.isTeacherOutOfCourse(pair.teacher) ? ' (' ~ 'responsibilities.lists.teachers.out_of_course'|trans({}, 'admin') ~ ')' : '') %}
                        {% set inherited_teacher_groups = inherited_teacher_groups|merge({(gid): {name: group.name, names: group.names|merge([label])}}) %}
                    {% endfor %}
                    {% for group in inherited_teacher_groups %}
                        <p class="mt-2 text-xs text-gray-500" data-testid="teachers-inherited">
                            {{ 'responsibilities.lists.teachers.inherited'|trans({'%name%': group.name, '%teachers%': group.names|join(', ')}, 'admin') }}
                        </p>
                    {% endfor %}
                </div>

                {# ── Save / delete ────────────────────────────────────── #}
                <div class="flex flex-wrap items-center gap-2 border-t border-gray-100 pt-4">
                    <span class="ml-auto"></span>

                    {% if errors.delete is defined %}
                        <span class="text-xs text-red-600">{{ errors.delete }}</span>
                    {% elseif confirmingDelete %}
                        <span class="text-xs text-gray-600">{{ (sel.leaf ? 'responsibilities.lists.delete_confirm' : 'responsibilities.lists.delete_confirm_with_children')|trans({}, 'admin') }}
                            {% set usage = this.formUsage %}{% if usage > 0 %}<strong class="text-amber-800" data-testid="form-usage">{{ 'responsibilities.lists.form_usage'|trans({'%count%': usage}, 'admin') }}</strong>{% endif %}</span>
                        <button type="button" data-action="live#action" data-live-action-param="deleteSelected"
                                class="inline-flex items-center gap-1.5 rounded-xl bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-700 transition-colors">
                            {{ 'responsibilities.lists.detail.confirm_yes'|trans({}, 'admin') }}
                        </button>
                        <button type="button" data-action="live#action" data-live-action-param="cancelDelete"
                                class="inline-flex items-center rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                            {{ 'responsibilities.lists.detail.cancel'|trans({}, 'admin') }}
                        </button>
                    {% else %}
                        <button type="button" data-action="live#action" data-live-action-param="askDelete"
                                class="inline-flex items-center gap-1.5 rounded-xl border border-red-200 bg-white px-3 py-2 text-sm font-medium text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors">
                            {{ ux_icon('heroicons:trash', {class: 'h-4 w-4'}) }}{{ 'responsibilities.lists.detail.delete'|trans({}, 'admin') }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
</div>
