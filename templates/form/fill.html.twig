{% extends 'layouts/app.html.twig' %}

{% block title %}{{ title }} · {{ app_name }}{% endblock %}

{# One slot of an activity delivered by filling a model in: the form while there is a draft, the delivered document otherwise. #}
{% block content %}
<div class="px-4 sm:px-6 py-6 max-w-4xl mx-auto">
    <div class="mb-4">
        <a href="{{ backUrl }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-forest-600">
            {{ ux_icon('heroicons:arrow-left', {class: 'h-4 w-4'}) }}{{ activity.title }}
        </a>
        <h1 class="mt-1 break-words text-2xl font-bold text-gray-900">{{ title }}</h1>
        <p class="text-sm text-gray-500">{{ submission.modelRevision.code ?: submission.activity.formModel.document.name }} · REV {{ submission.modelRevision.revision.version }}</p>
    </div>

    {% if window.blocked %}
        <p class="mb-4 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">{{ (window.reason.value == 'before_start' ? 'fill.error.before_start' : 'fill.error.after_end')|trans({}, 'forms') }}</p>
    {% endif %}

    {% if editor is defined %}
        {% set labels = {
            saving: 'fill.saving'|trans({}, 'forms'),
            saved: 'fill.saved'|trans({}, 'forms'),
            offline: 'fill.offline'|trans({}, 'forms'),
            stale: 'fill.stale'|trans({}, 'forms'),
            add_row: 'fill.add_row'|trans({}, 'forms'),
            remove_row: 'fill.remove_row'|trans({}, 'forms'),
            edit_text: 'fill.edit_text'|trans({}, 'forms'),
            write_text: 'fill.write_text'|trans({}, 'forms'),
            choose: 'fill.choose'|trans({}, 'forms'),
            yes: 'view.yes'|trans({}, 'forms'),
            no: 'view.no'|trans({}, 'forms'),
            row: 'fill.row'|trans({}, 'forms'),
            pending: 'fill.pending'|trans({}, 'forms'),
            starter_modified: 'fill.starter_modified'|trans({}, 'forms'),
            progress: 'fill.progress'|trans({}, 'forms'),
            add_copy: 'fill.add_copy'|trans({}, 'forms'),
            remove_copy: 'fill.remove_copy'|trans({}, 'forms'),
            confirm_remove_copy: 'fill.confirm_remove_copy'|trans({}, 'forms'),
        } %}
        <div data-controller="form-fill"
             data-form-fill-config-value="{{ editor|json_encode|e('html_attr') }}"
             data-form-fill-labels-value="{{ labels|json_encode|e('html_attr') }}">
            <p class="mb-3 text-sm" role="status" aria-live="polite" data-form-fill-target="status"></p>
            <div class="rounded-2xl border border-gray-200 bg-white px-4 py-5 shadow-xs sm:px-6" data-form-fill-target="canvas"></div>

            <section class="mt-6 rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
                <h2 class="text-base font-semibold text-gray-900">{{ 'fill.deliver_title'|trans({}, 'forms') }}</h2>
                <div data-form-fill-target="problemsBox" class="{{ problems is empty ? 'hidden' : '' }}">
                    <p class="mt-1 text-sm font-medium text-amber-800">{{ 'fill.pending'|trans({}, 'forms') }}</p>
                    <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-amber-800" data-form-fill-target="problems">
                        {% for p in problems %}<li>{{ p.text }}</li>{% endfor %}
                    </ul>
                </div>
                <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                    {% if submission.document is not null or last is not null %}
                        <form method="post" action="{{ path('app_form_discard', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}" class="js-confirm-form"
                              data-confirm="{{ 'fill.confirm_discard'|trans({}, 'forms')|e('html_attr') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('form_discard_' ~ submission.id.toRfc4122) }}">
                            <button type="submit" class="js-confirm-trigger w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 sm:w-auto">{{ 'fill.discard'|trans({}, 'forms') }}</button>
                        </form>
                    {% endif %}
                    {% if canEdit %}
                        <form method="post" action="{{ path('app_form_deliver', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('form_deliver_' ~ submission.id.toRfc4122) }}">
                            <button type="submit" data-form-fill-target="deliver" class="w-full rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 sm:w-auto">{{ 'fill.deliver'|trans({}, 'forms') }}</button>
                        </form>
                    {% endif %}
                </div>
            </section>
        </div>
    {% elseif last is not null %}
        {% set revision = lastRevision %}
        <div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
            {% if revision.pendingReview %}<span class="rounded-full bg-amber-50 px-3 py-1 font-medium text-amber-800">{{ 'fill.status_pending'|trans({}, 'forms') }}</span>
            {% elseif revision.rejected %}<span class="rounded-full bg-red-50 px-3 py-1 font-medium text-red-700">{{ 'fill.status_rejected'|trans({}, 'forms') }}</span>
            {% else %}<span class="rounded-full bg-forest-50 px-3 py-1 font-medium text-forest-700">{{ 'fill.status_approved'|trans({}, 'forms') }}</span>{% endif %}
            <span class="text-gray-500">{{ 'fill.version'|trans({'%version%': revision.version}, 'forms') }}</span>
            <span class="flex-1"></span>
            <a href="{{ path('app_folder_document_revision_download', {folderId: folderId, documentId: documentId, revisionId: revision.id.toRfc4122}) }}"
               class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 font-medium text-gray-700 hover:bg-gray-50">
                {{ ux_icon('heroicons:document-arrow-down', {class: 'h-4 w-4'}) }}PDF
            </a>
            {% if canEdit %}
                <form method="post" action="{{ path('app_form_correct', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('form_correct_' ~ submission.id.toRfc4122) }}">
                    <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-3.5 py-2 font-semibold text-white hover:bg-forest-700">
                        {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4'}) }}{{ 'fill.correct'|trans({}, 'forms') }}
                    </button>
                </form>
            {% endif %}
        </div>
        <article class="rounded-2xl border border-gray-200 bg-white px-5 py-6 shadow-xs sm:px-8">
            {% include 'form/_document.html.twig' with {sections: sections, blank: false} only %}
        </article>
    {% endif %}
</div>
{% endblock %}
