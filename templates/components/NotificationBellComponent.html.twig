{% import 'components/_activity_status.html.twig' as activity_status %}
{% import 'quality/_macros.html.twig' as quality %}
<div {{ attributes.defaults({class: 'relative'}).defaults(stimulus_controller('dropdown')) }}>

    <button type="button"
            data-action="dropdown#toggle"
            aria-label="{{ (this.total > 0 ? 'bell.aria_counts' : 'bell.aria')|trans({'%count%': this.urgentCount, '%total%': this.total}, 'notifications') }}"
            class="relative flex h-11 w-11 items-center justify-center rounded-lg text-gray-500 sm:h-auto sm:w-auto sm:p-1.5 hover:bg-gray-100 hover:text-gray-700 transition-colors">
        {{ ux_icon('heroicons:bell', {class: 'h-5 w-5'}) }}
        {# The number is what is urgent (see getUrgentCount()), not everything pending: it can reach zero. #}
        {% if this.urgentCount > 0 %}
            <span class="absolute -top-0.5 -right-0.5 flex h-4 min-w-4 items-center justify-center rounded-full
                         bg-red-500 px-1 text-[10px] font-semibold leading-none text-white">
                {{ this.urgentCount > 99 ? '99+' : this.urgentCount }}
            </span>
        {% elseif this.total > 0 %}
            {# Something pending, nothing urgent: a quiet dot instead of a number. #}
            <span class="absolute right-1 top-1 h-2 w-2 rounded-full bg-gray-300" aria-hidden="true"></span>
        {% endif %}
    </button>

    <div data-dropdown-target="menu"
         class="hidden absolute right-0 z-40 mt-2 w-80 origin-top-right rounded-xl border border-gray-200
                bg-white shadow-lg overflow-hidden">

        <div class="flex items-baseline justify-between gap-3 border-b border-gray-100 px-4 py-2.5">
            <p class="text-xs font-semibold text-gray-700 uppercase tracking-wide">
                {{ 'bell.title'|trans({}, 'notifications') }}
            </p>
            {% if this.total > 0 %}
                <p class="text-xs text-gray-400">{{ 'bell.summary'|trans({'%count%': this.urgentCount, '%total%': this.total}, 'notifications') }}</p>
            {% endif %}
        </div>

        {% if this.total == 0 %}
            <div class="px-4 py-8 text-center">
                {{ ux_icon('heroicons:check-circle', {class: 'mx-auto h-8 w-8 text-green-300 mb-2'}) }}
                <p class="text-sm text-gray-500">{{ 'bell.empty'|trans({}, 'notifications') }}</p>
            </div>
        {% else %}
            <div class="max-h-80 overflow-y-auto">
                {% set activityItems = this.visibleActivityItems %}
                {% set reviewItems   = this.visibleReviewItems %}

                {% if activityItems is not empty %}
                    <p class="bg-gray-50 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-wide text-gray-400">
                        {{ 'bell.section.activities'|trans({}, 'notifications') }}
                    </p>
                    <ul class="divide-y divide-gray-100">
                        {% for item in activityItems %}
                            {% set entity = item.entity %}
                            <li>
                                <a href="{{ path('app_activities', entity.linkParams) }}"
                                   class="flex items-start gap-3 px-4 py-2.5 hover:bg-gray-50 transition-colors">
                                    <span class="mt-0.5">{{ activity_status.icon(entity.status.value, 'h-4 w-4') }}</span>
                                    <span class="min-w-0 flex-1">
                                        <span class="block line-clamp-2 text-sm text-gray-800">
                                            {{ entity.activity.title }}{{ entity.ownerLabel ? ' · ' ~ entity.ownerLabel : '' }}
                                        </span>
                                        <span class="mt-0.5 block line-clamp-2 text-xs text-gray-400">{{ activity_status.detail(entity) }}</span>
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% set qualityItems = this.visibleQualityItems %}
                {% if qualityItems is not empty %}
                    <p class="bg-gray-50 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-wide text-gray-400">
                        {{ 'task.section_title'|trans({}, 'quality') }}
                    </p>
                    <ul class="divide-y divide-gray-100">
                        {% for task in qualityItems %}
                            <li>
                                <a href="{{ quality.task_url(task) }}" class="flex items-start gap-3 px-4 py-2.5 hover:bg-gray-50 transition-colors">
                                    <span class="mt-0.5 {{ {'overdue': 'text-red-500', 'soon': 'text-amber-500'}[task.urgency] ?? 'text-forest-600' }}">
                                        {{- ux_icon(quality.task_icon(task), {class: 'h-4 w-4'}) -}}
                                    </span>
                                    <span class="min-w-0 flex-1">
                                        <span class="block line-clamp-2 text-sm text-gray-800">{{ ('task.' ~ task.type)|trans({}, 'quality') }}: {{ task.label }}</span>
                                        <span class="mt-0.5 block line-clamp-2 text-xs {{ task.urgency == 'overdue' ? 'text-red-600' : 'text-gray-400' }}">
                                            {{ task.code ?? 'finding.no_code'|trans({}, 'quality') }}
                                            {%- if task.dueDate %} · {{ ('task.due.' ~ task.urgency)|trans({'%date%': task.dueDate|date('d/m/Y')}, 'quality') }}{% endif %}
                                        </span>
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if reviewItems is not empty %}
                    <p class="bg-gray-50 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-wide text-gray-400">
                        {{ 'bell.section.reviews'|trans({}, 'notifications') }}
                    </p>
                    <ul class="divide-y divide-gray-100">
                        {% for item in reviewItems %}
                            {% include 'components/_pending_review_group.html.twig' with {group: item.entity, compact: true} %}
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
            <a href="{{ path('app_activities', {tab: 'mine'}) }}"
               class="block border-t border-gray-100 px-4 py-2.5 text-center text-xs font-medium text-forest-700 hover:bg-gray-50">
                {{ 'bell.view_all'|trans({}, 'notifications') }}
            </a>
        {% endif %}
    </div>
</div>
