{% extends 'layouts/app.html.twig' %}

{% block title %}{{ document.name }} · {{ 'editor.title'|trans({}, 'forms') }} · {{ app_name }}{% endblock %}

{# The editor of a model: the Stimulus controller builds it from the definition and saves the draft as it changes. #}
{% block content %}
{% set labels = {
    section: 'editor.section'|trans({}, 'forms'),
    section_title: 'editor.section_title'|trans({}, 'forms'),
    add_section: 'editor.add_section'|trans({}, 'forms'),
    add_subsection: 'editor.add_subsection'|trans({}, 'forms'),
    add_text: 'editor.add_text'|trans({}, 'forms'),
    add_field: 'editor.add_field'|trans({}, 'forms'),
    add_table: 'editor.add_table'|trans({}, 'forms'),
    numbered: 'editor.numbered'|trans({}, 'forms'),
    up: 'editor.up'|trans({}, 'forms'),
    down: 'editor.down'|trans({}, 'forms'),
    indent: 'editor.indent'|trans({}, 'forms'),
    outdent: 'editor.outdent'|trans({}, 'forms'),
    remove: 'editor.remove'|trans({}, 'forms'),
    confirm_remove: 'editor.confirm_remove'|trans({}, 'forms'),
    text_mode: 'editor.text_mode'|trans({}, 'forms'),
    mode_fixed: 'editor.mode_fixed'|trans({}, 'forms'),
    mode_starter: 'editor.mode_starter'|trans({}, 'forms'),
    mode_fill: 'editor.mode_fill'|trans({}, 'forms'),
    label: 'editor.label'|trans({}, 'forms'),
    help: 'editor.help'|trans({}, 'forms'),
    required: 'editor.required'|trans({}, 'forms'),
    edit_text: 'editor.edit_text'|trans({}, 'forms'),
    empty_text: 'editor.empty_text'|trans({}, 'forms'),
    field_type: 'editor.field_type'|trans({}, 'forms'),
    type_short: 'editor.type_short'|trans({}, 'forms'),
    type_long: 'editor.type_long'|trans({}, 'forms'),
    type_number: 'editor.type_number'|trans({}, 'forms'),
    type_date: 'editor.type_date'|trans({}, 'forms'),
    type_time: 'editor.type_time'|trans({}, 'forms'),
    type_bool: 'editor.type_bool'|trans({}, 'forms'),
    type_choice: 'editor.type_choice'|trans({}, 'forms'),
    type_multichoice: 'editor.type_multichoice'|trans({}, 'forms'),
    unit: 'editor.unit'|trans({}, 'forms'),
    min: 'editor.min'|trans({}, 'forms'),
    max: 'editor.max'|trans({}, 'forms'),
    options: 'editor.options'|trans({}, 'forms'),
    add_option: 'editor.add_option'|trans({}, 'forms'),
    option: 'editor.option'|trans({}, 'forms'),
    table_mode: 'editor.table_mode'|trans({}, 'forms'),
    table_free: 'editor.table_free'|trans({}, 'forms'),
    table_fixed: 'editor.table_fixed'|trans({}, 'forms'),
    columns: 'editor.columns'|trans({}, 'forms'),
    add_column: 'editor.add_column'|trans({}, 'forms'),
    column: 'editor.column'|trans({}, 'forms'),
    rows: 'editor.rows'|trans({}, 'forms'),
    add_row: 'editor.add_row'|trans({}, 'forms'),
    row: 'editor.row'|trans({}, 'forms'),
    row_header: 'editor.row_header'|trans({}, 'forms'),
    min_rows: 'editor.min_rows'|trans({}, 'forms'),
    max_rows: 'editor.max_rows'|trans({}, 'forms'),
    saving: 'editor.saving'|trans({}, 'forms'),
    saved: 'editor.saved'|trans({}, 'forms'),
    offline: 'editor.offline'|trans({}, 'forms'),
    stale: 'editor.stale'|trans({}, 'forms'),
    outline: 'editor.outline'|trans({}, 'forms'),
    no_sections: 'editor.no_sections'|trans({}, 'forms'),
    block_actions: 'editor.block_actions'|trans({}, 'forms'),
    options_summary: 'editor.options_summary'|trans({}, 'forms'),
    repeat: 'editor.repeat'|trans({}, 'forms'),
    repeat_none: 'editor.repeat_none'|trans({}, 'forms'),
    repeat_manual: 'editor.repeat_manual'|trans({}, 'forms'),
    repeat_field: 'editor.repeat_field'|trans({}, 'forms'),
    repeat_table: 'editor.repeat_table'|trans({}, 'forms'),
    repeat_min: 'editor.repeat_min'|trans({}, 'forms'),
    repeat_max: 'editor.repeat_max'|trans({}, 'forms'),
    repeat_source_field: 'editor.repeat_source_field'|trans({}, 'forms'),
    repeat_source_table: 'editor.repeat_source_table'|trans({}, 'forms'),
    number_copies: 'editor.number_copies'|trans({}, 'forms'),
    condition: 'editor.condition'|trans({}, 'forms'),
    cond_always: 'editor.cond_always'|trans({}, 'forms'),
    cond_filled: 'editor.cond_filled'|trans({}, 'forms'),
    cond_empty: 'editor.cond_empty'|trans({}, 'forms'),
    cond_true: 'editor.cond_true'|trans({}, 'forms'),
    cond_false: 'editor.cond_false'|trans({}, 'forms'),
    cond_eq: 'editor.cond_eq'|trans({}, 'forms'),
