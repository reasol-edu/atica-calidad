{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'models.title'|trans({}, 'forms') }} · {{ app_name }}{% endblock %}

{# The centre's document models: the list and creating one. Editing and review are in the editor and in the folder's usual screens. #}
{% block content %}
<div class="px-4 sm:px-6 py-8 max-w-5xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'models.title'|trans({}, 'forms') }}</h1>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">{{ 'models.intro'|trans({}, 'forms') }}</p>
    </div>

    <section class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
        <h2 class="text-base font-semibold text-gray-900">{{ 'models.new'|trans({}, 'forms') }}</h2>
        <form method="post" action="{{ path('app_form_model_create') }}" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,2fr)_auto] sm:items-end">
            <input type="hidden" name="_token" value="{{ csrf_token('form_model_create') }}">
            <div class="min-w-0">
                <label for="model-name" class="block text-sm font-medium text-gray-700">{{ 'models.name'|trans({}, 'forms') }}</label>
                <input id="model-name" name="name" required maxlength="255" class="mt-1 w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500">
            </div>
            <div class="min-w-0">
                <label for="model-code" class="block text-sm font-medium text-gray-700">{{ 'models.code'|trans({}, 'forms') }}</label>
                <input id="model-code" name="code" maxlength="40" placeholder="MD850703" class="mt-1 w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500">
            </div>
            <div class="min-w-0">
                <label for="model-folder" class="block text-sm font-medium text-gray-700">{{ 'models.folder'|trans({}, 'forms') }}</label>
                <select id="model-folder" name="folder" required data-controller="tom-select"
                        data-tom-select-placeholder-value="{{ 'models.folder_placeholder'|trans({}, 'forms') }}"
                        data-tom-select-no-results-value="{{ 'tom_select.no_results'|trans({}, 'admin') }}"
                        class="mt-1 w-full text-sm ts-local">
                    <option value=""></option>
                    {% for f in folders %}<option value="{{ f.id }}">{{ f.label }}</option>{% endfor %}
                </select>
            </div>
            <button type="submit" class="w-full rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 sm:w-auto">{{ 'models.create'|trans({}, 'forms') }}</button>
        </form>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
        <h2 class="text-base font-semibold text-gray-900">{{ 'models.import_title'|trans({}, 'forms') }}</h2>
        <p class="mt-1 text-sm text-gray-500">{{ 'models.import_help'|trans({}, 'forms') }}</p>
        <form method="post" action="{{ path('app_form_model_import') }}" enctype="multipart/form-data" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,1.5fr)_auto] sm:items-end" data-testid="import-form">
            <input type="hidden" name="_token" value="{{ csrf_token('form_model_import') }}">
            <div class="min-w-0 sm:col-span-3">
                <label for="import-file" class="mb-1 block text-sm font-medium text-gray-700">{{ 'models.import_file'|trans({}, 'forms') }}</label>
                <twig:Form:PdfDropzone id="import-file" name="file" accept=".json,.docx,.odt" :required="true" :withSubmit="false"
                    :hint="'models.import_dropzone_hint'|trans({}, 'forms')" />
            </div>
            <div class="min-w-0">
                <label for="import-folder" class="block text-sm font-medium text-gray-700">{{ 'models.folder'|trans({}, 'forms') }}</label>
                <select id="import-folder" name="folder" required data-controller="tom-select"
                        data-tom-select-placeholder-value="{{ 'models.folder_placeholder'|trans({}, 'forms') }}"
                        data-tom-select-no-results-value="{{ 'tom_select.no_results'|trans({}, 'admin') }}"
                        class="mt-1 w-full text-sm ts-local">
                    <option value=""></option>
                    {% for f in folders %}<option value="{{ f.id }}">{{ f.label }}</option>{% endfor %}
                </select>
            </div>
            <div class="min-w-0">
                <label for="import-name" class="block text-sm font-medium text-gray-700">{{ 'models.import_name'|trans({}, 'forms') }}</label>
                <input id="import-name" name="name" maxlength="255" class="mt-1 w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500">
            </div>
            <button type="submit" class="w-full rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 sm:w-auto">{{ 'models.import'|trans({}, 'forms') }}</button>
        </form>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white shadow-xs">
        {% if models is empty %}
            <p class="px-5 py-8 text-center text-sm text-gray-500">{{ 'models.empty'|trans({}, 'forms') }}</p>
        {% else %}
            <ul class="divide-y divide-gray-100">
                {% for m in models %}
                    {% set doc = m.document %}
                    {% set active = doc.activeRevision %}
                    {% set pending = doc.pendingRevision %}
                    <li class="flex flex-wrap items-center gap-3 px-4 py-3 sm:px-5">
                        <div class="min-w-0 basis-full sm:flex-1 sm:basis-0">
                            <p class="break-words font-medium text-gray-900">{{ doc.name }}{% if m.code %} <span class="font-normal text-gray-500">· {{ m.code }}</span>{% endif %}</p>
                            <p class="break-words text-xs text-gray-500">{{ doc.folder.documentSection.name }} › {{ doc.folder.name }}</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 text-xs">
                            {% if active %}<span class="rounded-full bg-forest-50 px-2.5 py-1 font-medium text-forest-700">{{ 'models.in_force'|trans({'%version%': active.version}, 'forms') }}</span>
                            {% else %}<span class="rounded-full bg-gray-100 px-2.5 py-1 font-medium text-gray-600">{{ 'models.not_approved'|trans({}, 'forms') }}</span>{% endif %}
                            {% if pending %}<span class="rounded-full bg-amber-50 px-2.5 py-1 font-medium text-amber-800">{{ 'models.pending'|trans({'%version%': pending.version}, 'forms') }}</span>{% endif %}
                        </div>
                        <div class="grid grid-flow-col auto-cols-fr gap-2 basis-full sm:flex sm:basis-auto">
                            <a href="{{ path('app_form_model_edit', {id: m.id.toRfc4122}) }}" class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                                {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4'}) }}{{ 'models.edit'|trans({}, 'forms') }}
                            </a>
                            <details class="relative">
                                <summary class="inline-flex cursor-pointer list-none items-center justify-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                                    {{ ux_icon('heroicons:arrow-down-tray', {class: 'h-4 w-4'}) }}{{ 'models.export'|trans({}, 'forms') }}
                                </summary>
                                <div class="absolute right-0 z-10 mt-1 w-44 rounded-xl border border-gray-200 bg-white p-1 text-sm shadow-lg">
                                    {% for f in ['json', 'docx', 'odt'] %}
                                        <a href="{{ path('app_form_model_export', {id: m.id.toRfc4122, _format: f}) }}" class="block rounded-lg px-3 py-2 text-gray-700 hover:bg-gray-50 max-sm:py-2.5" data-testid="export-{{ f }}">{{ ('models.export_' ~ f)|trans({}, 'forms') }}</a>
                                    {% endfor %}
                                </div>
                            </details>
                            <form method="post" action="{{ path('app_form_model_duplicate', {id: m.id.toRfc4122}) }}" class="contents">
                                <input type="hidden" name="_token" value="{{ csrf_token('form_model_duplicate_' ~ m.id.toRfc4122) }}">
                                <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" data-testid="duplicate">
                                    {{ ux_icon('heroicons:document-duplicate', {class: 'h-4 w-4'}) }}{{ 'models.duplicate'|trans({}, 'forms') }}
                                </button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
