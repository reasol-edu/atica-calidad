{#
   What markDone() leaves behind (MarksActivitiesDoneTrait::$lastDone): the row may be gone or changed,
   so this is where a completion can be taken back. done: the lastDone array.
#}
<div role="status" class="flex items-center gap-3 rounded-xl border border-green-200 bg-green-50 px-4 py-2 text-sm text-green-800">
    {{ ux_icon('heroicons:check-circle', {class: 'h-5 w-5 shrink-0'}) }}
    <span class="min-w-0 flex-1">{{ 'agenda.done_message'|trans({'%title%': done.title}, 'dashboard') }}</span>
    <button type="button" data-action="live#action" data-live-action-param="undoDone"
            class="shrink-0 rounded-lg px-2 py-1 text-sm font-semibold underline underline-offset-2 hover:bg-green-100 max-sm:min-h-11">
        {{ 'agenda.undo'|trans({}, 'dashboard') }}
    </button>
    <button type="button" data-action="live#action" data-live-action-param="dismissDone"
            aria-label="{{ 'agenda.undo_dismiss'|trans({}, 'dashboard') }}"
            class="shrink-0 rounded-lg p-1 text-green-700 hover:bg-green-100 max-sm:flex max-sm:min-h-11 max-sm:min-w-11 max-sm:items-center max-sm:justify-center">
        {{ ux_icon('heroicons:x-mark', {class: 'h-4 w-4'}) }}
    </button>
</div>
