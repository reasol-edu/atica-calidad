{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'review_queue.title'|trans({}, 'dashboard') }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-5xl mx-auto space-y-6">
    <div>
        <div class="mb-1 flex flex-wrap items-center gap-2 text-sm text-gray-500">
            {% include 'components/_breadcrumb_home.html.twig' %}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'review_queue.title'|trans({}, 'dashboard') }}</h1>
        <p class="mt-1 text-sm text-gray-500">{{ 'review_queue.intro'|trans({}, 'dashboard') }}</p>
    </div>

    {# Filled documents whose approval chain is waiting for a step this person can decide. #}
    {% if steps is not empty %}
        <section class="rounded-2xl border border-amber-200 bg-amber-50/40 p-4 sm:p-5">
            <h2 class="text-base font-semibold text-gray-900">{{ 'review.pending_steps_title'|trans({}, 'forms') }}</h2>
            <ul class="mt-3 divide-y divide-amber-100">
                {% for step in steps %}
                    {% set revision = step.revision.revision %}
                    <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm">
                        <span class="min-w-0 break-words">
                            <span class="font-medium text-gray-900">{{ revision.document.name }}</span>
                            <span class="text-gray-500">· {{ 'fill.version'|trans({'%version%': revision.version}, 'forms') }} · {{ 'review.pending_step_for'|trans({'%step%': step.name}, 'forms') }}</span>
                        </span>
                        <a href="{{ path('app_form_revision_view', {revisionId: revision.id.toRfc4122}) }}" class="inline-flex rounded-xl bg-forest-600 px-3 py-1.5 font-semibold text-white hover:bg-forest-700">{{ 'review.open'|trans({}, 'forms') }}</a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <twig:ReviewQueueComponent :centre="centre" />
</div>
{% endblock %}
