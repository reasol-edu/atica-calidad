{% import 'components/_pagination_live.html.twig' as pager %}
<div {{ attributes.defaults(stimulus_controller('filter-persist', {
    centreId: centre.id.toRfc4122,
    active: this.hasActiveFilters,
    key: 'school-event-filters',
    defaults: {search: '', groupId: ''},
})) }}>
    {% if centre.activeAcademicYear is null %}
        <div class="px-6 py-16 text-center">
            {{ ux_icon('heroicons:exclamation-circle', {class: 'mx-auto h-10 w-10 text-amber-300 mb-3'}) }}
            <p class="text-sm text-gray-500">{{ 'school_event.no_active_year'|trans({}, 'admin') }}</p>
        </div>
    {% else %}
        {% set pagination = this.pagination %}

        {# Barra de filtros #}
        <div class="px-6 py-3 border-b border-gray-100 bg-gray-50/50 flex flex-wrap items-center gap-3">
            <div class="relative flex-1 min-w-48">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    {{ ux_icon('heroicons:magnifying-glass', {class: 'h-4 w-4 text-gray-400'}) }}
                </div>
                <input type="search"
                       data-model="norender|search"
                       data-action="input->live#action"
                       data-live-action-param="resetPage"
                       placeholder="{{ 'school_event.search'|trans({}, 'admin') }}"
                       value="{{ search }}"
                       class="block w-full rounded-lg border border-gray-200 bg-white py-2 pl-9 pr-3 text-sm
                              text-gray-900 placeholder-gray-400 focus:border-forest-500 focus:outline-none
                              focus:ring-3 focus:ring-forest-500/20 transition-colors">
            </div>

            {% set availableGroups = this.availableGroups %}
            {% if availableGroups is not empty %}
                <select data-model="norender|groupId"
                        data-action="change->live#action"
                        data-live-action-param="resetPage"
                        class="rounded-lg border border-gray-200 bg-white py-2 pl-3 pr-8 text-sm text-gray-700
                               focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20
                               transition-colors shrink-0">
                    <option value="">{{ 'school_event.filter.all_groups'|trans({}, 'admin') }}</option>
                    {% for group in availableGroups %}
                        <option value="{{ group.id.toRfc4122 }}" {{ groupId == group.id.toRfc4122 ? 'selected' : '' }}>
                            {{ group.name }}
                        </option>
                    {% endfor %}
                </select>
            {% endif %}

            <svg data-loading class="hidden h-4 w-4 text-forest-500 animate-spin shrink-0 ml-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
            </svg>
        </div>

        <div data-loading="addClass(opacity-50 pointer-events-none animate-pulse)" class="transition-opacity">
        {% if pagination.totalItems == 0 %}
            <div class="px-6 py-16 text-center">
                {{ ux_icon('heroicons:calendar-days', {class: 'mx-auto h-10 w-10 text-gray-300 mb-3'}) }}
                <p class="text-sm text-gray-500">
                    {{ (this.hasActiveFilters ? 'school_event.search_empty' : 'school_event.empty')|trans({}, 'admin') }}
                </p>
            </div>
        {% else %}
            <div class="overflow-x-auto">
            <table class="table-cards w-full text-sm">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50">
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'school_event.col.date'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'school_event.col.time'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'school_event.col.name'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'school_event.col.scope'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'school_event.col.actions'|trans({}, 'admin') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for event in pagination.items %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td data-label="{{ 'school_event.col.date'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4 text-gray-700 whitespace-nowrap">
                                {{ event.date|date('format.date'|trans) }}
                            </td>
                            <td data-label="{{ 'school_event.col.time'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4 text-gray-500 whitespace-nowrap tabular-nums">
                                {{ event.startTime|date('H:i') }}–{{ event.endTime|date('H:i') }}
                            </td>
                            <td data-label="{{ 'school_event.col.name'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4">
                                <a href="{{ path('app_events_edit', {eventId: event.id.toRfc4122}) }}"
                                   class="font-medium text-gray-900 hover:text-forest-700 transition-colors">{{ event.name }}</a>
                            </td>
                            <td data-label="{{ 'school_event.col.scope'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4">
                                {% if event.general %}
                                    <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                                        {{ 'school_event.scope.general'|trans({}, 'admin') }}
                                    </span>
                                {% else %}
                                    <div class="flex flex-wrap gap-1">
                                        {% for group in event.groups %}
                                            <span class="inline-flex items-center rounded-full bg-forest-50 px-2 py-0.5 text-xs font-medium text-forest-700">
                                                {{ group.name }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ path('app_events_edit', {eventId: event.id.toRfc4122}) }}"
                                       class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium
                                              text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-colors">
                                        {{ ux_icon('heroicons:pencil-square', {class: 'h-3.5 w-3.5'}) }}
                                        {{ 'school_event.action.edit'|trans({}, 'admin') }}
                                    </a>
                                    <form method="post"
                                          action="{{ path('app_events_delete', {eventId: event.id.toRfc4122}) }}"
                                          class="js-confirm-form"
                                          data-confirm="{{ 'school_event.delete_confirm'|trans({}, 'admin')|e('html_attr') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_school_event_' ~ event.id.toRfc4122) }}">
                                        <button type="submit"
                                                class="js-confirm-trigger inline-flex items-center gap-1.5 rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium
                                                       text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors">
                                            {{ ux_icon('heroicons:trash', {class: 'h-3.5 w-3.5'}) }}
                                            {{ 'school_event.action.delete'|trans({}, 'admin') }}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>

            {{ pager.nav(pagination) }}
        {% endif %}
        </div>
    {% endif %}
</div>
