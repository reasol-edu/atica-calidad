{% extends 'layouts/app.html.twig' %}

{% block title %}{{ title }} · {{ app_name }}{% endblock %}

{# A delivered filled document: its approval steps, the decision, the comments of the reviewers and what changed since the last revision. #}
{% block content %}
{% set states = {
    waiting: ['bg-gray-100 text-gray-600', 'review.step.waiting'],
    pending: ['bg-amber-50 text-amber-800', 'review.step.pending'],
    approved: ['bg-forest-50 text-forest-700', 'review.step.approved'],
    rejected: ['bg-red-50 text-red-700', 'review.step.rejected'],
    cancelled: ['bg-gray-100 text-gray-500', 'review.step.cancelled'],
} %}
<div class="px-4 sm:px-6 py-6 max-w-4xl mx-auto space-y-5">
    <div>
        <a href="{{ backUrl }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-forest-600">
            {{ ux_icon('heroicons:arrow-left', {class: 'h-4 w-4'}) }}{{ 'view.back'|trans({}, 'forms') }}
        </a>
        <h1 class="mt-1 break-words text-2xl font-bold text-gray-900">{{ title }}</h1>
        <p class="text-sm text-gray-500">{{ code }} · {{ 'fill.version'|trans({'%version%': revision.version}, 'forms') }}</p>
    </div>

    <div class="flex flex-wrap items-center gap-2 text-sm">
        {% if revision.pendingReview %}<span class="rounded-full bg-amber-50 px-3 py-1 font-medium text-amber-800">{{ 'fill.status_pending'|trans({}, 'forms') }}</span>
        {% elseif revision.rejected %}<span class="rounded-full bg-red-50 px-3 py-1 font-medium text-red-700">{{ 'fill.status_rejected'|trans({}, 'forms') }}</span>
        {% else %}<span class="rounded-full bg-forest-50 px-3 py-1 font-medium text-forest-700">{{ 'fill.status_approved'|trans({}, 'forms') }}</span>{% endif %}
        <span class="flex-1"></span>
        <a href="{{ path('app_folder_document_revision_download', {folderId: folder.id.toRfc4122, documentId: documentId, revisionId: revision.id.toRfc4122}) }}"
           class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 font-medium text-gray-700 hover:bg-gray-50">
            {{ ux_icon('heroicons:document-arrow-down', {class: 'h-4 w-4'}) }}PDF
        </a>
        {% for f in ['docx', 'odt'] %}
            <a href="{{ path('app_form_revision_export', {revisionId: revision.id.toRfc4122, _format: f}) }}" data-testid="export-{{ f }}"
               class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 font-medium text-gray-700 hover:bg-gray-50">
                {{ ux_icon('heroicons:document-arrow-down', {class: 'h-4 w-4'}) }}{{ f|upper }}
            </a>
        {% endfor %}
        {% if annexes|default(0) > 0 %}
            <a href="{{ path('app_form_revision_zip', {revisionId: revision.id.toRfc4122}) }}" data-testid="export-zip"
               class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 font-medium text-gray-700 hover:bg-gray-50">
                {{ ux_icon('heroicons:archive-box-arrow-down', {class: 'h-4 w-4'}) }}{{ 'view.attachments_zip'|trans({}, 'forms') }}
            </a>
        {% endif %}
    </div>

    {% if steps is not empty %}
        <section class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
            <h2 class="text-base font-semibold text-gray-900">{{ 'review.steps_title'|trans({}, 'forms') }}</h2>
            <ol class="mt-3 space-y-2">
                {% for step in steps %}
                    {% set st = states[step.state.value] %}
                    <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
                        <span class="w-6 text-gray-400">{{ step.position }}.</span>
                        <span class="font-medium text-gray-900">{{ step.name }}</span>
                        {% if step.profile %}<span class="text-xs text-gray-500">{{ step.profile.name }}</span>{% endif %}
                        <span class="rounded-full px-2.5 py-0.5 text-xs font-medium {{ st[0] }}">{{ st[1]|trans({}, 'forms') }}</span>
                        {% if step.decidedBy %}<span class="text-xs text-gray-500">{{ step.decidedBy.name.firstName }} {{ step.decidedBy.name.lastName }} · {{ step.decidedAt|date('d/m/Y H:i') }}</span>{% endif %}
                        {% if step.note %}<span class="basis-full pl-9 text-gray-700 whitespace-pre-line">{{ step.note }}</span>{% endif %}
                    </li>
                {% endfor %}
            </ol>
        </section>
    {% endif %}

    {% if canDecide %}
        <section class="rounded-2xl border border-amber-200 bg-amber-50/40 p-4 sm:p-5">
            <h2 class="text-base font-semibold text-gray-900">{{ (current ? 'review.decide_step'|trans({'%name%': current.name}, 'forms') : 'review.decide'|trans({}, 'forms')) }}</h2>
            <form method="post" action="{{ path('app_form_decide', {revisionId: revision.id.toRfc4122}) }}" class="mt-3 space-y-3">
                <input type="hidden" name="_token" value="{{ token }}">
                <label for="decision-note" class="block text-sm font-medium text-gray-700">{{ 'review.note'|trans({}, 'forms') }}</label>
                <textarea id="decision-note" name="note" rows="3" maxlength="2000" class="w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500"></textarea>
                <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                    <button type="submit" name="decision" value="reject" class="w-full rounded-xl border border-red-200 bg-white px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-50 sm:w-auto">{{ 'review.reject'|trans({}, 'forms') }}</button>
                    <button type="submit" name="decision" value="approve" class="w-full rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-forest-700 sm:w-auto">{{ 'review.approve'|trans({}, 'forms') }}</button>
                </div>
            </form>
        </section>
    {% endif %}

    {% if others is not empty %}
        <section class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
            <h2 class="text-base font-semibold text-gray-900">{{ 'review.compare_title'|trans({}, 'forms') }}</h2>
            <ul class="mt-2 flex flex-wrap gap-2 text-sm">
                {% for other in others %}
                    <li><a class="inline-flex rounded-xl border border-gray-200 bg-white px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-50" href="{{ path('app_form_compare', {revisionId: revision.id.toRfc4122, otherId: other.id.toRfc4122}) }}">{{ 'review.compare_with'|trans({'%version%': other.version}, 'forms') }}</a></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <article class="rounded-2xl border border-gray-200 bg-white px-5 py-6 shadow-xs sm:px-8">
        {% include 'form/_document.html.twig' with {sections: sections, blank: false, ctx: ctx|merge({revisionId: revision.id.toRfc4122})} only %}
    </article>
</div>
{% endblock %}
