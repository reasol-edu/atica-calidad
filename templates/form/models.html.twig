{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'models.title'|trans({}, 'forms') }} · {{ app_name }}{% endblock %}

{# The centre's document models: a list to search, filter, sort and group (done in the browser, it is one page of rows), with creating
   and importing in dialogs opened from the header. Editing and review are in the editor and in the folder's usual screens. #}
{% block content %}
{% set input_class = 'mt-1 w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500' %}
{% set sections = [] %}
{% for r in rows %}{% if r.section not in sections %}{% set sections = sections|merge([r.section]) %}{% endif %}{% endfor %}
{% set attention_count = rows|filter(r => r.attention)|length %}

<div class="px-4 sm:px-6 py-8 max-w-5xl mx-auto space-y-6"
     data-controller="model-list"
     data-model-list-showing-value="{{ 'models.showing'|trans({'%shown%': '%shown%', '%total%': '%total%'}, 'forms') }}"
     data-model-list-more-value="{{ 'models.show_more'|trans({}, 'forms') }}">

    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 basis-full sm:flex-1 sm:basis-0">
            <h1 class="text-2xl font-bold text-gray-900">{{ 'models.title'|trans({}, 'forms') }}</h1>
            <p class="mt-1 max-w-2xl text-sm text-gray-500">{{ 'models.intro'|trans({}, 'forms') }}</p>
        </div>
        <div class="grid w-full grid-cols-2 gap-2 sm:flex sm:w-auto">
            <button type="button" data-action="model-list#open" data-model-list-name-param="new"
                    class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700" data-testid="open-new">
                {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}{{ 'models.new'|trans({}, 'forms') }}
            </button>
            <button type="button" data-action="model-list#open" data-model-list-name-param="import"
                    class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50" data-testid="open-import">
                {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-4 w-4'}) }}{{ 'models.import_open'|trans({}, 'forms') }}
            </button>
        </div>
    </div>

    {# ── Dialogs: new model and import ─────────────────────────────────────── #}
    <div class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4 py-6" data-model-list-target="dialog" data-name="new" data-action="mousedown->model-list#backdrop keydown->model-list#keydown">
        <div role="dialog" aria-modal="true" aria-labelledby="dlg-new-title" class="max-h-full w-full max-w-lg overflow-y-auto rounded-2xl border border-gray-200 bg-white p-5 shadow-xl">
            <div class="flex items-start justify-between gap-3">
                <h2 id="dlg-new-title" class="text-base font-semibold text-gray-900">{{ 'models.new'|trans({}, 'forms') }}</h2>
                <button type="button" data-action="model-list#close" aria-label="{{ 'models.close'|trans({}, 'forms') }}" class="rounded-lg p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600">{{ ux_icon('heroicons:x-mark', {class: 'h-5 w-5'}) }}</button>
            </div>
            <form method="post" action="{{ path('app_form_model_create') }}" class="mt-3 space-y-3">
                <input type="hidden" name="_token" value="{{ csrf_token('form_model_create') }}">
                <div>
                    <label for="model-name" class="block text-sm font-medium text-gray-700">{{ 'models.name'|trans({}, 'forms') }}</label>
                    <input id="model-name" name="name" required maxlength="255" class="{{ input_class }}">
                </div>
                <div>
                    <label for="model-code" class="block text-sm font-medium text-gray-700">{{ 'models.code'|trans({}, 'forms') }}</label>
                    <input id="model-code" name="code" maxlength="40" placeholder="MD850703" class="{{ input_class }}">
                </div>
                <div>
                    <label for="model-folder" class="block text-sm font-medium text-gray-700">{{ 'models.folder'|trans({}, 'forms') }}</label>
                    <select id="model-folder" name="folder" required data-controller="tom-select"
                            data-tom-select-placeholder-value="{{ 'models.folder_placeholder'|trans({}, 'forms') }}"
                            data-tom-select-no-results-value="{{ 'tom_select.no_results'|trans({}, 'admin') }}"
                            class="mt-1 w-full text-sm ts-local">
                        <option value=""></option>
                        {% for f in folders %}<option value="{{ f.id }}">{{ f.label }}</option>{% endfor %}
                    </select>
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="w-full rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 sm:w-auto">{{ 'models.create'|trans({}, 'forms') }}</button>
                </div>
            </form>
        </div>
    </div>

    <div class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4 py-6" data-model-list-target="dialog" data-name="import" data-action="mousedown->model-list#backdrop keydown->model-list#keydown">
        <div role="dialog" aria-modal="true" aria-labelledby="dlg-import-title" class="max-h-full w-full max-w-lg overflow-y-auto rounded-2xl border border-gray-200 bg-white p-5 shadow-xl">
            <div class="flex items-start justify-between gap-3">
                <h2 id="dlg-import-title" class="text-base font-semibold text-gray-900">{{ 'models.import_title'|trans({}, 'forms') }}</h2>
                <button type="button" data-action="model-list#close" aria-label="{{ 'models.close'|trans({}, 'forms') }}" class="rounded-lg p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600">{{ ux_icon('heroicons:x-mark', {class: 'h-5 w-5'}) }}</button>
            </div>
            <p class="mt-1 text-sm text-gray-500">{{ 'models.import_help'|trans({}, 'forms') }}</p>
            <form method="post" action="{{ path('app_form_model_import') }}" enctype="multipart/form-data" class="mt-3 space-y-3" data-testid="import-form">
                <input type="hidden" name="_token" value="{{ csrf_token('form_model_import') }}">
                <div>
                    <label for="import-file" class="mb-1 block text-sm font-medium text-gray-700">{{ 'models.import_file'|trans({}, 'forms') }}</label>
                    <twig:Form:PdfDropzone id="import-file" name="file" accept=".json,.docx,.odt" :required="true" :withSubmit="false"
                        :hint="'models.import_dropzone_hint'|trans({}, 'forms')" />
                </div>
                <div>
                    <label for="import-folder" class="block text-sm font-medium text-gray-700">{{ 'models.folder'|trans({}, 'forms') }}</label>
                    <select id="import-folder" name="folder" required data-controller="tom-select"
                            data-tom-select-placeholder-value="{{ 'models.folder_placeholder'|trans({}, 'forms') }}"
                            data-tom-select-no-results-value="{{ 'tom_select.no_results'|trans({}, 'admin') }}"
                            class="mt-1 w-full text-sm ts-local">
                        <option value=""></option>
                        {% for f in folders %}<option value="{{ f.id }}">{{ f.label }}</option>{% endfor %}
                    </select>
                </div>
                <div>
                    <label for="import-name" class="block text-sm font-medium text-gray-700">{{ 'models.import_name'|trans({}, 'forms') }}</label>
                    <input id="import-name" name="name" maxlength="255" class="{{ input_class }}">
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="w-full rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 sm:w-auto">{{ 'models.import'|trans({}, 'forms') }}</button>
                </div>
            </form>
        </div>
    </div>

    {% if rows is empty %}
        <section class="rounded-2xl border border-gray-200 bg-white shadow-xs">
            <p class="px-5 py-8 text-center text-sm text-gray-500">{{ 'models.empty'|trans({}, 'forms') }}</p>
        </section>
    {% else %}
        {# ── Search, filters, sort and grouping ────────────────────────────── #}
        <section class="space-y-3 rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
            <div class="grid grid-cols-2 gap-3 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1.4fr)_minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)]">
                <div class="col-span-2 min-w-0 lg:col-span-1">
                    <label for="list-search" class="block text-xs font-medium text-gray-600">{{ 'models.search'|trans({}, 'forms') }}</label>
                    <input id="list-search" type="search" autocomplete="off" placeholder="{{ 'models.search_placeholder'|trans({}, 'forms') }}"
                           data-model-list-target="search" data-action="input->model-list#render" class="{{ input_class }}">
                </div>
                <div class="col-span-2 min-w-0 sm:col-span-1">
                    <label for="list-status" class="block text-xs font-medium text-gray-600">{{ 'models.filter_status'|trans({}, 'forms') }}</label>
                    <select id="list-status" data-model-list-target="status" data-action="change->model-list#render" class="{{ input_class }}">
                        <option value="">{{ 'models.status_all'|trans({}, 'forms') }}</option>
                        <option value="inforce">{{ 'models.status_inforce'|trans({}, 'forms') }}</option>
                        <option value="unapproved">{{ 'models.status_unapproved'|trans({}, 'forms') }}</option>
                        <option value="pending">{{ 'models.status_pending'|trans({}, 'forms') }}</option>
                        <option value="draft">{{ 'models.status_draft'|trans({}, 'forms') }}</option>
                        <option value="attention">{{ 'models.attention'|trans({'%count%': attention_count}, 'forms') }}</option>
                    </select>
                </div>
                <div class="col-span-2 min-w-0 sm:col-span-1">
                    <label for="list-section" class="block text-xs font-medium text-gray-600">{{ 'models.filter_section'|trans({}, 'forms') }}</label>
                    <select id="list-section" data-model-list-target="section" data-action="change->model-list#render" class="{{ input_class }}">
                        <option value="">{{ 'models.section_all'|trans({}, 'forms') }}</option>
                        {% for s in sections|sort %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
                    </select>
                </div>
                <div class="min-w-0">
                    <label for="list-sort" class="block text-xs font-medium text-gray-600">{{ 'models.sort'|trans({}, 'forms') }}</label>
                    <select id="list-sort" data-model-list-target="sort" data-action="change->model-list#render" class="{{ input_class }}">
                        <option value="name">{{ 'models.sort_name'|trans({}, 'forms') }}</option>
                        <option value="code">{{ 'models.sort_code'|trans({}, 'forms') }}</option>
                        <option value="updated">{{ 'models.sort_updated'|trans({}, 'forms') }}</option>
                        <option value="status">{{ 'models.sort_status'|trans({}, 'forms') }}</option>
                    </select>
                </div>
                <div class="min-w-0">
                    <label for="list-group" class="block text-xs font-medium text-gray-600">{{ 'models.group'|trans({}, 'forms') }}</label>
                    <select id="list-group" data-model-list-target="group" data-action="change->model-list#render" class="{{ input_class }}">
                        <option value="section">{{ 'models.group_section'|trans({}, 'forms') }}</option>
                        <option value="status">{{ 'models.group_status'|trans({}, 'forms') }}</option>
                        <option value="">{{ 'models.group_none'|trans({}, 'forms') }}</option>
                    </select>
                </div>
            </div>

            {% if attention_count > 0 %}
                <button type="button" data-action="model-list#showAttention" data-model-list-target="attentionChip" title="{{ 'models.attention_help'|trans({}, 'forms') }}"
                        class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-800 hover:bg-amber-100">
                    {{ ux_icon('heroicons:exclamation-circle', {class: 'h-4 w-4'}) }}{{ 'models.attention'|trans({'%count%': attention_count}, 'forms') }}
                </button>
            {% endif %}
        </section>

        <section class="rounded-2xl border border-gray-200 bg-white shadow-xs">
            <ul class="divide-y divide-gray-100" data-model-list-target="list">
                {% for r in rows %}
                    {% set m = r.model %}
                    {% set doc = m.document %}
                    {% set states = [] %}
                    {% if r.active %}{% set states = states|merge(['inforce']) %}{% else %}{% set states = states|merge(['unapproved']) %}{% endif %}
                    {% if r.pending %}{% set states = states|merge(['pending']) %}{% endif %}
                    {% if r.draftAhead %}{% set states = states|merge(['draft']) %}{% endif %}
                    {% if r.attention %}{% set states = states|merge(['attention']) %}{% endif %}
                    {# What the status grouping and sorting use: the most pressing state first. #}
                    {% set primary = r.pending ? 'pending' : (r.draftAhead ? 'draft' : (r.active ? 'inforce' : 'unapproved')) %}
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 py-3 sm:px-5" data-model-list-target="row"
                        data-name="{{ doc.name }}" data-code="{{ m.code }}" data-section="{{ r.section }}"
                        data-states="{{ states|join(' ') }}" data-primary="{{ primary }}"
                        data-primary-label="{{ ('models.status_' ~ primary)|trans({}, 'forms') }}"
                        data-updated="{{ r.updated|date('U') }}"
                        data-search="{{ doc.name }} {{ m.code }} {{ r.section }} {{ doc.folder.name }}">
                        <div class="min-w-0 basis-full sm:flex-1 sm:basis-0">
                            <p class="break-words font-medium text-gray-900">{{ doc.name }}{% if m.code %} <span class="font-normal text-gray-500">· {{ m.code }}</span>{% endif %}</p>
                            <p class="break-words text-xs text-gray-500">{{ r.section }} › {{ doc.folder.name }} · {{ 'models.updated'|trans({'%date%': r.updated|date('d/m/Y')}, 'forms') }}</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 text-xs">
                            {% if r.active %}<span class="rounded-full bg-forest-50 px-2.5 py-1 font-medium text-forest-700">{{ 'models.in_force'|trans({'%version%': r.active.version}, 'forms') }}</span>
                            {% else %}<span class="rounded-full bg-gray-100 px-2.5 py-1 font-medium text-gray-600">{{ 'models.not_approved'|trans({}, 'forms') }}</span>{% endif %}
                            {% if r.pending %}<span class="rounded-full bg-amber-50 px-2.5 py-1 font-medium text-amber-800">{{ 'models.pending'|trans({'%version%': r.pending.version}, 'forms') }}</span>
                            {% elseif r.draftAhead and r.active %}<span class="rounded-full bg-amber-50 px-2.5 py-1 font-medium text-amber-800">{{ 'models.draft_changes'|trans({}, 'forms') }}</span>{% endif %}
                        </div>
                        <div class="flex basis-full items-center gap-2 sm:basis-auto">
                            <a href="{{ path('app_form_model_edit', {id: m.id.toRfc4122}) }}" class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 sm:flex-none">
                                {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4'}) }}{{ 'models.edit'|trans({}, 'forms') }}
                            </a>
                            <details class="relative" data-model-list-target="menu">
                                <summary class="inline-flex cursor-pointer list-none items-center justify-center rounded-xl border border-gray-200 bg-white px-2.5 py-2 text-gray-600 hover:bg-gray-50" aria-label="{{ 'models.more_actions'|trans({}, 'forms') }}">
                                    {{ ux_icon('heroicons:ellipsis-horizontal', {class: 'h-5 w-5'}) }}
                                </summary>
                                <div class="absolute right-0 z-20 mt-1 w-52 rounded-xl border border-gray-200 bg-white p-1 text-sm shadow-lg">
                                    <p class="px-3 pb-1 pt-2 text-xs font-medium uppercase tracking-wide text-gray-400">{{ 'models.export'|trans({}, 'forms') }}</p>
                                    {% for f in ['json', 'docx', 'odt'] %}
                                        <a href="{{ path('app_form_model_export', {id: m.id.toRfc4122, _format: f}) }}" class="block rounded-lg px-3 py-2 text-gray-700 hover:bg-gray-50" data-testid="export-{{ f }}">{{ ('models.export_' ~ f)|trans({}, 'forms') }}</a>
                                    {% endfor %}
                                    <div class="my-1 border-t border-gray-100"></div>
                                    <form method="post" action="{{ path('app_form_model_duplicate', {id: m.id.toRfc4122}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('form_model_duplicate_' ~ m.id.toRfc4122) }}">
                                        <button type="submit" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-left text-gray-700 hover:bg-gray-50" data-testid="duplicate">
                                            {{ ux_icon('heroicons:document-duplicate', {class: 'h-4 w-4'}) }}{{ 'models.duplicate'|trans({}, 'forms') }}
                                        </button>
                                    </form>
                                </div>
                            </details>
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <p class="hidden px-5 py-8 text-center text-sm text-gray-500" data-model-list-target="empty">
                {{ 'models.no_matches'|trans({}, 'forms') }}
                <button type="button" data-action="model-list#reset" class="ml-1 font-medium text-forest-600 hover:text-forest-700">{{ 'models.clear_filters'|trans({}, 'forms') }}</button>
            </p>

            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-gray-100 px-4 py-3 text-xs text-gray-500 sm:px-5">
                <span data-model-list-target="count" aria-live="polite"></span>
                <button type="button" data-action="model-list#more" data-model-list-target="moreButton"
                        class="hidden rounded-lg border border-gray-200 px-3 py-1.5 font-medium text-gray-700 hover:bg-gray-50">{{ 'models.show_more'|trans({}, 'forms') }}</button>
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
