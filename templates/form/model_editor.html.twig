    ref_ctx_year: 'editor.ref_ctx_year'|trans({}, 'forms'),
    ref_ctx_activity: 'editor.ref_ctx_activity'|trans({}, 'forms'),
    ref_ctx_slot: 'editor.ref_ctx_slot'|trans({}, 'forms'),
    ref_ctx_date: 'editor.ref_ctx_date'|trans({}, 'forms'),
