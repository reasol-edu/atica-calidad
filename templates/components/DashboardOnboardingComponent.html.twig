{% set steps = this.steps %}
{% if steps is not empty %}
{% set done_count = steps|filter(s => s.done)|length %}
{% set links = {
    year:       path('app_centre_years_index', {centreId: centre.id}),
    teachers:   path('app_centre_teachers_index', {centreId: centre.id}),
    profiles:   path('app_responsibilities_index', {centreId: centre.id}),
    documents:  path('app_document_tree'),
    activities: path('app_activities'),
} %}
<section {{ attributes }} aria-labelledby="onboarding-title" class="rounded-2xl border border-forest-200 bg-forest-50/50 shadow-xs">
    <div class="px-6 py-5 border-b border-forest-100">
        <h2 id="onboarding-title" class="flex flex-wrap items-center gap-2 text-lg font-semibold text-gray-900">
            {{ ux_icon('heroicons:flag', {class: 'h-5 w-5 text-forest-600'}) }}
            {{ 'onboarding.title'|trans({}, 'dashboard') }}
            <span class="rounded-full bg-white px-2 py-0.5 text-xs font-semibold text-forest-700 border border-forest-200">
                {{ 'onboarding.progress'|trans({'%done%': done_count, '%total%': steps|length}, 'dashboard') }}
            </span>
        </h2>
        <p class="mt-1 text-sm text-gray-600">{{ 'onboarding.intro'|trans({}, 'dashboard') }}</p>
    </div>
    <ol class="divide-y divide-forest-100">
        {% for step in steps %}
            <li>
                <a href="{{ links[step.key] }}" class="flex items-start gap-3 px-6 py-3 transition-colors hover:bg-white/70">
                    <span class="mt-0.5 shrink-0 {{ step.done ? 'text-forest-600' : 'text-gray-400' }}">
                        {{ ux_icon(step.done ? 'heroicons:check-circle' : 'heroicons:arrow-right-circle', {class: 'h-5 w-5'}) }}
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block text-sm font-medium {{ step.done ? 'text-gray-500 line-through' : 'text-gray-900' }}">
                            {{ ('onboarding.' ~ step.key ~ '.title')|trans({}, 'dashboard') }}
                            {% if step.done %}<span class="sr-only"> · {{ 'onboarding.done'|trans({}, 'dashboard') }}</span>{% endif %}
                        </span>
                        {% if not step.done %}
                            <span class="mt-0.5 block text-sm text-gray-600">{{ ('onboarding.' ~ step.key ~ '.hint')|trans({}, 'dashboard') }}</span>
                        {% endif %}
                    </span>
                </a>
            </li>
        {% endfor %}
    </ol>
</section>
{% endif %}
