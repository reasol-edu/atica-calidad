{# node: {item: ListItem, children: [...]}, depth: int — inherits the parent component's context (this, selectedId, addingParentId, addName, errors...) #}
{% set item = node.item %}
{% set lid = item.id.toRfc4122 %}
{% set is_sel = selectedId == lid %}
<li class="js-list-item-node" data-list-item-id="{{ lid }}">
    <div class="group flex items-center gap-1.5 rounded-lg px-2 py-1.5 transition-colors {{ is_sel ? 'bg-forest-50 ring-1 ring-inset ring-forest-200' : 'hover:bg-gray-50' }}"
         style="padding-left: {{ depth * 1.25 }}rem">
        {# With «Sin docente» on, part of each list is hidden: dragging would renumber only the visible siblings, so there is nothing to drag. #}
        {% if this.filtered %}
            <span class="shrink-0 text-gray-200" title="{{ 'responsibilities.lists.drag_filtered'|trans({}, 'admin') }}">
                {{ ux_icon('heroicons:bars-2', {class: 'h-4 w-4'}) }}
            </span>
        {% else %}
            <span class="js-drag-handle shrink-0 cursor-grab text-gray-300 hover:text-gray-500"
                  title="{{ 'responsibilities.lists.drag'|trans({}, 'admin') }}">
                {{ ux_icon('heroicons:bars-2', {class: 'h-4 w-4'}) }}
            </span>
        {% endif %}

        {% if bulkSelectMode %}
            <label class="flex flex-1 min-w-0 items-center gap-2 cursor-pointer">
                <input type="checkbox" value="{{ lid }}" data-model="bulkSelectedIds" {{ lid in bulkSelectedIds ? 'checked' : '' }}
                       class="h-4 w-4 shrink-0 rounded border-gray-300 text-violet-600 focus:ring-violet-500">
                <span class="min-w-0 truncate text-sm text-gray-800">{{ item.name }}</span>
            </label>
        {% else %}
            <button type="button" data-action="live#action" data-live-action-param="selectItem" data-live-id-param="{{ lid }}"
                    class="flex-1 min-w-0 truncate text-left text-sm {{ is_sel ? 'font-semibold text-forest-800' : 'text-gray-800 hover:text-forest-700' }}">
                {{ item.name }}
            </button>
        {% endif %}

        {% if not item.active %}
            <span title="{{ 'responsibilities.lists.inactive'|trans({}, 'admin') }}" class="shrink-0 text-gray-300">
                {{ ux_icon('heroicons:eye-slash', {class: 'h-3.5 w-3.5'}) }}
            </span>
        {% endif %}
        {% set inherited = item.associated ? [] : item.inheritedAssociations %}
        {% if item.associated %}
            {# Its own associations, short; the full path in the title. Two at most, then how many more. #}
            {% set chips = this.associationChips(item) %}
            {% for chip in chips|slice(0, 2) %}
                <span title="{{ chip.label }}" data-testid="association-chip"
                      class="shrink-0 inline-flex max-w-[9rem] items-center gap-1 rounded-full bg-violet-50 px-1.5 py-0.5 text-xs text-violet-700">
                    {{ ux_icon('heroicons:link', {class: 'h-3 w-3 shrink-0'}) }}<span class="truncate">{{ chip.short }}</span>
                </span>
            {% endfor %}
            {% if chips|length > 2 %}
                <span title="{{ chips|slice(2)|map(c => c.label)|join(', ') }}" class="shrink-0 rounded-full bg-violet-50 px-1.5 py-0.5 text-xs text-violet-700">+{{ chips|length - 2 }}</span>
            {% endif %}
        {% elseif inherited is not empty %}
            {% set inherited_names = [] %}
            {% for pair in inherited %}
                {% if pair.item.name not in inherited_names %}{% set inherited_names = inherited_names|merge([pair.item.name]) %}{% endif %}
            {% endfor %}
            <span title="{{ 'responsibilities.lists.association.inherited_icon'|trans({'%name%': inherited_names|join('», «')}, 'admin') }}" class="shrink-0 text-violet-200">
                {{ ux_icon('heroicons:link', {class: 'h-3.5 w-3.5'}) }}
            </span>
        {% endif %}

        {# Associated teachers: their name (or how many), paler when they are all inherited and red when none is in the course (like in
           Asignar perfiles); the title lists everyone. #}
        {% set badge = this.teacherBadge(item) %}
        {% if badge.count > 0 %}
            {% set only_inherited = badge.own is empty %}
            <span title="{{ 'responsibilities.lists.teachers.badge_title'|trans({'%names%': badge.names}, 'admin') }}" data-testid="teacher-badge"
                  class="shrink-0 inline-flex max-w-[11rem] items-center gap-1 rounded-full px-1.5 py-0.5 text-xs {{ badge.allOutOfCourse ? 'bg-red-50 text-red-700' : (only_inherited ? 'bg-gray-50 text-gray-400' : 'bg-gray-100 text-gray-600') }}">
                {{ ux_icon('heroicons:user', {class: 'h-3 w-3 shrink-0'}) }}
                <span class="truncate">{{ badge.count == 1 ? (only_inherited ? badge.inherited[0] : badge.own[0]).name.full : badge.count }}</span>
            </span>
        {% endif %}

        <button type="button" data-action="live#action" data-live-action-param="toggleAdd" data-live-parent-id-param="{{ lid }}"
                aria-label="{{ 'responsibilities.lists.add_child'|trans({}, 'admin') }}" title="{{ 'responsibilities.lists.add_child'|trans({}, 'admin') }}"
                class="shrink-0 inline-flex items-center justify-center rounded-full p-1 text-gray-400 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 [@media(hover:none)]:opacity-100 hover:text-forest-600 hover:bg-forest-50 transition-opacity">
            {{ ux_icon('heroicons:plus', {class: 'h-3.5 w-3.5'}) }}
        </button>
    </div>

    {% if addingParentId == lid %}
        <form data-action="submit->live#action:prevent" data-live-action-param="addItem" data-live-parent-id-param="{{ lid }}"
              class="ml-8 mb-2 flex items-center gap-2">
            <input type="text" data-model="norender|addName" value="{{ addName }}" autofocus
                   placeholder="{{ 'responsibilities.lists.field.name_placeholder'|trans({}, 'admin') }}" aria-label="{{ 'responsibilities.lists.field.name'|trans({}, 'admin') }}"
                   class="min-w-0 flex-1 rounded-md border border-gray-200 bg-white px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-forest-500/20">
            <button type="submit" class="shrink-0 rounded-md bg-forest-600 px-2 py-1 text-white hover:bg-forest-700">
                {{ ux_icon('heroicons:plus', {class: 'h-3.5 w-3.5'}) }}
            </button>
        </form>
        {% if errors.add is defined %}<p class="ml-8 mb-2 text-xs text-red-600">{{ errors.add }}</p>{% endif %}
    {% endif %}

    <ul class="js-list-item-list" data-parent-id="{{ lid }}" style="min-height: 0.5rem;">
        {% for child in node.children %}
            {% include 'components/Admin/_list_item_node.html.twig' with {node: child, depth: depth + 1} %}
        {% endfor %}
    </ul>
</li>
