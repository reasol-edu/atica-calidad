{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'school_event.edit'|trans({}, 'admin') }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-3xl mx-auto space-y-6">

    <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
                {% include 'components/_breadcrumb_home.html.twig' %}
                <a href="{{ path('app_calendar', {tab: 'events'}) }}" class="hover:text-forest-600 transition-colors">{{ 'school_event.title'|trans({}, 'admin') }}</a>
                {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
                <span aria-current="page" class="text-gray-700 font-medium">{{ 'school_event.edit'|trans({}, 'admin') }}</span>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">{{ 'school_event.edit'|trans({}, 'admin') }}</h1>
        </div>

        <form method="post" action="{{ path('app_events_delete', {eventId: event.id.toRfc4122}) }}"
              class="js-confirm-form"
              data-confirm="{{ 'school_event.delete_confirm'|trans({}, 'admin')|e('html_attr') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_school_event_' ~ event.id.toRfc4122) }}">
            <button type="submit"
                    class="js-confirm-trigger inline-flex items-center gap-2 rounded-xl border border-red-200 bg-white px-4 py-2.5 text-sm font-medium
                           text-red-600 hover:bg-red-50 transition-colors">
                {{ ux_icon('heroicons:trash', {class: 'h-4 w-4'}) }}
                {{ 'school_event.delete'|trans({}, 'admin') }}
            </button>
        </form>
    </div>

    <form method="post" class="space-y-6" data-controller="event-scope">
        <input type="hidden" name="_token" value="{{ csrf_token('edit_school_event_' ~ event.id.toRfc4122) }}">

        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-5">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                <twig:Form:Field
                    id="date" name="date" type="date"
                    label="{{ 'school_event.field.date'|trans({}, 'admin') }}"
                    value="{{ values.date }}"
                    :error="errors.date ?? null"
                    required="true" />

                <twig:Form:Field
                    id="start_time" name="start_time" type="time"
                    label="{{ 'school_event.field.start_time'|trans({}, 'admin') }}"
                    value="{{ values.start_time }}"
                    :error="errors.time ?? null"
                    required="true" />

                <twig:Form:Field
                    id="end_time" name="end_time" type="time"
                    label="{{ 'school_event.field.end_time'|trans({}, 'admin') }}"
                    value="{{ values.end_time }}"
                    required="true" />
            </div>

            <twig:Form:Field
                id="name" name="name" type="text"
                label="{{ 'school_event.field.name'|trans({}, 'admin') }}"
                value="{{ values.name }}"
                :error="errors.name ?? null"
                required="true" />

            <twig:Form:Textarea
                id="description" name="description"
                label="{{ 'school_event.field.description'|trans({}, 'admin') }}"
                value="{{ values.description }}"
                rows="3" />

            <twig:Form:Field
                id="url" name="url" type="url"
                label="{{ 'school_event.field.url'|trans({}, 'admin') }}"
                value="{{ values.url }}"
                placeholder="https://…"
                :error="errors.url ?? null" />
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-4">
            <h2 class="text-base font-semibold text-gray-900">{{ 'school_event.field.scope'|trans({}, 'admin') }}</h2>

            {% if errors.scope is defined %}
                <p class="text-xs text-red-600">{{ errors.scope }}</p>
            {% endif %}

            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                <twig:Form:RadioCard
                    name="scope"
                    value="general"
                    label="{{ 'school_event.scope.general'|trans({}, 'admin') }}"
                    help="{{ 'school_event.scope.general_help'|trans({}, 'admin') }}"
                    :checked="values.scope == 'general'"
                    data-event-scope-target="radio"
                    data-action="change->event-scope#toggle" />

                <twig:Form:RadioCard
                    name="scope"
                    value="restricted"
                    label="{{ 'school_event.scope.restricted'|trans({}, 'admin') }}"
                    help="{{ 'school_event.scope.restricted_help'|trans({}, 'admin') }}"
                    :checked="values.scope == 'restricted'"
                    data-event-scope-target="radio"
                    data-action="change->event-scope#toggle" />
            </div>

            <div data-event-scope-target="groupsBlock" class="hidden">
                <label for="groups" class="block text-sm font-medium text-gray-700 mb-1.5">
                    {{ 'school_event.field.groups'|trans({}, 'admin') }}
                </label>
                <select id="groups" name="groups[]" multiple
                        class="w-full text-sm ts-local"
                        data-placeholder="{{ 'school_event.field.groups_placeholder'|trans({}, 'admin')|e('html_attr') }}"
                        data-no-results="{{ 'school_event.field.groups_no_results'|trans({}, 'admin')|e('html_attr') }}">
                    {% for group in availableGroups %}
                        <option value="{{ group.id.toRfc4122 }}"
                                {{ group.id.toRfc4122 in selectedGroupIds ? 'selected' : '' }}>
                            {{ group.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3">
            <a href="{{ path('app_calendar', {tab: 'events'}) }}"
               class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700
                      hover:bg-gray-50 transition-colors">
                {{ 'school_event.cancel'|trans({}, 'admin') }}
            </a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                           hover:bg-forest-700 transition-colors shadow-xs">
                {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                {{ 'school_event.save'|trans({}, 'admin') }}
            </button>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
{% if availableGroups is not empty %}
<script type="module">
import TomSelect from 'tom-select';

const el = document.getElementById('groups');
if (el) {

const placeholder = el.dataset.placeholder ?? '';
const noResults   = el.dataset.noResults   ?? '';

const options = [];
el.querySelectorAll('option').forEach(opt => {
    options.push({
        value: opt.value,
        name:  opt.textContent.trim(),
    });
});

const selected = Array.from(el.selectedOptions).map(o => o.value);

new TomSelect(el, {
    options,
    items:          selected,
    valueField:     'value',
    labelField:     'name',
    searchField:    ['name'],
    create:         false,
    maxOptions:     null,
    placeholder,
    plugins:        ['remove_button', 'checkbox_options'],
    render: {
        option: (d, esc) => `<div><span>${esc(d.name)}</span></div>`,
        item: (d, esc) => `<span>${esc(d.name)}</span>`,
        no_results: () => `<div class="no-results px-3 py-2 text-sm">${noResults}</div>`,
    },
});

}
</script>
{% endif %}
{% endblock %}
