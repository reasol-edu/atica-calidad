{# item: ActivityDashboardItem #}
{% import 'components/_activity_status.html.twig' as activity_status %}
{% set overdue = item.status.value == 'overdue' %}
{% set completed = item.status.value == 'completed' %}
{% set not_started = not completed and not overdue and item.notStarted %}
{% set status_key = activity_status.key(item.status.value, item.notStarted) %}
<li>
    <a href="{{ path('app_activities', {tab: 'view', category: item.activity.category.id.toRfc4122, activity: item.activity.id.toRfc4122}) }}"
       class="flex items-start gap-3 px-4 py-3 transition-colors {{ activity_status.row_bg(status_key) }} {{ completed ? 'opacity-70' : '' }}">
        <span class="mt-0.5 shrink-0 {{ completed ? 'text-forest-500' : (overdue ? 'text-red-500' : 'text-amber-500') }}">
            {{ ux_icon(completed ? 'heroicons:check-circle' : (overdue ? 'heroicons:exclamation-circle' : (not_started ? 'heroicons:calendar-days' : 'heroicons:clock')), {class: 'h-5 w-5'}) }}
        </span>
        <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium text-gray-900 {{ completed ? 'line-through decoration-gray-300' : '' }}">
                {{ item.activity.title }}{{ item.ownerLabel ? ' · ' ~ item.ownerLabel : '' }}
            </span>
            <span class="block truncate text-xs text-gray-500">
                {{ item.categoryPath }} ·
                {% if completed %}
                    {{ 'mine.item.completed'|trans({}, 'activity_content') }}
                {% elseif not_started %}
                    {{ 'mine.item.not_started'|trans({'%start%': item.startsAt|date('d/m/Y'), '%end%': item.deadline|date('d/m/Y')}, 'activity_content') }}
                {% else %}
                    {{ (overdue ? 'mine.item.overdue' : 'mine.item.pending')|trans({'%date%': item.deadline|date('d/m/Y')}, 'activity_content') }}
                {% endif %}
            </span>
            {# Below sm, the pill moves to its own line here instead of sitting shrink-0 at the end
               of the row, where it was squeezing the title/date text on narrow screens. #}
            <span class="mt-1 inline-block sm:hidden">
                {% include 'components/_my_activity_status_pill.html.twig' %}
            </span>
        </span>
        <span class="hidden shrink-0 self-center sm:block">
            {% include 'components/_my_activity_status_pill.html.twig' %}
        </span>
    </a>
</li>
