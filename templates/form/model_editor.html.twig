    bar_unchanged: 'editor.bar_unchanged'|trans({}, 'forms'),
    bar_changed: 'editor.bar_changed'|trans({}, 'forms'),
    bar_problems: 'editor.bar_problems'|trans({}, 'forms'),
    send_unchanged: 'editor.send_unchanged'|trans({}, 'forms'),
