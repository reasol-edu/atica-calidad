{# activity, folder, document — rendered OUTSIDE any <form> (see _activity_submissions.html.twig):
   it contains its own <form> elements (approve/reject/new-revision), which would be silently
   broken by the browser if nested inside the batch-upload form that wraps the compact rows. #}
{% set did = document.id.toRfc4122 %}
{% set active = document.activeRevision %}
{% set can_manage = this.canManageFolder(folder) %}
{% set can_review = this.canReviewFolder(folder) %}
{% set can_manage_as_uploader = this.canManageDocumentAsUploader(document) %}
{% set can_edit_metadata = this.canEditRevisionMetadata %}

<div class="ml-4 space-y-1.5 border-l-2 border-gray-100 pl-3">
    {% if not (can_manage or can_review) %}
        <p class="text-xs italic text-gray-400">{{ 'revision.uploader_only_hint'|trans({}, 'activity_content') }}</p>
    {% else %}
        {% for revision in this.getDocumentRevisions(document) %}
            <div class="flex flex-wrap items-center gap-2 rounded-md border border-gray-100 bg-white px-2.5 py-1.5">
                {% if can_manage and editingRevisionId == revision.id.toRfc4122 %}
                    <form data-action="submit->live#action:prevent" data-live-action-param="saveEditRevision" data-live-id-param="{{ did }}"
                          class="flex flex-wrap shrink-0 items-center gap-1.5">
                        <span class="text-xs text-gray-400">v</span>
                        <input type="number" min="1" data-model="norender|editVersionValue" value="{{ editVersionValue }}" autofocus
                               class="w-14 rounded-md border border-forest-300 bg-white px-1.5 py-0.5 text-xs focus:outline-none focus:ring-2 focus:ring-forest-500/20">
                        {% if can_edit_metadata %}
                            <select data-controller="tom-select"
                                    data-tom-select-placeholder-value="{{ 'revision.uploaded_by_placeholder'|trans({}, 'activity_content') }}"
                                    data-model="norender|editUploadedById" class="w-40 text-xs ts-local">
                                {% for candidate in this.getCentreTeachers %}
                                    <option value="{{ candidate.id.toRfc4122 }}" {{ candidate.id.toRfc4122 == editUploadedById ? 'selected' : '' }}>
                                        {{ candidate.name.lastName }}, {{ candidate.name.firstName }}
                                    </option>
                                {% endfor %}
                            </select>
                            <input type="datetime-local" data-model="norender|editRevisedAtValue" value="{{ editRevisedAtValue }}"
                                   class="rounded-md border border-forest-300 bg-white px-1.5 py-0.5 text-xs focus:outline-none focus:ring-2 focus:ring-forest-500/20">
                        {% endif %}
                        <button type="submit" class="text-forest-600 hover:text-forest-800">{{ ux_icon('heroicons:check', {class: 'h-3.5 w-3.5'}) }}</button>
                        <button type="button" data-action="live#action" data-live-action-param="cancelEditRevision" class="text-gray-400 hover:text-gray-600">{{ ux_icon('heroicons:x-mark', {class: 'h-3.5 w-3.5'}) }}</button>
                    </form>
                {% else %}
                    <span class="shrink-0 text-xs font-semibold text-gray-700">v{{ revision.version }}</span>
                    {% if can_manage %}
                        <button type="button" data-action="live#action" data-live-action-param="startEditRevision"
                                data-live-id-param="{{ did }}" data-live-revision-id-param="{{ revision.id.toRfc4122 }}"
                                class="text-gray-300 hover:text-gray-600">{{ ux_icon('heroicons:pencil-square', {class: 'h-3.5 w-3.5'}) }}</button>
                    {% endif %}
                {% endif %}
                <a href="{{ path('app_folder_document_revision_download', {folderId: folder.id.toRfc4122, documentId: did, revisionId: revision.id.toRfc4122}) }}"
                   class="shrink-0 text-gray-300 hover:text-forest-600">{{ ux_icon('heroicons:arrow-down-tray', {class: 'h-3.5 w-3.5'}) }}</a>
                <span class="shrink-0 text-xs text-gray-400">{{ revision.revisedAt|date('d/m/Y H:i') }} · {{ revision.uploadedBy.name.lastName }}, {{ revision.uploadedBy.name.firstName }}</span>
                {% if revision.pendingReview %}
                    <span class="shrink-0 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">{{ 'status.pending'|trans({}, 'activity_content') }}</span>
                {% elseif revision.rejected %}
                    <span class="shrink-0 rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">{{ 'status.rejected'|trans({}, 'activity_content') }}</span>
                {% else %}
                    <span class="shrink-0 rounded-full bg-forest-50 px-2 py-0.5 text-xs font-medium text-forest-700">{{ 'status.approved'|trans({}, 'activity_content') }}</span>
                {% endif %}
                {% if revision.reviewResult %}<span class="text-xs italic text-gray-400 truncate">{{ revision.reviewResult }}</span>{% endif %}
                <span class="flex-1"></span>
                {% if can_manage and revision.isApproved %}
                    {% if active == revision %}
                        <span class="shrink-0 text-xs font-medium text-forest-600">{{ 'revision.active'|trans({}, 'activity_content') }}</span>
                    {% else %}
                        <button type="button" data-action="live#action" data-live-action-param="setActiveRevision"
                                data-live-id-param="{{ did }}" data-live-revision-id-param="{{ revision.id.toRfc4122 }}"
                                class="shrink-0 rounded-md border border-gray-200 px-2 py-0.5 text-xs text-gray-600 hover:bg-gray-50">
                            {{ 'revision.make_active'|trans({}, 'activity_content') }}
                        </button>
                    {% endif %}
                {% endif %}
                {% if can_edit_metadata %}
                    {% if confirmingDeleteRevisionId == revision.id.toRfc4122 %}
                        <span class="shrink-0 inline-flex items-center gap-1">
                            <button type="button" data-action="live#action" data-live-action-param="deleteRevision" data-live-id-param="{{ did }}"
                                    class="rounded-md bg-red-600 px-1.5 py-0.5 text-xs font-medium text-white">{{ 'confirm_yes'|trans({}, 'activity_content') }}</button>
                            <button type="button" data-action="live#action" data-live-action-param="cancelDeleteRevision"
                                    class="rounded-md border border-gray-200 px-1.5 py-0.5 text-xs text-gray-600">{{ 'cancel'|trans({}, 'activity_content') }}</button>
                        </span>
                    {% else %}
                        <button type="button" data-action="live#action" data-live-action-param="askDeleteRevision"
                                data-live-id-param="{{ did }}" data-live-revision-id-param="{{ revision.id.toRfc4122 }}"
                                class="shrink-0 text-gray-300 hover:text-red-600" title="{{ 'revision.delete'|trans({}, 'activity_content') }}">
                            {{ ux_icon('heroicons:trash', {class: 'h-3.5 w-3.5'}) }}
                        </button>
                    {% endif %}
                {% endif %}
            </div>
            {% if can_review and revision.pendingReview %}
                <div class="ml-2 flex flex-wrap items-center gap-2 rounded-md border border-amber-100 bg-amber-50/50 px-2.5 py-2">
                    <form action="{{ path('app_folder_document_revision_approve', {folderId: folder.id.toRfc4122, documentId: did, revisionId: revision.id.toRfc4122}) }}" method="post"
                          class="flex flex-wrap items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('folder_document_revision_review_' ~ revision.id.toRfc4122) }}">
                        <input type="text" name="reviewResult" placeholder="{{ 'review.result_placeholder'|trans({}, 'activity_content') }}"
                               class="min-w-0 flex-1 rounded-md border border-gray-200 bg-white px-2 py-1 text-xs focus:outline-none focus:ring-2 focus:ring-forest-500/20">
                        <button type="submit" class="shrink-0 rounded-md bg-forest-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-forest-700">
                            {{ 'review.approve'|trans({}, 'activity_content') }}
                        </button>
                    </form>
                    <form action="{{ path('app_folder_document_revision_reject', {folderId: folder.id.toRfc4122, documentId: did, revisionId: revision.id.toRfc4122}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('folder_document_revision_review_' ~ revision.id.toRfc4122) }}">
                        <button type="submit" class="shrink-0 rounded-md border border-red-200 bg-white px-2.5 py-1 text-xs font-medium text-red-600 hover:bg-red-50">
                            {{ 'review.reject'|trans({}, 'activity_content') }}
                        </button>
                    </form>
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}

    {% if can_manage_as_uploader %}
        <form action="{{ path('app_folder_document_new_revision', {folderId: folder.id.toRfc4122, documentId: did}) }}" method="post" enctype="multipart/form-data"
              data-controller="file-drop" data-file-drop-single-value="true"
              data-file-drop-max-size-value="{{ 20 * 1024 * 1024 }}"
              data-file-drop-too-large-message-value="{{ 'upload.error.file_too_large'|trans({'%filename%': '%filename%'}, 'activity_content') }}" class="pt-1">
            <input type="hidden" name="_token" value="{{ csrf_token('folder_document_revision_' ~ did) }}">
            <div data-file-drop-target="dropzone"
                 data-action="dragenter->file-drop#dragEnter dragover->file-drop#dragOver dragleave->file-drop#dragLeave drop->file-drop#drop click->file-drop#triggerBrowse"
                 class="flex items-center gap-3 rounded-xl border-2 border-dashed border-gray-200 bg-white px-4 py-3 cursor-pointer hover:border-forest-300 hover:bg-forest-50/50 transition-colors">
                {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-5 w-5 text-gray-400 shrink-0'}) }}
                <span class="text-sm text-gray-500">{{ 'revision.dropzone_hint'|trans({}, 'activity_content') }}</span>
                <input type="file" id="activity-revision-upload-{{ did }}" name="file" data-file-drop-target="input" data-action="change->file-drop#change" class="sr-only">
            </div>
            <div data-file-drop-target="list" class="mt-2 space-y-1.5"></div>
            <template data-file-drop-target="itemTemplate">
                <div class="flex items-center gap-3 rounded-lg border border-gray-200 bg-white px-3 py-2">
                    {{ ux_icon('heroicons:document', {class: 'h-4 w-4 text-gray-400 shrink-0'}) }}
                    <span class="text-sm text-gray-700 flex-1 truncate" data-role="name"></span>
                    <span class="text-xs text-gray-400 shrink-0" data-role="size"></span>
                    <button type="button" data-action="click->file-drop#removeFile" class="shrink-0 text-gray-400 hover:text-red-600 transition-colors">
                        {{ ux_icon('heroicons:x-mark', {class: 'h-4 w-4'}) }}
                    </button>
                </div>
            </template>
            <p data-file-drop-target="clientError" class="mt-1 text-xs text-red-600 hidden"></p>
            <button type="submit" data-file-drop-target="submit" class="hidden mt-2 items-center gap-1.5 rounded-md bg-forest-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-forest-700">
                {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-4 w-4'}) }}
                {{ 'revision.upload_new'|trans({}, 'activity_content') }}
            </button>
        </form>
    {% endif %}
</div>
