{#
   What can be done to an obligation right from a list, without opening the activity: tick off a
   manual one ("Marcar hecha") or send the one file it is waiting for ("Subir" / "Nueva versión").
   Shared by the dashboard's "Tus próximos pasos" and "Mis actividades", so both offer the same.

   item:   ActivityDashboardItem
   return: where an upload comes back to ('dashboard' or 'mine'; see ActivityController::backAfterUpload())
   margin: right margin of each control, to line up with the row's own padding

   The "Marcar hecha" button calls the markDone live action, which the host component must have
   (MarksActivitiesDoneTrait).
#}
{% set margin = margin ?? 'mr-4' %}
{% if item.canMarkDone %}
    <button type="button" data-action="live#action" data-live-action-param="markDone"
            data-live-activity-id-param="{{ item.activity.id.toRfc4122 }}"
            data-live-profile-id-param="{{ item.profileId }}"
            data-live-list-item-id-param="{{ item.listItemId }}"
            data-live-leaf-id-param="{{ item.leafId }}"
            title="{{ 'agenda.mark_done_hint'|trans({}, 'dashboard') }}"
            class="{{ margin }} inline-flex shrink-0 items-center gap-1 self-center rounded-lg border border-gray-200 bg-white px-2.5 py-1 text-xs font-medium text-gray-600 transition-colors hover:border-forest-300 hover:bg-forest-50 hover:text-forest-700 max-sm:min-h-11 max-sm:min-w-11 max-sm:justify-center">
        {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
        <span class="hidden sm:inline">{{ 'agenda.mark_done'|trans({}, 'dashboard') }}</span>
        <span class="sr-only sm:hidden">{{ 'agenda.mark_done'|trans({}, 'dashboard') }}</span>
    </button>
{% endif %}
{% if item.uploadMode != '' %}
    {# A single file settles it: choosing one sends it (see quick_upload_controller.js). #}
    {% set revision = item.uploadMode == 'revision' %}
    {% if revision %}
        {# The revision endpoint sends the browser back to the page it was sent from. #}
        <form method="post" enctype="multipart/form-data" data-controller="quick-upload" data-action="change->quick-upload#send"
              action="{{ path('app_folder_document_new_revision', {folderId: item.activity.folder.id.toRfc4122, documentId: item.uploadDocumentId}) }}" class="{{ margin }} flex shrink-0 items-center">
            <input type="hidden" name="_token" value="{{ csrf_token('folder_document_revision_' ~ item.uploadDocumentId) }}">
            <input type="file" name="file" data-quick-upload-target="input" class="sr-only" tabindex="-1">
    {% else %}
        <form method="post" enctype="multipart/form-data" data-controller="quick-upload" data-action="change->quick-upload#send"
              action="{{ path('app_activity_submission_upload', {activityId: item.activity.id.toRfc4122}) }}" class="{{ margin }} flex shrink-0 items-center">
            <input type="hidden" name="_token" value="{{ csrf_token('activity_submission_upload_' ~ item.activity.id.toRfc4122) }}">
            <input type="hidden" name="items[0][slotKey]" value="{{ item.uploadSlotKey }}">
            <input type="hidden" name="return" value="{{ return }}">
            <input type="file" name="files[0]" data-quick-upload-target="input" class="sr-only" tabindex="-1">
    {% endif %}
            <button type="button" data-action="quick-upload#choose"
                    title="{{ (revision ? 'agenda.upload_revision_hint' : 'agenda.upload_hint')|trans({}, 'dashboard') }}"
                    class="inline-flex items-center gap-1 rounded-lg border border-gray-200 bg-white px-2.5 py-1 text-xs font-medium text-gray-600 transition-colors hover:border-forest-300 hover:bg-forest-50 hover:text-forest-700 max-sm:min-h-11 max-sm:min-w-11 max-sm:justify-center">
                {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-4 w-4'}) }}
                <span class="hidden sm:inline">{{ (revision ? 'agenda.upload_revision' : 'agenda.upload')|trans({}, 'dashboard') }}</span>
                <span class="sr-only sm:hidden">{{ (revision ? 'agenda.upload_revision' : 'agenda.upload')|trans({}, 'dashboard') }}</span>
            </button>
        </form>
{% endif %}
