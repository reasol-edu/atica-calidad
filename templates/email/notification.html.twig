{% extends 'email/_layout.html.twig' %}

{% block content %}
<p style="margin: 0 0 16px; font-size: 16px; font-weight: 600;">
    {{ heading }}
</p>
<div style="margin: 0 0 24px;">
    {{ bodyHtml|raw }}
</div>
{% if actionUrl is not empty %}
<p style="margin: 0 0 8px; text-align: center;">
    <a href="{{ actionUrl }}"
       style="display: inline-block; background-color: #677dae; color: #ffffff; font-size: 14px;
              font-weight: 600; padding: 12px 24px; border-radius: 8px; text-decoration: none;">
        {{ actionLabel ?: ('emails.notification.cta'|trans({}, 'emails')) }}
    </a>
</p>
{% endif %}
{% endblock %}
