{% extends 'layouts/app.html.twig' %}

{% set heading = audit ? 'audit.edit_title'|trans({'%code%': audit.code}, 'quality') : 'audit.new_title'|trans({}, 'quality') %}
{% block title %}{{ heading }} · {{ app_name }}{% endblock %}

{#
   An audit of the programme: what's audited (its processes), in which month, the objective and
   the team. Saving warns if someone in the team would audit their own process.
#}
{% block content %}
{% set field = 'block w-full rounded-xl border bg-white px-3.5 py-2.5 text-base sm:text-sm text-gray-900 placeholder-gray-400 focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20' %}
{% set label = 'block text-sm font-semibold text-gray-900' %}
<div class="px-4 sm:px-6 py-8 max-w-3xl mx-auto">

    <div class="mb-6">
        <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-1">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_quality_audits') }}" class="hover:text-forest-600 transition-colors">{{ 'audit.program'|trans({}, 'quality') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ heading }}</h1>
    </div>

    <form method="post" class="space-y-5 rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-xs">
        <input type="hidden" name="_token" value="{{ csrf_token('quality_audit_form') }}">

        <div class="space-y-1.5">
            <label for="audit-title" class="{{ label }}">{{ 'audit.title_field'|trans({}, 'quality') }}</label>
            <input id="audit-title" name="title" value="{{ values.title }}" required maxlength="255" {{ audit ? '' : 'autofocus' }}
                   placeholder="{{ 'audit.title_placeholder'|trans({}, 'quality') }}"
                   class="{{ field }} {{ errors.title is defined ? 'border-red-300' : 'border-gray-200' }}">
            {% if errors.title is defined %}<p class="text-xs text-red-600">{{ errors.title }}</p>{% endif %}
        </div>

        <fieldset class="space-y-1.5">
            <legend class="{{ label }} mb-1.5">{{ 'audit.scope'|trans({}, 'quality') }}</legend>
            <p class="text-xs text-gray-500">{{ 'audit.scope_help'|trans({}, 'quality') }}</p>
            <div class="max-h-64 overflow-y-auto rounded-xl border {{ errors.scope is defined ? 'border-red-300' : 'border-gray-200' }} p-3 space-y-1">
                {% for choice in sections %}
                    <label class="flex items-center gap-2 text-sm text-gray-800">
                        <input type="checkbox" name="scope[]" value="{{ choice.id }}" {{ choice.id in values.scope ? 'checked' : '' }} class="rounded text-forest-600 focus:ring-forest-500">
                        <span class="whitespace-pre">{{ choice.indented }}</span>
                    </label>
                {% endfor %}
            </div>
            {% if errors.scope is defined %}<p class="text-xs text-red-600">{{ errors.scope }}</p>{% endif %}
        </fieldset>

        <div class="grid gap-5 sm:grid-cols-2">
            <div class="space-y-1.5">
                <label for="audit-month" class="{{ label }}">{{ 'audit.month'|trans({}, 'quality') }}</label>
                <select id="audit-month" name="plannedMonth" class="{{ field }} {{ errors.plannedMonth is defined ? 'border-red-300' : 'border-gray-200' }}">
                    <option value="">—</option>
                    {% for key, name in months %}
                        <option value="{{ key }}" {{ values.plannedMonth == key ? 'selected' : '' }}>{{ name }}</option>
                    {% endfor %}
                </select>
                {% if errors.plannedMonth is defined %}<p class="text-xs text-red-600">{{ errors.plannedMonth }}</p>{% endif %}
            </div>
            <div class="space-y-1.5">
                <label for="audit-lead" class="{{ label }}">{{ 'audit.lead'|trans({}, 'quality') }}</label>
                <select id="audit-lead" name="lead" data-controller="tom-select"
                        data-tom-select-no-results-value="{{ 'tom_select.no_results'|trans({}, 'admin') }}"
                        class="w-full text-sm ts-local">
                    <option value="">{{ 'audit.lead_none'|trans({}, 'quality') }}</option>
                    {% for t in teachers %}
                        <option value="{{ t.id.toRfc4122 }}" {{ values.lead == t.id.toRfc4122 ? 'selected' : '' }}>{{ t.name.lastName }}, {{ t.name.firstName }}</option>
                    {% endfor %}
                </select>
                {% if errors.lead is defined %}<p class="text-xs text-red-600">{{ errors.lead }}</p>{% endif %}
            </div>
        </div>

        <fieldset class="space-y-1.5">
            <legend class="{{ label }} mb-1.5">{{ 'audit.auditors'|trans({}, 'quality') }} <span class="font-normal text-gray-500">{{ 'report.optional'|trans({}, 'quality') }}</span></legend>
            <div class="grid max-h-56 gap-1 overflow-y-auto rounded-xl border border-gray-200 p-3 sm:grid-cols-2">
                {% for t in teachers %}
                    <label class="flex items-center gap-2 text-sm text-gray-800">
                        <input type="checkbox" name="auditors[]" value="{{ t.id.toRfc4122 }}" {{ t.id.toRfc4122 in values.auditors ? 'checked' : '' }} class="rounded text-forest-600 focus:ring-forest-500">
                        {{ t.name.lastName }}, {{ t.name.firstName }}
                    </label>
                {% endfor %}
            </div>
            <p class="text-xs text-gray-500">{{ 'audit.independence_help'|trans({}, 'quality') }}</p>
        </fieldset>

        <div class="space-y-1.5">
            <label for="audit-objective" class="{{ label }}">{{ 'audit.objective'|trans({}, 'quality') }} <span class="font-normal text-gray-500">{{ 'report.optional'|trans({}, 'quality') }}</span></label>
            <textarea id="audit-objective" name="objective" rows="2" placeholder="{{ 'audit.objective_placeholder'|trans({}, 'quality') }}" class="{{ field }} border-gray-200">{{ values.objective }}</textarea>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-3">
            <a href="{{ audit ? path('app_quality_audit', {id: audit.id.toRfc4122}) : path('app_quality_audits') }}" class="text-sm font-medium text-gray-500 hover:text-gray-700">{{ 'cancel'|trans({}, 'quality') }}</a>
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 transition-colors">
                {{ ux_icon(audit ? 'heroicons:check' : 'heroicons:plus', {class: 'h-4 w-4'}) }}{{ (audit ? 'plan.save' : 'audit.add')|trans({}, 'quality') }}
            </button>
        </div>
    </form>
</div>
{% endblock %}
