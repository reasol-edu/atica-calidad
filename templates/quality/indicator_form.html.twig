{% extends 'layouts/app.html.twig' %}

{% set heading = indicator ? 'indicator.edit_title'|trans({}, 'quality') : 'indicator.new_title'|trans({}, 'quality') %}
{% block title %}{{ heading }} · {{ app_name }}{% endblock %}

{#
   An indicator, new or edited: what it is and how it's worked out, its unit and direction, who
   records it; and for the active year, its measurement calendar, target and alert threshold.
#}
{% block content %}
{% set field = 'block w-full rounded-xl border bg-white px-3.5 py-2.5 text-base sm:text-sm text-gray-900 placeholder-gray-400 focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20' %}
{% set label = 'block text-sm font-semibold text-gray-900' %}
{% set optional %}<span class="font-normal text-gray-500">{{ 'report.optional'|trans({}, 'quality') }}</span>{% endset %}
<div class="px-4 sm:px-6 py-8 max-w-2xl mx-auto">

    <div class="mb-6">
        <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-1">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_quality_index') }}" class="hover:text-forest-600 transition-colors">{{ 'quality'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
            <a href="{{ path('app_quality_indicators') }}" class="hover:text-forest-600 transition-colors">{{ 'indicator.title'|trans({}, 'quality') }}</a>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ heading }}</h1>
    </div>

    <form method="post" class="space-y-6 rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-xs">
        <input type="hidden" name="_token" value="{{ csrf_token('quality_indicator') }}">

        <div class="space-y-5">
            <div class="space-y-1.5">
                <label for="ind-name" class="{{ label }}">{{ 'indicator.name'|trans({}, 'quality') }}</label>
                <input id="ind-name" name="name" value="{{ values.name }}" required {{ indicator ? '' : 'autofocus' }}
                       placeholder="{{ 'indicator.name_placeholder'|trans({}, 'quality') }}"
                       class="{{ field }} {{ errors.name is defined ? 'border-red-300' : 'border-gray-200' }}">
                {% if errors.name is defined %}<p class="text-xs text-red-600">{{ errors.name }}</p>{% endif %}
            </div>

            <div class="space-y-1.5">
                <label for="ind-description" class="{{ label }}">{{ 'indicator.how'|trans({}, 'quality') }} {{ optional }}</label>
                <textarea id="ind-description" name="description" rows="2" placeholder="{{ 'indicator.how_placeholder'|trans({}, 'quality') }}"
                          class="{{ field }} border-gray-200">{{ values.description }}</textarea>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div class="space-y-1.5">
                    <label for="ind-section" class="{{ label }}">{{ 'classify.section'|trans({}, 'quality') }} {{ optional }}</label>
                    <select id="ind-section" name="section" data-controller="tom-select"
                            data-tom-select-no-results-value="{{ 'tom_select.no_results'|trans({}, 'admin') }}"
                            class="w-full text-sm ts-local">
                        <option value="">—</option>
                        {% for choice in sections %}
                            <option value="{{ choice.id }}" {{ values.section == choice.id ? 'selected' : '' }}>{{ choice.indented }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="space-y-1.5">
                    <label for="ind-responsible" class="{{ label }}">{{ 'indicator.responsible'|trans({}, 'quality') }}</label>
                    <select id="ind-responsible" name="responsible" data-controller="tom-select"
                            data-tom-select-no-results-value="{{ 'tom_select.no_results'|trans({}, 'admin') }}"
                            class="w-full text-sm ts-local">
                        <option value="">{{ 'action.responsible_me'|trans({}, 'quality') }}</option>
                        <optgroup label="{{ 'action.responsible_teachers'|trans({}, 'quality') }}">
                            {% for t in teachers %}
                                <option value="t:{{ t.id.toRfc4122 }}" {{ values.responsible == 't:' ~ t.id.toRfc4122 ? 'selected' : '' }}>{{ t.name.lastName }}, {{ t.name.firstName }}</option>
                            {% endfor %}
                        </optgroup>
                        {% if profiles is not empty %}
                            <optgroup label="{{ 'action.responsible_profiles'|trans({}, 'quality') }}">
                                {% for p in profiles %}
                                    <option value="p:{{ p.id.toRfc4122 }}" {{ values.responsible == 'p:' ~ p.id.toRfc4122 ? 'selected' : '' }}>{{ p.name }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endif %}
                    </select>
                    {% if errors.responsible is defined %}<p class="text-xs text-red-600">{{ errors.responsible }}</p>{% endif %}
                </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div class="space-y-1.5">
                    <label for="ind-unit" class="{{ label }}">{{ 'indicator.unit'|trans({}, 'quality') }} {{ optional }}</label>
                    <input id="ind-unit" name="unit" value="{{ values.unit }}" maxlength="20" placeholder="%, puntos, días…" class="{{ field }} border-gray-200">
                </div>
                <fieldset class="space-y-1.5">
                    <legend class="{{ label }} mb-1.5">{{ 'indicator.direction.label'|trans({}, 'quality') }}</legend>
                    <div class="flex flex-wrap gap-4 pt-1.5 text-sm text-gray-800">
                        {% for d in ['higher', 'lower'] %}
                            <label class="inline-flex items-center gap-2">
                                <input type="radio" name="direction" value="{{ d }}" {{ values.direction == d ? 'checked' : '' }} class="text-forest-600 focus:ring-forest-500">
                                {{ ('indicator.direction.' ~ d)|trans({}, 'quality') }}
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
            </div>

            {% if indicator %}
                <label class="flex items-start gap-2 text-sm text-gray-800">
                    <input type="checkbox" name="active" value="1" {{ values.active == '1' ? 'checked' : '' }} class="mt-0.5 rounded text-forest-600 focus:ring-forest-500">
                    <span>{{ 'indicator.active'|trans({}, 'quality') }} <span class="block text-xs text-gray-500">{{ 'indicator.active_help'|trans({}, 'quality') }}</span></span>
                </label>
            {% endif %}
        </div>

        {# ── This year ──────────────────────────────────────────────────────────── #}
        <fieldset class="space-y-5 border-t border-gray-100 pt-5">
            <legend class="text-sm font-semibold uppercase tracking-wide text-forest-700">{{ 'indicator.this_year'|trans({'%year%': year.name}, 'quality') }}</legend>

            <div class="space-y-1.5">
                <label for="ind-calendar" class="{{ label }}">{{ 'indicator.calendar'|trans({}, 'quality') }}</label>
                <select id="ind-calendar" name="calendar" class="{{ field }} {{ errors.calendar is defined ? 'border-red-300' : 'border-gray-200' }}">
                    <option value="">{{ 'indicator.calendar_none'|trans({}, 'quality') }}</option>
                    {% for c in calendars %}
                        <option value="{{ c.id.toRfc4122 }}" {{ values.calendar == c.id.toRfc4122 ? 'selected' : '' }}>{{ c.name }} ({{ c.periods|map(p => p.name)|join(', ') }})</option>
                    {% endfor %}
                </select>
                <p class="text-xs text-gray-500">{{ 'indicator.calendar_help'|trans({}, 'quality') }} <a href="{{ path('app_quality_calendars') }}" class="font-medium text-forest-700 hover:underline">{{ 'calendar.title'|trans({}, 'quality') }}</a></p>
                {% if errors.calendar is defined %}<p class="text-xs text-red-600">{{ errors.calendar }}</p>{% endif %}
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div class="space-y-1.5">
                    <label for="ind-target" class="{{ label }}">{{ 'indicator.target'|trans({}, 'quality') }} {{ optional }}</label>
                    <input id="ind-target" name="target" value="{{ values.target }}" inputmode="decimal" class="{{ field }} {{ errors.target is defined ? 'border-red-300' : 'border-gray-200' }}">
                    <p class="text-xs text-gray-500">{{ 'indicator.target_help'|trans({}, 'quality') }}</p>
                    {% if errors.target is defined %}<p class="text-xs text-red-600">{{ errors.target }}</p>{% endif %}
                </div>
                <div class="space-y-1.5">
                    <label for="ind-threshold" class="{{ label }}">{{ 'indicator.threshold'|trans({}, 'quality') }} {{ optional }}</label>
                    <input id="ind-threshold" name="alertThreshold" value="{{ values.alertThreshold }}" inputmode="decimal" class="{{ field }} {{ errors.alertThreshold is defined ? 'border-red-300' : 'border-gray-200' }}">
                    <p class="text-xs text-gray-500">{{ 'indicator.threshold_help'|trans({}, 'quality') }}</p>
                    {% if errors.alertThreshold is defined %}<p class="text-xs text-red-600">{{ errors.alertThreshold }}</p>{% endif %}
                </div>
            </div>
        </fieldset>

        <div class="flex flex-wrap items-center justify-end gap-3">
            <a href="{{ indicator ? path('app_quality_indicator', {id: indicator.id.toRfc4122}) : path('app_quality_indicators') }}" class="text-sm font-medium text-gray-500 hover:text-gray-700">{{ 'cancel'|trans({}, 'quality') }}</a>
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 transition-colors">
                {{ ux_icon(indicator ? 'heroicons:check' : 'heroicons:plus', {class: 'h-4 w-4'}) }}
                {{ (indicator ? 'plan.save' : 'indicator.add')|trans({}, 'quality') }}
            </button>
        </div>
    </form>
</div>
{% endblock %}
