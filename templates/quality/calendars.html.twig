{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'calendar.title'|trans({}, 'quality') }} · {{ app_name }}{% endblock %}

{#
   The measurement calendars of the year being viewed: when the indicators are measured. A new one
   starts from a template (by evaluation, by term, monthly, the whole year) or empty; a new year
   can copy the previous one's, with the indicators' targets.
#}
{% block content %}
{% set field = 'block w-full rounded-xl border bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20' %}
<div class="px-4 sm:px-6 py-8 max-w-4xl mx-auto space-y-6">

    <div>
        <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-1">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_quality_index') }}" class="hover:text-forest-600 transition-colors">{{ 'quality'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
            <a href="{{ path('app_quality_indicators') }}" class="hover:text-forest-600 transition-colors">{{ 'indicator.title'|trans({}, 'quality') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'calendar.title'|trans({}, 'quality') }}{% if year %} <span class="font-normal text-gray-500">{{ year.name }}</span>{% endif %}</h1>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">{{ 'calendar.intro'|trans({}, 'quality') }}</p>
    </div>

    {% if writable and previous %}
        <form method="post" action="{{ path('app_quality_calendars_copy') }}" class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-forest-200 bg-forest-50/50 px-5 py-4">
            <input type="hidden" name="_token" value="{{ csrf_token('quality_calendars_copy') }}">
            <p class="text-sm text-gray-700">{{ 'calendar.copy_help'|trans({'%year%': previous.name}, 'quality') }}</p>
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3.5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                {{ ux_icon('heroicons:document-duplicate', {class: 'h-4 w-4'}) }}{{ 'calendar.copy'|trans({'%year%': previous.name}, 'quality') }}
            </button>
        </form>
    {% endif %}

    <section class="rounded-2xl border border-gray-200 bg-white shadow-xs">
        {% if calendars is empty %}
            <p class="px-6 py-8 text-center text-sm text-gray-500">{{ 'calendar.empty'|trans({}, 'quality') }}</p>
        {% else %}
            <ul class="divide-y divide-gray-100">
                {% for c in calendars %}
                    {% set used = usage[c.id.toRfc4122] ?? [] %}
                    <li>
                        <a href="{{ path('app_quality_calendar', {id: c.id.toRfc4122}) }}" class="flex flex-wrap items-start justify-between gap-3 px-6 py-4 transition-colors hover:bg-gray-50">
                            <span class="min-w-0">
                                <span class="block text-sm font-semibold text-gray-900">{{ c.name }}</span>
                                <span class="mt-0.5 block text-xs text-gray-500">{{ c.periods|map(p => p.name)|join(' · ') }}</span>
                            </span>
                            <span class="shrink-0 text-xs text-gray-500">{{ 'calendar.used_by'|trans({'%count%': used|length}, 'quality') }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {% if writable %}
        <form method="post" class="space-y-4 rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-xs">
            <input type="hidden" name="_token" value="{{ csrf_token('quality_calendar_new') }}">
            <h2 class="text-base font-semibold text-gray-900">{{ 'calendar.new'|trans({}, 'quality') }}</h2>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-1.5">
                    <label for="cal-name" class="block text-sm font-semibold text-gray-900">{{ 'calendar.name'|trans({}, 'quality') }}</label>
                    <input id="cal-name" name="name" value="{{ values.name }}" required maxlength="100" placeholder="{{ 'calendar.name_placeholder'|trans({}, 'quality') }}"
                           class="{{ field }} {{ errors.name is defined ? 'border-red-300' : 'border-gray-200' }}">
                    {% if errors.name is defined %}<p class="text-xs text-red-600">{{ errors.name }}</p>{% endif %}
                </div>
                <div class="space-y-1.5">
                    <label for="cal-template" class="block text-sm font-semibold text-gray-900">{{ 'calendar.template'|trans({}, 'quality') }}</label>
                    <select id="cal-template" name="template" class="{{ field }} border-gray-200">
                        {% for t in templates|merge(['empty']) %}
                            <option value="{{ t }}" {{ values.template == t ? 'selected' : '' }}>{{ ('calendar.templates.' ~ t)|trans({}, 'quality') }}</option>
                        {% endfor %}
                    </select>
                    {% if errors.template is defined %}<p class="text-xs text-red-600">{{ errors.template }}</p>{% endif %}
                </div>
            </div>
            <p class="text-xs text-gray-500">{{ 'calendar.template_help'|trans({}, 'quality') }}</p>
            <div class="flex justify-end">
                <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700">
                    {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}{{ 'calendar.create'|trans({}, 'quality') }}
                </button>
            </div>
        </form>
    {% endif %}
</div>
{% endblock %}
