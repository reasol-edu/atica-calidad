{
    frankenphp {
        # El binario no incluye php.ini en Linux/macOS: sin esto PHP usa sus valores por defecto
        # (2M por fichero, 8M por envío, 128M de memoria, display_errors activado). Con display_errors
        # activado, el aviso de «POST demasiado grande» se escribe antes que las cabeceras, la sesión
        # falla y el navegador recibe una respuesta rota (pantalla en blanco).
        # Sin la cabecera «X-Powered-By: PHP/x.y.z», que dice qué versión se ejecuta.
        php_ini expose_php Off
        php_ini display_errors Off
        php_ini log_errors On
        php_ini upload_max_filesize 32M
        php_ini post_max_size 128M
        php_ini max_file_uploads 50
        php_ini memory_limit 256M
    }
    admin off

    log {
        output stderr
        level WARN
    }
}

# SERVER_ADDR se inyecta desde el script de arranque, p.ej. ":8080"
{$SERVER_ADDR} {
    root * {$DOCUMENT_ROOT}

    encode gzip

    # Cabeceras de seguridad de base. La CSP no se aplica aquí (se irá afinando
    # aparte: UX-Live, Quill y TomSelect requieren validación cuidadosa de los
    # orígenes). Solo se aplican las que no rompen ninguna funcionalidad.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), camera=(), microphone=(), payment=()"
        -Server
    }

    # Caché de ficheros estáticos. public/assets/ lo genera AssetMapper con el
    # hash del contenido en el nombre de fichero, así que es seguro cachear
    # "para siempre"; public/static/ (favicons, logo, fuentes) no lleva hash,
    # así que usa una duración moderada en vez de "immutable".
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @static path /static/*
    header @static Cache-Control "public, max-age=2592000"

    # FrankenPHP gestiona tanto PHP como ficheros estáticos
    php_server
}
