<div class="px-4 sm:px-6 py-6 max-w-7xl mx-auto"
     data-controller="form-model-editor"
     data-form-model-editor-config-value="{{ editor|json_encode|e('html_attr') }}"
     data-form-model-editor-labels-value="{{ labels|json_encode|e('html_attr') }}">

    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
            <a href="{{ path('app_form_models') }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-forest-600">
                {{ ux_icon('heroicons:arrow-left', {class: 'h-4 w-4'}) }}{{ 'models.title'|trans({}, 'forms') }}
            </a>
            <h1 class="mt-1 break-words text-2xl font-bold text-gray-900">{{ document.name }}</h1>
            <p class="text-sm text-gray-500">{{ document.folder.documentSection.name }} › {{ document.folder.name }}</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <label for="model-code-input" class="text-sm text-gray-600">{{ 'models.code'|trans({}, 'forms') }}</label>
            <input id="model-code-input" data-form-model-editor-target="code" maxlength="40" value="{{ model.code }}"
                   class="w-32 rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500">
            <a href="{{ path('app_form_model_preview', {id: model.id.toRfc4122}) }}" target="_blank" rel="noopener"
               class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3.5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                {{ ux_icon('heroicons:eye', {class: 'h-4 w-4'}) }}{{ 'editor.preview'|trans({}, 'forms') }}
            </a>
        </div>
    </div>

    <p class="mt-3 text-sm" role="status" aria-live="polite" data-form-model-editor-target="status"></p>

    <div class="mt-4 grid grid-cols-1 gap-6 lg:grid-cols-[16rem_minmax(0,1fr)]">
        <nav aria-label="{{ 'editor.outline'|trans({}, 'forms') }}" class="hidden lg:block">
            <div class="sticky top-4 max-h-[80vh] overflow-y-auto rounded-2xl border border-gray-200 bg-white p-3 shadow-xs" data-form-model-editor-target="outline"></div>
        </nav>
        <div class="min-w-0 space-y-4" data-form-model-editor-target="canvas"></div>
    </div>

    <section class="mt-8 rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
        <h2 class="text-base font-semibold text-gray-900">{{ 'editor.send_title'|trans({}, 'forms') }}</h2>
        <p class="mt-1 text-sm text-gray-500">{{ (document.folder.requiresReview ? 'editor.send_review' : 'editor.send_direct')|trans({}, 'forms') }}</p>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-amber-800" data-form-model-editor-target="problems">
            {% for p in problems %}<li>{{ p }}</li>{% endfor %}
        </ul>
        <form method="post" action="{{ path('app_form_model_send', {id: model.id.toRfc4122}) }}" class="mt-3 flex flex-wrap items-end gap-3">
            <input type="hidden" name="_token" value="{{ csrf_token('form_model_send_' ~ model.id.toRfc4122) }}">
            <div class="min-w-0 flex-1">
                <label for="send-description" class="block text-sm font-medium text-gray-700">{{ 'editor.send_description'|trans({}, 'forms') }}</label>
                <input id="send-description" name="description" maxlength="2000" class="mt-1 w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500">
            </div>
            <button type="submit" data-form-model-editor-target="send" class="w-full rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 sm:w-auto">{{ 'editor.send'|trans({}, 'forms') }}</button>
        </form>
    </section>
</div>
{% endblock %}
