{# node: {section: DocumentSection, children: [...]}, depth: int — inherits the parent component's context (this, renamingId, addValue, errors...) #}
{% set section = node.section %}
{% set sid = section.id.toRfc4122 %}
<li class="js-document-section-node" data-section-id="{{ sid }}">
    <div class="group flex items-center gap-1.5 rounded-lg px-2 py-1.5 hover:bg-gray-50" style="padding-left: {{ depth * 1.25 }}rem">
        <span class="js-drag-handle shrink-0 cursor-grab text-gray-300 hover:text-gray-500"
              title="{{ 'document_section.drag'|trans({}, 'admin') }}">
            {{ ux_icon('heroicons:bars-2', {class: 'h-4 w-4'}) }}
        </span>

        {% if renamingId == sid %}
            <form data-action="submit->live#action:prevent" data-live-action-param="saveRename"
                  class="flex flex-1 items-center gap-1.5 min-w-0">
                <input type="text" data-model="norender|renameValue" value="{{ renameValue }}" autofocus
                       class="min-w-0 flex-1 rounded-md border border-forest-300 bg-white px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-forest-500/20">
                <button type="submit" class="shrink-0 text-forest-600 hover:text-forest-800" title="{{ 'document_section.save'|trans({}, 'admin') }}">
                    {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                </button>
                <button type="button" data-action="live#action" data-live-action-param="cancelRename"
                        class="shrink-0 text-gray-400 hover:text-gray-600" title="{{ 'document_section.cancel'|trans({}, 'admin') }}">
                    {{ ux_icon('heroicons:x-mark', {class: 'h-4 w-4'}) }}
                </button>
            </form>
        {% else %}
            <button type="button" data-action="live#action" data-live-action-param="startRename" data-live-id-param="{{ sid }}"
                    class="flex-1 min-w-0 truncate text-left text-sm text-gray-800 hover:text-forest-700">
                {{ section.name }}
            </button>
        {% endif %}

        <button type="button" data-action="live#action" data-live-action-param="toggleProfilePanel" data-live-id-param="{{ sid }}"
                title="{{ 'document_section.profiles.title'|trans({}, 'admin') }}"
                class="shrink-0 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs transition-opacity
                       {{ section.isRestricted ? 'bg-violet-50 text-violet-700' : 'text-gray-300 opacity-0 group-hover:opacity-100 hover:text-violet-500 hover:bg-violet-50' }}">
            {{ ux_icon('heroicons:shield-check', {class: 'h-3.5 w-3.5'}) }}
            {% if section.isRestricted %}{{ section.profileRestrictions|length }}{% endif %}
        </button>

        <button type="button" data-action="live#action" data-live-action-param="toggleAdd" data-live-parent-id-param="{{ sid }}"
                title="{{ 'document_section.add_child'|trans({}, 'admin') }}"
                class="shrink-0 inline-flex items-center justify-center rounded-full p-1 text-gray-300 opacity-0 group-hover:opacity-100 hover:text-forest-600 hover:bg-forest-50 transition-opacity">
            {{ ux_icon('heroicons:plus', {class: 'h-3.5 w-3.5'}) }}
        </button>

        {% if confirmingDeleteId == sid %}
            <span class="shrink-0 inline-flex items-center gap-1">
                <button type="button" data-action="live#action" data-live-action-param="deleteSection" data-live-id-param="{{ sid }}"
                        class="rounded-md bg-red-600 px-1.5 py-0.5 text-xs font-medium text-white hover:bg-red-700">
                    {{ 'document_section.confirm_yes'|trans({}, 'admin') }}
                </button>
                <button type="button" data-action="live#action" data-live-action-param="cancelDelete"
                        class="rounded-md border border-gray-200 px-1.5 py-0.5 text-xs text-gray-600 hover:bg-gray-50">
                    {{ 'document_section.cancel'|trans({}, 'admin') }}
                </button>
            </span>
        {% else %}
            <button type="button" data-action="live#action" data-live-action-param="askDelete" data-live-id-param="{{ sid }}"
                    title="{{ 'document_section.delete'|trans({}, 'admin') }}"
                    class="shrink-0 inline-flex items-center justify-center rounded-full p-1 text-gray-300 opacity-0 group-hover:opacity-100 hover:text-red-600 hover:bg-red-50 transition-opacity">
                {{ ux_icon('heroicons:trash', {class: 'h-3.5 w-3.5'}) }}
            </button>
        {% endif %}
    </div>

    {% if errors.rename is defined and renamingId == sid %}
        <p class="ml-8 text-xs text-red-600">{{ errors.rename }}</p>
    {% endif %}
    {% if errors.delete is defined and confirmingDeleteId == sid %}
        <p class="ml-8 text-xs text-red-600">{{ errors.delete }}</p>
    {% endif %}

    {% if profilePanelId == sid %}
        <div class="ml-8 mb-2 rounded-lg border border-violet-100 bg-violet-50/50 p-3">
            <p class="mb-2 text-xs font-medium text-violet-800">{{ 'document_section.profiles.title'|trans({}, 'admin') }}</p>
            {% if available_rows is empty %}
                <p class="text-xs italic text-violet-400">{{ 'document_section.profiles.empty'|trans({}, 'admin') }}</p>
            {% else %}
                <div class="flex flex-wrap gap-1.5">
                    {% for row in available_rows %}
                        {% set checked = section.hasProfileRestriction(row.profile, row.listItem) %}
                        <button type="button" data-action="live#action" data-live-action-param="toggleProfileRestriction"
                                data-live-id-param="{{ sid }}" data-live-row-key-param="{{ row.key }}"
                                class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs transition-colors
                                       {{ checked ? 'bg-violet-600 text-white hover:bg-violet-700' : 'bg-white text-violet-700 border border-violet-200 hover:bg-violet-100' }}">
                            {% if checked %}{{ ux_icon('heroicons:check', {class: 'h-3 w-3'}) }}{% endif %}
                            {{ row.displayName }}
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if addingParentId == sid %}
        <form data-action="submit->live#action:prevent" data-live-action-param="addSection" data-live-parent-id-param="{{ sid }}"
              class="ml-8 mb-2 flex items-center gap-2">
            <input type="text" data-model="norender|addValue" value="{{ addValue }}" autofocus
                   placeholder="{{ 'document_section.field.name_placeholder'|trans({}, 'admin') }}"
                   class="min-w-0 flex-1 rounded-md border border-gray-200 bg-white px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-forest-500/20">
            <button type="submit" class="shrink-0 rounded-md bg-forest-600 px-2 py-1 text-white hover:bg-forest-700">
                {{ ux_icon('heroicons:plus', {class: 'h-3.5 w-3.5'}) }}
            </button>
        </form>
        {% if errors.add is defined %}<p class="ml-8 mb-2 text-xs text-red-600">{{ errors.add }}</p>{% endif %}
    {% endif %}

    <ul class="js-document-section-list" data-parent-id="{{ sid }}" style="min-height: 0.5rem;">
        {% for child in node.children %}
            {% include 'components/Admin/_document_section_node.html.twig' with {node: child, depth: depth + 1} %}
        {% endfor %}
    </ul>
</li>
