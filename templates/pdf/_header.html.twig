{# A header given as HTML (PdfHeader: already escaped or sanitized, with its fields filled in); else the title and the centre's name. #}
{% if header is defined and header is not null %}
    {{ header.html|raw }}
{% else %}
<table width="100%" style="border-collapse:collapse;border-bottom:2px solid #46603d;padding-bottom:4px;font-family:sourcesanspro,sans-serif;">
    <tr>
        <td style="text-align:left;font-size:10pt;font-weight:bold;color:#2e2822;">{{ pdfTitle }}</td>
        <td style="text-align:right;font-size:9pt;font-weight:bold;color:#46603d;">{{ centre.name }}</td>
    </tr>
</table>
{% endif %}
