{#
   "Tus próximos pasos": only the few most urgent obligations the teacher can act on right now, plus
   one line of overall progress. The full list and the totals by status live in "Mis actividades"
   (linked below) — not repeated here.
#}
{% import 'components/_activity_status.html.twig' as activity_status %}
{% set summary = this.summary %}

<div class="rounded-2xl border border-gray-200 bg-white shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-2 px-6 py-5 border-b border-gray-100">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-900">
            {{ ux_icon('heroicons:check-circle', {class: 'h-5 w-5 text-forest-600'}) }}
            {{ 'activities.title'|trans({}, 'dashboard') }}
        </h2>
        {% if summary.total > 0 %}
            <a href="{{ path('app_activities') }}" class="text-sm font-medium text-forest-600 hover:text-forest-700">
                {{ 'activities.view_all'|trans({}, 'dashboard') }} →
            </a>
        {% endif %}
    </div>

    <div class="px-6 py-5 space-y-4">
        {% if summary.total == 0 %}
            <p class="text-sm text-gray-500">{{ 'activities.none'|trans({}, 'dashboard') }}</p>
        {% else %}
            {# ── Overall progress, in one line ───────────────────────────────── #}
            <div>
                <div class="flex h-2 w-full overflow-hidden rounded-full bg-gray-100"
                     role="img" aria-label="{{ 'activities.progress'|trans({'%done%': summary.completed, '%total%': summary.total, '%percent%': summary.completionPercentage}, 'dashboard') }}">
                    <div class="bg-forest-500" style="width: {{ summary.completed / summary.total * 100 }}%"></div>
                    <div class="bg-sky-400" style="width: {{ summary.inReview / summary.total * 100 }}%"></div>
                </div>
                <p class="mt-1.5 text-xs text-gray-500">
                    {{ 'activities.progress'|trans({'%done%': summary.completed, '%total%': summary.total, '%percent%': summary.completionPercentage}, 'dashboard') }}
                    {%- if summary.inReview > 0 %} · {{ 'activities.in_review'|trans({'%count%': summary.inReview}, 'dashboard') }}{% endif %}
                    {%- if summary.overdue > 0 %} · <span class="font-semibold text-red-600">{{ 'activities.overdue'|trans({'%count%': summary.overdue}, 'dashboard') }}</span>{% endif %}
                </p>
            </div>

            {# ── Next steps ──────────────────────────────────────────────────── #}
            {% if summary.nextSteps is not empty %}
                <ul class="-mx-6 divide-y divide-gray-100">
                    {% for item in summary.nextSteps %}
                        {% set status = item.status.value %}
                        <li>
                            <a href="{{ path('app_activities', {category: item.activity.category.id.toRfc4122, activity: item.activity.id.toRfc4122}) }}"
                               class="flex items-start gap-3 px-6 py-3 transition-colors {{ activity_status.row_bg(status) }}">
                                <span class="mt-0.5">{{ activity_status.icon(status) }}</span>
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-medium text-gray-900">
                                        {{ item.activity.title }}{{ item.ownerLabel ? ' · ' ~ item.ownerLabel : '' }}
                                    </span>
                                    <span class="block truncate text-xs text-gray-500">
                                        {{ item.categoryPath }} · {{ activity_status.detail(item) }}
                                    </span>
                                    <span class="mt-1 inline-block sm:hidden">{{ activity_status.pill(status) }}</span>
                                </span>
                                <span class="hidden self-center sm:block">{{ activity_status.pill(status) }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                {% if summary.todo > summary.nextSteps|length %}
                    <p class="text-xs text-gray-500">
                        {{ 'activities.more_to_do'|trans({'%count%': summary.todo - summary.nextSteps|length}, 'dashboard') }}
                    </p>
                {% endif %}
            {% else %}
                <div class="rounded-xl border border-forest-100 bg-forest-50 px-4 py-6 text-center">
                    {{ ux_icon('heroicons:check-badge', {class: 'mx-auto mb-2 h-8 w-8 text-forest-400'}) }}
                    <p class="text-sm font-medium text-forest-700">{{ 'activities.all_done'|trans({}, 'dashboard') }}</p>
                    {% if summary.nextUpcoming %}
                        <p class="mt-1 text-xs text-forest-600">
                            {{ 'activities.next_upcoming'|trans({
                                '%title%': summary.nextUpcoming.activity.title,
                                '%date%': summary.nextUpcoming.startsAt|date('d/m/Y'),
                            }, 'dashboard') }}
                        </p>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
