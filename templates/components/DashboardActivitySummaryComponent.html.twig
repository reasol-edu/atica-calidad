{#
   "Tus próximos pasos": what the teacher has to do now — activity obligations and "Mejora
   continua" tasks in ONE list, overdue first, then this week, then the rest (TeacherAgendaBuilder) —
   plus one line of overall progress. The full list and the totals by status live in "Mis
   actividades" (linked below) and the tasks' hub — not repeated here.
#}
{% import 'components/_activity_status.html.twig' as activity_status %}
{% import 'quality/_macros.html.twig' as quality %}
{% set summary = this.summary %}
{% set agenda = this.agenda %}

<div {{ attributes }} class="rounded-2xl border border-gray-200 bg-white shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-2 px-6 py-5 border-b border-gray-100">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-900">
            {{ ux_icon('heroicons:check-circle', {class: 'h-5 w-5 text-forest-600'}) }}
            {{ 'activities.title'|trans({}, 'dashboard') }}
            {% if agenda.overdue > 0 %}
                <span class="rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">{{ 'activities.overdue'|trans({'%count%': agenda.overdue}, 'dashboard') }}</span>
            {% endif %}
        </h2>
        <span class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium">
            {% if summary.total > 0 %}
                <a href="{{ path('app_activities') }}" class="text-forest-600 hover:text-forest-700">{{ 'activities.view_all'|trans({}, 'dashboard') }} →</a>
            {% endif %}
            {% if agenda.hasTasks %}
                <a href="{{ path('app_quality_index') }}" class="text-forest-600 hover:text-forest-700">{{ 'task.view_all'|trans({}, 'quality') }} →</a>
            {% endif %}
        </span>
    </div>

    <div class="px-6 py-5 space-y-4">
        {% if summary.total == 0 and agenda.entries is empty %}
            <p class="text-sm text-gray-500">{{ 'activities.none'|trans({}, 'dashboard') }}</p>
        {% else %}
            {# ── Overall progress, in one line ───────────────────────────────── #}
            {% if summary.total > 0 %}
            <div>
                <div class="flex h-2 w-full overflow-hidden rounded-full bg-gray-100"
                     role="img" aria-label="{{ 'activities.progress'|trans({'%done%': summary.completed, '%total%': summary.total, '%percent%': summary.completionPercentage}, 'dashboard') }}">
                    <div class="bg-forest-500" style="width: {{ summary.completed / summary.total * 100 }}%"></div>
                    <div class="bg-sky-400" style="width: {{ summary.inReview / summary.total * 100 }}%"></div>
                </div>
                <p class="mt-1.5 text-xs text-gray-500">
                    {{ 'activities.progress'|trans({'%done%': summary.completed, '%total%': summary.total, '%percent%': summary.completionPercentage}, 'dashboard') }}
                    {%- if summary.inReview > 0 %} · {{ 'activities.in_review'|trans({'%count%': summary.inReview}, 'dashboard') }}{% endif %}
                    {%- if summary.overdue > 0 %} · <span class="font-semibold text-red-600">{{ 'activities.overdue'|trans({'%count%': summary.overdue}, 'dashboard') }}</span>{% endif %}
                </p>
            </div>
            {% endif %}

            {# ── What to do now: activities and tasks together ───────────────── #}
            {% if agenda.entries is not empty %}
                <div class="-mx-6 space-y-1">
                    {% set current = null %}
                    {% for entry in agenda.entries %}
                        {% if entry.bucket != current %}
                            {% if current is not null %}</ul>{% endif %}
                            {% set current = entry.bucket %}
                            <h3 class="px-6 pt-2 pb-1 text-xs font-semibold uppercase tracking-wide {{ current == 'overdue' ? 'text-red-600' : 'text-gray-500' }}">
                                {{ ('activities.agenda.' ~ current)|trans({}, 'dashboard') }}
                            </h3>
                            <ul class="divide-y divide-gray-100">
                        {% endif %}
                        {% if entry.activity is not null %}
                            {% set item = entry.activity %}
                            {% set status = item.status.value %}
                            <li class="flex items-stretch transition-colors {{ activity_status.row_bg(status) }}">
                                <a href="{{ path('app_activities', item.linkParams) }}"
                                   class="flex min-w-0 flex-1 items-start gap-3 px-6 py-3">
                                    <span class="mt-0.5">{{ activity_status.icon(status) }}</span>
                                    <span class="min-w-0 flex-1">
                                        {# Two lines below sm, where a long title used to lose its end and the due date. #}
                                        <span class="block line-clamp-2 text-sm font-medium text-gray-900 sm:line-clamp-1">
                                            {{ item.activity.title }}{{ item.ownerLabel ? ' · ' ~ item.ownerLabel : '' }}
                                        </span>
                                        <span class="block line-clamp-2 text-xs text-gray-500 sm:line-clamp-1">
                                            {{ item.categoryPath }} · {{ activity_status.detail(item) }}
                                        </span>
                                        <span class="mt-1 inline-block sm:hidden">{{ activity_status.pill(status) }}</span>
                                    </span>
                                    <span class="hidden self-center sm:block">{{ activity_status.pill(status) }}</span>
                                </a>
                                {% if item.canMarkDone %}
                                    {# A manual activity: tick it off without opening it. #}
                                    <button type="button" data-action="live#action" data-live-action-param="markDone"
                                            data-live-activity-id-param="{{ item.activity.id.toRfc4122 }}"
                                            data-live-profile-id-param="{{ item.profileId }}"
                                            data-live-list-item-id-param="{{ item.listItemId }}"
                                            data-live-leaf-id-param="{{ item.leafId }}"
                                            title="{{ 'agenda.mark_done_hint'|trans({}, 'dashboard') }}"
                                            class="mr-6 inline-flex shrink-0 items-center gap-1 self-center rounded-lg border border-gray-200 bg-white px-2.5 py-1 text-xs font-medium text-gray-600 transition-colors hover:border-forest-300 hover:bg-forest-50 hover:text-forest-700">
                                        {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                                        <span class="hidden sm:inline">{{ 'agenda.mark_done'|trans({}, 'dashboard') }}</span>
                                        <span class="sr-only sm:hidden">{{ 'agenda.mark_done'|trans({}, 'dashboard') }}</span>
                                    </button>
                                {% endif %}
                                {% if item.uploadMode != '' %}
                                    {# A single file settles it: choosing one sends it (see quick_upload_controller.js). #}
                                    {% set revision = item.uploadMode == 'revision' %}
                                    {% if revision %}
                                        <form method="post" enctype="multipart/form-data" data-controller="quick-upload" data-action="change->quick-upload#send"
                                              action="{{ path('app_folder_document_new_revision', {folderId: item.activity.folder.id.toRfc4122, documentId: item.uploadDocumentId}) }}" class="mr-6 flex shrink-0 items-center">
                                            <input type="hidden" name="_token" value="{{ csrf_token('folder_document_revision_' ~ item.uploadDocumentId) }}">
                                            <input type="file" name="file" data-quick-upload-target="input" class="sr-only" tabindex="-1">
                                    {% else %}
                                        <form method="post" enctype="multipart/form-data" data-controller="quick-upload" data-action="change->quick-upload#send"
                                              action="{{ path('app_activity_submission_upload', {activityId: item.activity.id.toRfc4122}) }}" class="mr-6 flex shrink-0 items-center">
                                            <input type="hidden" name="_token" value="{{ csrf_token('activity_submission_upload_' ~ item.activity.id.toRfc4122) }}">
                                            <input type="hidden" name="items[0][slotKey]" value="{{ item.uploadSlotKey }}">
                                            <input type="hidden" name="return" value="dashboard">
                                            <input type="file" name="files[0]" data-quick-upload-target="input" class="sr-only" tabindex="-1">
                                    {% endif %}
                                            <button type="button" data-action="quick-upload#choose"
                                                    title="{{ (revision ? 'agenda.upload_revision_hint' : 'agenda.upload_hint')|trans({}, 'dashboard') }}"
                                                    class="inline-flex items-center gap-1 rounded-lg border border-gray-200 bg-white px-2.5 py-1 text-xs font-medium text-gray-600 transition-colors hover:border-forest-300 hover:bg-forest-50 hover:text-forest-700">
                                                {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-4 w-4'}) }}
                                                <span class="hidden sm:inline">{{ (revision ? 'agenda.upload_revision' : 'agenda.upload')|trans({}, 'dashboard') }}</span>
                                                <span class="sr-only sm:hidden">{{ (revision ? 'agenda.upload_revision' : 'agenda.upload')|trans({}, 'dashboard') }}</span>
                                            </button>
                                        </form>
                                {% endif %}
                            </li>
                        {% else %}
                            {{ quality.task_row(entry.task, true) }}
                        {% endif %}
                        {% if loop.last %}</ul>{% endif %}
                    {% endfor %}
                </div>
                {% if agenda.hidden > 0 %}
                    <p class="text-xs text-gray-500">{{ 'activities.agenda.more'|trans({'%count%': agenda.hidden}, 'dashboard') }}</p>
                {% endif %}
            {% else %}
                <div class="rounded-xl border border-forest-100 bg-forest-50 px-4 py-6 text-center">
                    {{ ux_icon('heroicons:check-badge', {class: 'mx-auto mb-2 h-8 w-8 text-forest-400'}) }}
                    <p class="text-sm font-medium text-forest-700">{{ 'activities.all_done'|trans({}, 'dashboard') }}</p>
                    {% if summary.nextUpcoming %}
                        <p class="mt-1 text-xs text-forest-600">
                            {{ 'activities.next_upcoming'|trans({
                                '%title%': summary.nextUpcoming.activity.title,
                                '%date%': summary.nextUpcoming.startsAt|date('d/m/Y'),
                            }, 'dashboard') }}
                        </p>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
