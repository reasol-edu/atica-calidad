{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'reports'|trans({}, 'navigation') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% macro report_card(icon, key, route, centre, description, summary, summary_class) %}
    <div class="flex flex-col rounded-2xl border border-gray-200 bg-white shadow-xs">
        <div class="flex-1 px-6 py-5 space-y-2">
            <h2 class="flex items-center gap-2 text-base font-semibold text-gray-900">
                {{ ux_icon(icon, {class: 'h-5 w-5 text-forest-600'}) }}
                {{ (key ~ '.title')|trans({}, 'reports') }}
            </h2>
            <p class="text-sm text-gray-600">{{ description }}</p>
            <p class="text-xs font-medium {{ summary_class ?? 'text-gray-500' }}">{{ summary }}</p>
        </div>
        <div class="flex items-center gap-2 border-t border-gray-100 px-6 py-3">
            <a href="{{ path(route, {centreId: centre.id.toRfc4122, _format: 'pdf'}) }}" target="_blank" rel="noopener"
               class="inline-flex items-center gap-1.5 rounded-lg bg-forest-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-forest-700 transition-colors">
                {{ ux_icon('heroicons:document-text', {class: 'h-4 w-4'}) }}
                {{ 'download_pdf'|trans({}, 'reports') }}
            </a>
            <a href="{{ path(route, {centreId: centre.id.toRfc4122, _format: 'xlsx'}) }}"
               class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                {{ ux_icon('heroicons:table-cells', {class: 'h-4 w-4'}) }}
                {{ 'download_xlsx'|trans({}, 'reports') }}
            </a>
        </div>
    </div>
{% endmacro %}

{% block content %}
<div class="px-6 py-8 max-w-7xl mx-auto">

    <div class="mb-8">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <span aria-current="page" class="text-gray-700 font-medium">{{ 'reports'|trans({}, 'navigation') }}</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'reports'|trans({}, 'navigation') }}</h1>
        <p class="mt-1 text-sm text-gray-500">{{ 'intro'|trans({}, 'reports') }}</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {{ _self.report_card(
            'heroicons:clipboard-document-list', 'master_list', 'app_reports_master_list', centre,
            'master_list.description'|trans({}, 'reports'),
            'master_list.summary'|trans({'%count%': documentCount}, 'reports'),
        ) }}

        {{ _self.report_card(
            'heroicons:calendar-days', 'document_reviews', 'app_reports_document_reviews', centre,
            'document_reviews.description'|trans({'%days%': reviewHorizon}, 'reports'),
            'document_reviews.summary'|trans({'%count%': reviewsDueCount}, 'reports') ~ (reviewsOverdue > 0 ? 'document_reviews.overdue'|trans({'%count%': reviewsOverdue}, 'reports') : (reviewsDueCount > 0 ? '.' : '')),
            reviewsOverdue > 0 ? 'text-red-600' : null,
        ) }}

        {{ _self.report_card(
            'heroicons:check-circle', 'activity_status', 'app_reports_activity_status', centre,
            'activity_status.description'|trans({}, 'reports'),
            'activity_status.summary'|trans({'%count%': activityCount}, 'reports'),
        ) }}

        {% set open_findings = (findingCounts.reported ?? 0) + (findingCounts.analysis ?? 0) + (findingCounts.execution ?? 0) + (findingCounts.verification ?? 0) %}
        {{ _self.report_card(
            'heroicons:arrow-trending-up', 'findings', 'app_reports_findings', centre,
            'findings.description'|trans({}, 'reports'),
            'findings.summary'|trans({'%count%': open_findings, '%closed%': findingCounts.closed ?? 0}, 'reports'),
        ) }}

        {{ _self.report_card(
            'heroicons:rocket-launch', 'improvement_plan', 'app_reports_improvement_plan', centre,
            'improvement_plan.description'|trans({}, 'reports'),
            'improvement_plan.summary'|trans({'%count%': planActions|length, '%done%': planActions|filter(a => a.done)|length}, 'reports'),
        ) }}

        {% set indicator_rows = indicatorGroups|reduce((all, rows) => all|merge(rows), []) %}
        {{ _self.report_card(
            'heroicons:chart-bar', 'indicators', 'app_reports_indicators', centre,
            'indicators.description'|trans({}, 'reports'),
            'indicators.summary'|trans({'%count%': indicator_rows|length, '%off%': indicator_rows|filter(r => r.status and r.status.value == 'off_target')|length}, 'reports'),
            (indicator_rows|filter(r => r.status and r.status.value == 'off_target')|length) > 0 ? 'text-red-600' : null,
        ) }}

        {{ _self.report_card(
            'heroicons:check-badge', 'read_acknowledgements', 'app_reports_read_acknowledgements', centre,
            'read_acknowledgements.description'|trans({}, 'reports'),
            'read_acknowledgements.summary'|trans({'%count%': readAckCount}, 'reports'),
        ) }}
    </div>

</div>
{% endblock %}
