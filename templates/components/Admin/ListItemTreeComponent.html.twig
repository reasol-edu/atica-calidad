<div {{ attributes }} class="js-list-item-tree space-y-3">
    {% set visible      = this.visibleItems %}
    {% set breadcrumb   = this.breadcrumb %}
    {% set sel          = this.selected %}
    {% set display_tags = this.displayTags %}
    {% set existing_tag_names = this.existingTagNames %}

    {# ── Breadcrumbs ──────────────────────────────────────────────────── #}
    <nav class="flex flex-wrap items-center gap-1 text-sm">
        <button type="button" data-action="live#action" data-live-action-param="openLevel" data-live-id-param=""
                class="inline-flex items-center gap-1 rounded-md px-2 py-1 font-medium
                       {{ currentParentId == '' ? 'bg-forest-50 text-forest-700' : 'text-gray-500 hover:bg-gray-100' }}">
            {{ ux_icon('heroicons:home', {class: 'h-4 w-4'}) }}
            {{ 'responsibilities.lists.root'|trans({}, 'admin') }}
        </button>
        {% for crumb in breadcrumb %}
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 text-gray-300 shrink-0'}) }}
            <button type="button" data-action="live#action" data-live-action-param="openLevel" data-live-id-param="{{ crumb.id }}"
                    class="rounded-md px-2 py-1 font-medium
                           {{ currentParentId == crumb.id.toRfc4122 ? 'bg-forest-50 text-forest-700' : 'text-gray-500 hover:bg-gray-100' }}">
                {{ crumb.name }}
            </button>
        {% endfor %}
    </nav>

    {# ── Current level ────────────────────────────────────────────────── #}
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
        <div class="flex items-center gap-2 bg-gray-50/70 px-4 py-2.5 border-b border-gray-100">
            {{ ux_icon('heroicons:rectangle-group', {class: 'h-4 w-4 text-gray-400'}) }}
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                {{ breadcrumb is empty ? 'responsibilities.lists.col.roots'|trans({}, 'admin') : 'responsibilities.lists.col.children'|trans({}, 'admin') }}
            </span>
            {% if visible|length > 1 %}
                <button type="button" data-action="live#action" data-live-action-param="sortAlphabetically"
                        class="ml-auto shrink-0 inline-flex items-center justify-center rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors"
                        title="{{ 'responsibilities.lists.sort_alphabetically'|trans({}, 'admin') }}">
                    {{ ux_icon('heroicons:bars-arrow-down', {class: 'h-4 w-4'}) }}
                </button>
            {% endif %}
            <span class="{{ visible|length > 1 ? '' : 'ml-auto' }} text-xs text-gray-400">{{ visible|length }}</span>
        </div>

        {% if visible is empty %}
            <p class="px-4 py-6 text-center text-xs italic text-gray-400">{{ 'responsibilities.lists.items.empty'|trans({}, 'admin') }}</p>
        {% else %}
            <ul class="divide-y divide-gray-50">
                {% for item in visible %}
                    {% set is_sel = selectedId == item.id.toRfc4122 %}
                    <li class="flex items-center">
                        <button type="button"
                                data-action="live#action"
                                data-live-action-param="selectItem"
                                data-live-id-param="{{ item.id }}"
                                class="flex flex-1 items-center gap-2 px-4 py-2.5 text-left transition-colors min-w-0
                                       {{ is_sel ? 'bg-forest-50 ring-1 ring-inset ring-forest-200' : 'hover:bg-gray-50' }}">
                            <span class="flex-1 min-w-0 truncate text-sm {{ is_sel ? 'font-semibold text-forest-800' : 'text-gray-800' }}">
                                {{ item.name }}
                            </span>
                            {% if not item.active %}
                                <span title="{{ 'responsibilities.lists.inactive'|trans({}, 'admin') }}"
                                      class="shrink-0 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-400">
                                    {{ ux_icon('heroicons:eye-slash', {class: 'h-3 w-3'}) }}
                                </span>
                            {% endif %}
                            {% if item.children|length > 0 %}
                                <span class="shrink-0 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">
                                    {{ item.children|length }}
                                </span>
                            {% endif %}
                        </button>
                        <button type="button"
                                data-action="live#action"
                                data-live-action-param="openLevel"
                                data-live-id-param="{{ item.id }}"
                                title="{{ 'responsibilities.lists.action.open'|trans({}, 'admin') }}"
                                class="shrink-0 inline-flex items-center justify-center p-2.5 text-gray-300 hover:text-forest-500 transition-colors">
                            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
                        </button>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <form data-action="submit->live#action:prevent"
              data-live-action-param="addItem"
              class="flex items-center gap-2 border-t border-gray-100 bg-gray-50/40 px-3 py-2.5">
            <input type="text"
                   data-model="norender|addName"
                   value="{{ addName }}"
                   placeholder="{{ 'responsibilities.lists.field.name_placeholder'|trans({}, 'admin') }}"
                   class="min-w-0 flex-1 rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-sm
                          placeholder-gray-400 focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-500/20">
            <button type="submit"
                    class="inline-flex shrink-0 items-center justify-center rounded-lg bg-forest-600 p-1.5 text-white
                           hover:bg-forest-700 transition-colors"
                    title="{{ 'responsibilities.lists.add'|trans({}, 'admin') }}">
                {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
            </button>
        </form>
        {% if errors.add is defined %}<p class="px-3 pb-2 text-xs text-red-600">{{ errors.add }}</p>{% endif %}
    </div>

    {# ── Detail of the selected item ──────────────────────────────────── #}
    {% if sel %}
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
            <div class="flex items-center gap-2 bg-gray-50/70 px-4 py-2.5 border-b border-gray-100">
                {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4 text-gray-400'}) }}
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">{{ 'responsibilities.lists.detail.title'|trans({}, 'admin') }}</span>
            </div>

            <div class="px-4 py-4 sm:px-6 space-y-4">
                <form data-action="submit->live#action:prevent" data-live-action-param="saveDetail"
                      class="grid grid-cols-1 gap-3 sm:grid-cols-3">

                    <div class="sm:col-span-2">
                        <label class="mb-1 block text-xs font-medium text-gray-600">{{ 'responsibilities.lists.field.name'|trans({}, 'admin') }}</label>
                        <input type="text"
                               data-model="norender|editName"
                               value="{{ editName }}"
                               class="block w-full rounded-lg border bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2
                                      {{ errors.name is defined ? 'border-red-300 focus:ring-red-400/20' : 'border-gray-200 focus:border-forest-500 focus:ring-forest-500/20' }}">
                        {% if errors.name is defined %}<p class="mt-1 text-xs text-red-600">{{ errors.name }}</p>{% endif %}
                    </div>

                    <div class="flex items-end gap-2 sm:col-span-1">
                        <button type="button" data-action="live#action" data-live-action-param="moveUp" data-live-id-param="{{ sel.id }}"
                                class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white p-2 text-gray-500 hover:bg-gray-50 transition-colors"
                                title="{{ 'responsibilities.lists.detail.move_up'|trans({}, 'admin') }}">
                            {{ ux_icon('heroicons:chevron-up', {class: 'h-4 w-4'}) }}
                        </button>
                        <button type="button" data-action="live#action" data-live-action-param="moveDown" data-live-id-param="{{ sel.id }}"
                                class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white p-2 text-gray-500 hover:bg-gray-50 transition-colors"
                                title="{{ 'responsibilities.lists.detail.move_down'|trans({}, 'admin') }}">
                            {{ ux_icon('heroicons:chevron-down', {class: 'h-4 w-4'}) }}
                        </button>
                    </div>

                    <div class="sm:col-span-3">
                        <span class="mb-2 block text-xs font-medium text-gray-600">{{ 'responsibilities.lists.field.active'|trans({}, 'admin') }}</span>
                        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                            <twig:Form:RadioCard
                                name="list_item_active"
                                value="1"
                                label="{{ 'responsibilities.lists.field.active_yes'|trans({}, 'admin') }}"
                                help="{{ 'responsibilities.lists.field.active_yes_help'|trans({}, 'admin') }}"
                                :checked="editActive"
                                data-model="editActive"
                            />
                            <twig:Form:RadioCard
                                name="list_item_active"
                                value="0"
                                label="{{ 'responsibilities.lists.field.active_no'|trans({}, 'admin') }}"
                                help="{{ 'responsibilities.lists.field.active_no_help'|trans({}, 'admin') }}"
                                :checked="not editActive"
                                data-model="editActive"
                            />
                        </div>
                    </div>

                    <div class="sm:col-span-3">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-4 py-2 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                            {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}{{ 'responsibilities.lists.detail.save'|trans({}, 'admin') }}
                        </button>
                    </div>
                </form>

                {# ── Associated with a profile/subprofile ─────────────────── #}
                {% set association_rows = this.associationRows %}
                <div class="border-t border-gray-100 pt-4">
                    <label class="mb-1 block text-xs font-medium text-gray-600">{{ 'responsibilities.lists.association.title'|trans({}, 'admin') }}</label>
                    <p class="mb-2 text-xs text-gray-400">{{ 'responsibilities.lists.association.help'|trans({}, 'admin') }}</p>

                    {% if association_rows is empty %}
                        <p class="text-xs italic text-gray-400">{{ 'responsibilities.lists.association.empty'|trans({}, 'admin') }}</p>
                    {% else %}
                        <form data-action="submit->live#action:prevent" data-live-action-param="saveAssociation"
                              class="flex flex-wrap items-center gap-2">
                            {# TomSelect builds its own sibling DOM (.ts-wrapper) next to this <select>. The
                               LiveComponent re-render that follows every selectItem morphs this panel in place and
                               strips that sibling — after the first item, the picker becomes an invisible, dead
                               control (only the first item stays editable). data-live-ignore keeps the widget intact
                               across same-item re-renders; the id keyed on sel.id forces a real teardown/rebuild
                               (Stimulus disconnect -> TomSelect.destroy, then connect) whenever a different item is
                               selected, so its own options/value load fresh. #}
                            <div id="assoc-picker-{{ sel.id.toRfc4122 }}" data-live-ignore class="min-w-0 flex-1">
                                <select data-controller="tom-select"
                                        data-tom-select-placeholder-value="{{ 'responsibilities.lists.association.picker_placeholder'|trans({}, 'admin') }}"
                                        data-tom-select-no-results-value="{{ 'responsibilities.lists.association.picker_no_results'|trans({}, 'admin') }}"
                                        data-model="norender|associationKey"
                                        class="w-full text-sm ts-local">
                                    <option value="">{{ 'responsibilities.lists.association.none_option'|trans({}, 'admin') }}</option>
                                    {% for row in association_rows %}
                                        <option value="{{ row.key }}" {{ row.key == associationKey ? 'selected' : '' }}>{{ row.displayName }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button type="submit"
                                    class="shrink-0 rounded-lg bg-forest-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-forest-700 transition-colors">
                                {{ 'responsibilities.lists.association.save'|trans({}, 'admin') }}
                            </button>
                        </form>
                    {% endif %}
                </div>

                {# ── Tags (outside the previous form: a <form> can't nest another) ── #}
                <div class="border-t border-gray-100 pt-4">
                    <label class="mb-1 block text-xs font-medium text-gray-600">{{ 'responsibilities.lists.tags.title'|trans({}, 'admin') }}</label>

                    {% if display_tags is empty %}
                        <p class="text-xs italic text-gray-400">{{ 'responsibilities.lists.tags.empty'|trans({}, 'admin') }}</p>
                    {% else %}
                        <div class="mb-2 flex flex-wrap gap-1.5">
                            {% for row in display_tags %}
                                {% if row.inherited %}
                                    <span title="{{ 'responsibilities.lists.tags.inherited_hint'|trans({}, 'admin') }}"
                                          class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2.5 py-1 text-xs text-gray-500">
                                        {{ ux_icon('heroicons:tag', {class: 'h-3 w-3'}) }}
                                        {{ row.tag.name }}
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-violet-50 px-2.5 py-1 text-xs text-violet-700">
                                        {{ ux_icon('heroicons:tag', {class: 'h-3 w-3'}) }}
                                        {{ row.tag.name }}
                                        <button type="button" data-action="live#action"
                                                data-live-action-param="removeTag" data-live-tag-id-param="{{ row.tag.id }}"
                                                class="ml-0.5 shrink-0 text-violet-400 hover:text-violet-700">
                                            {{ ux_icon('heroicons:x-mark', {class: 'h-3 w-3'}) }}
                                        </button>
                                    </span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}

                    <datalist id="existing-tag-names">
                        {% for name in existing_tag_names %}<option value="{{ name }}">{% endfor %}
                    </datalist>
                    <form data-action="submit->live#action:prevent" data-live-action-param="addTag"
                          class="flex items-center gap-2">
                        <input type="text"
                               list="existing-tag-names"
                               data-model="norender|newTagName"
                               value="{{ newTagName }}"
                               placeholder="{{ 'responsibilities.lists.tags.add_placeholder'|trans({}, 'admin') }}"
                               class="min-w-0 flex-1 rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-sm
                                      placeholder-gray-400 focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-500/20">
                        <button type="submit"
                                class="inline-flex shrink-0 items-center justify-center rounded-lg bg-forest-600 p-1.5 text-white
                                       hover:bg-forest-700 transition-colors"
                                title="{{ 'responsibilities.lists.tags.add'|trans({}, 'admin') }}">
                            {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
                        </button>
                    </form>
                </div>

                {# ── Save / delete ────────────────────────────────────── #}
                <div class="flex flex-wrap items-center gap-2 border-t border-gray-100 pt-4">
                    <span class="ml-auto"></span>

                    {% if errors.delete is defined %}
                        <span class="text-xs text-red-600">{{ errors.delete }}</span>
                    {% elseif confirmingDelete %}
                        <span class="text-xs text-gray-600">{{ 'responsibilities.lists.delete_confirm'|trans({}, 'admin') }}</span>
                        <button type="button" data-action="live#action" data-live-action-param="deleteSelected"
                                class="inline-flex items-center gap-1.5 rounded-xl bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-700 transition-colors">
                            {{ 'responsibilities.lists.detail.confirm_yes'|trans({}, 'admin') }}
                        </button>
                        <button type="button" data-action="live#action" data-live-action-param="cancelDelete"
                                class="inline-flex items-center rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                            {{ 'responsibilities.lists.detail.cancel'|trans({}, 'admin') }}
                        </button>
                    {% else %}
                        <button type="button" data-action="live#action" data-live-action-param="askDelete"
                                class="inline-flex items-center gap-1.5 rounded-xl border border-red-200 bg-white px-3 py-2 text-sm font-medium text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors">
                            {{ ux_icon('heroicons:trash', {class: 'h-4 w-4'}) }}{{ 'responsibilities.lists.detail.delete'|trans({}, 'admin') }}
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
</div>
