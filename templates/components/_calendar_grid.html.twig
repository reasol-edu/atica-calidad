{# Monthly calendar grid (navigation, day-of-week header, weeks and segments),
   included by CalendarComponent so it can call the component's
   this.isToday()/this.isCurrentMonth()/etc. #}
<div {{ attributes.defaults({class: 'rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden'}) }}>

    {# ── Navigation ───────────────────────────────────────────────────────── #}
    <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100">
        <button data-action="live#action" data-live-action-param="previousMonth"
                class="flex h-11 w-11 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 transition-colors sm:h-auto sm:w-auto sm:p-1.5"
                aria-label="{{ 'prev_month'|trans({}, 'calendar') }}">
            {{ ux_icon('heroicons:chevron-left', {class: 'h-4 w-4'}) }}
        </button>
        <h2 class="flex-1 text-center text-sm font-semibold text-gray-800">
            {{ this.monthLabel }}
        </h2>
        <button data-action="live#action" data-live-action-param="nextMonth"
                class="flex h-11 w-11 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 transition-colors sm:h-auto sm:w-auto sm:p-1.5"
                aria-label="{{ 'next_month'|trans({}, 'calendar') }}">
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
        </button>
        <button data-action="live#action" data-live-action-param="goToday"
                class="rounded-lg border border-gray-200 px-3 py-3.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors sm:px-2.5 sm:py-1">
            {{ 'today'|trans({}, 'calendar') }}
        </button>
    </div>

    {# ── Day-of-week headers (school days only: no Saturday or Sunday) ──────── #}
    <div class="grid grid-cols-5 border-b border-gray-100 bg-gray-50 max-md:hidden">
        {% for key in ['lun', 'mar', 'mie', 'jue', 'vie'] %}
            <div class="py-2 text-center text-xs font-medium text-gray-500">
                {{ key|trans({}, 'calendar') }}
            </div>
        {% endfor %}
    </div>

    {# ── Weeks ────────────────────────────────────────────────────────────── #}
    {# ── Phone: the day-by-day list of the same entries. Five columns of ~70 px cannot hold a title. ── #}
    <div data-loading="addClass(opacity-50 pointer-events-none animate-pulse)" class="transition-opacity md:hidden">
        {% set agenda = this.agendaDays %}
        {% if this.weeks is empty %}
            <div class="py-12 text-center text-sm text-gray-400">{{ 'no_active_year'|trans({}, 'calendar') }}</div>
        {% elseif agenda is empty %}
            <div class="py-12 text-center text-sm text-gray-400">{{ 'agenda.empty'|trans({}, 'calendar') }}</div>
        {% else %}
            <div class="divide-y divide-gray-100">
                {% for entry_day in agenda %}
                    <section class="px-4 py-3 {{ this.isToday(entry_day.date) ? 'bg-forest-50' : '' }}">
                        <a href="{{ path('app_calendar_day', {date: entry_day.date.format('Y-m-d')}) }}"
                           class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-gray-800">
                            <span>{{ entry_day.date.format('j') }}</span>
                            <span class="text-xs font-medium uppercase tracking-wide text-gray-400">{{ ['lun', 'mar', 'mie', 'jue', 'vie'][entry_day.date.format('N') - 1]|trans({}, 'calendar') }}</span>
                            {% if this.isToday(entry_day.date) %}
                                <span class="rounded-full bg-forest-600 px-2 py-0.5 text-[10px] font-semibold text-white">{{ 'today'|trans({}, 'calendar') }}</span>
                            {% endif %}
                        </a>
                        <ul class="space-y-1.5">
                            {% for segment in entry_day.entries %}
                                <li class="flex items-start gap-2 rounded-md border border-l-[3px] px-2.5 py-1.5 text-xs leading-snug {{ segment.color.bg }} {{ segment.color.text }} {{ segment.color.border }} {{ segment.color.accent ?? '' }} {{ segment.muted ? 'opacity-60' : '' }}">
                                    {% if segment.icon is not empty %}
                                        {{ ux_icon(segment.icon, {class: 'mt-0.5 h-3.5 w-3.5 shrink-0'}) }}
                                    {% endif %}
                                    <span class="min-w-0">
                                        <span class="font-semibold {{ segment.muted ? 'line-through' : '' }}">{{ segment.long ? 'activity_due'|trans({'%title%': segment.label}, 'calendar') : segment.label }}</span>
                                        {% if segment.details is not empty %}
                                            <span class="opacity-80">{{ segment.details }}</span>
                                        {% endif %}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div data-loading="addClass(opacity-50 pointer-events-none animate-pulse)" class="transition-opacity max-md:hidden">
    {% if this.weeks is empty %}
        <div class="py-12 text-center text-sm text-gray-400">
            {{ 'no_active_year'|trans({}, 'calendar') }}
        </div>
    {% else %}
        {% for week in this.weeks %}
            <div class="border-b border-gray-100 last:border-b-0 min-h-24 transition-colors relative
                        {{ loop.index is even ? 'bg-gray-50' : 'bg-white' }}
                        hover:bg-forest-50">

                {# Full-height column separator lines, with a highlight on today's column #}
                <div class="absolute inset-0 grid grid-cols-5 divide-x divide-gray-100 pointer-events-none z-0"
                     aria-hidden="true">
                    {% for day in week.days %}
                        <div class="{{ this.isToday(day) ? 'bg-forest-50' : (this.isNonWorkingDay(day) ? 'bg-gray-100' : '') }}"></div>
                    {% endfor %}
                </div>

                {# Full clickable cell: covers the whole day column so its detail can be
                   opened from any empty spot, below the day number (its own link)
                   and the segments (which keep their title on hover). #}
                <div class="absolute inset-0 grid grid-cols-5 z-[5]" aria-hidden="true">
                    {% for day in week.days %}
                        <a href="{{ path('app_calendar_day', {date: day.format('Y-m-d')}) }}"
                           class="block h-full w-full" tabindex="-1"></a>
                    {% endfor %}
                </div>

                {# Day numbers — top of each week row #}
                <div class="relative z-10 grid grid-cols-5">
                    {% for day in week.days %}
                        {% set nonWorking = this.isNonWorkingDay(day) %}
                        <a href="{{ path('app_calendar_day', {date: day.format('Y-m-d')}) }}"
                           class="block py-1 px-1.5 text-right text-xs hover:font-semibold transition-colors
                                    {{ this.isCurrentMonth(day) ? 'text-gray-600' : 'text-gray-300' }}
                                    {{ nonWorking ? 'line-through decoration-gray-300' : '' }}"
                             {% if nonWorking %}title="{{ this.nonWorkingDayDescription(day) ?? 'non_working_day'|trans({}, 'calendar') }}"{% endif %}>
                            {% if this.isToday(day) %}
                                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-forest-600 text-white text-xs font-bold">
                                    {{ day.format('j') }}
                                </span>
                            {% else %}
                                {{ day.format('j') }}
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>

                {% if week.segments is not empty %}
                    <div class="relative z-10 grid grid-cols-5 gap-x-1 gap-y-1 px-1 pb-1 pointer-events-none"
                         style="grid-template-rows: repeat({{ week.maxLane + 1 }}, minmax(1.25rem, auto));">
                        {% for segment in week.segments %}
                            {% if segment.long and segment.continues %}
                                {# A window open for weeks, and not due yet in this one: a thin track that says it is still
                                   open, not the same labelled bar on every row (the label is on the week it falls due). #}
                                <div class="pointer-events-auto self-center h-2 rounded-full border {{ segment.color.bg }} {{ segment.color.border }} {{ segment.muted ? 'opacity-60' : '' }}"
                                     style="grid-column: {{ segment.startCol + 1 }} / span {{ segment.span }}; grid-row: {{ segment.lane + 1 }};"
                                     title="{{ segment.label }}"></div>
                            {% else %}
                            <div class="pointer-events-auto flex items-center gap-1 truncate rounded-md border border-l-[3px] px-1.5 py-0.5 text-[11px] leading-tight {{ segment.color.bg }} {{ segment.color.text }} {{ segment.color.border }} {{ segment.color.accent ?? '' }} {{ segment.muted ? 'opacity-60' : '' }}"
                                 style="grid-column: {{ segment.startCol + 1 }} / span {{ segment.span }}; grid-row: {{ segment.lane + 1 }};"
                                 title="{{ segment.details is not empty ? segment.label ~ ' — ' ~ segment.details : segment.label }}">
                                {% if segment.icon is not empty %}
                                    {{ ux_icon(segment.icon, {class: 'h-3 w-3 shrink-0'}) }}
                                {% endif %}
                                <span class="truncate">
                                    <span class="font-semibold {{ segment.muted ? 'line-through' : '' }}">{{ segment.long ? 'activity_due'|trans({'%title%': segment.label}, 'calendar') : segment.label }}</span>
                                    {% if segment.details is not empty %}
                                        <span class="opacity-80">{{ segment.details }}</span>
                                    {% endif %}
                                </span>
                            </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="relative z-10 min-h-2 pointer-events-none"></div>
                {% endif %}

            </div>
        {% endfor %}
    {% endif %}
    </div>

</div>
