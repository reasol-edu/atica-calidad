{% extends 'layouts/app.html.twig' %}

{% block title %}{{ calendar.name }} · {{ 'calendar.title'|trans({}, 'quality') }} · {{ app_name }}{% endblock %}

{#
   A measurement calendar: its name and periods (name and dates), kept in order of start date.
   Two blank rows add periods; ticking "Quitar" removes one — with its values, hence the warning.
#}
{% block content %}
{% set cell = 'w-full rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-sm text-gray-900 focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20 disabled:bg-gray-50' %}
{% set cid = calendar.id.toRfc4122 %}
<div class="px-4 sm:px-6 py-8 max-w-4xl mx-auto space-y-6">

    <div>
        <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-1">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_quality_indicators') }}" class="hover:text-forest-600 transition-colors">{{ 'indicator.title'|trans({}, 'quality') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
            <a href="{{ path('app_quality_calendars') }}" class="hover:text-forest-600 transition-colors">{{ 'calendar.title'|trans({}, 'quality') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ calendar.name }} <span class="font-normal text-gray-500">{{ calendar.academicYear.name }}</span></h1>
        {% if usage is not empty %}
            <p class="mt-1 text-sm text-gray-500">{{ 'calendar.used_by_list'|trans({'%names%': usage|map(i => i.name)|join(', ')}, 'quality') }}</p>
        {% endif %}
    </div>

    <form method="post" class="space-y-5 rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-xs">
        <input type="hidden" name="_token" value="{{ csrf_token('quality_calendar_' ~ cid) }}">

        <div class="space-y-1.5 max-w-sm">
            <label for="cal-name" class="block text-sm font-semibold text-gray-900">{{ 'calendar.name'|trans({}, 'quality') }}</label>
            <input id="cal-name" name="name" value="{{ name }}" required maxlength="100" {{ writable ? '' : 'disabled' }} class="{{ cell }} {{ errors.name is defined ? 'border-red-300' : '' }}">
            {% if errors.name is defined %}<p class="text-xs text-red-600">{{ errors.name }}</p>{% endif %}
        </div>

        <div class="overflow-x-auto">
            <table class="w-full min-w-[34rem] text-sm">
                <thead>
                    <tr class="text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                        <th class="pb-2 pr-2 font-semibold">{{ 'calendar.period'|trans({}, 'quality') }}</th>
                        <th class="pb-2 pr-2 font-semibold">{{ 'calendar.start'|trans({}, 'quality') }}</th>
                        <th class="pb-2 pr-2 font-semibold">{{ 'calendar.end'|trans({}, 'quality') }}</th>
                        {% if writable %}<th class="pb-2 font-semibold">{{ 'calendar.remove'|trans({}, 'quality') }}</th>{% endif %}
                    </tr>
                </thead>
                <tbody class="align-top">
                    {% set blank = {id: '', name: '', start: '', end: ''} %}
                    {% for r in writable ? rows|merge([blank, blank]) : rows %}
                        <tr>
                            <td class="py-1 pr-2">
                                <input type="hidden" name="periods[{{ loop.index0 }}][id]" value="{{ r.id }}">
                                <input name="periods[{{ loop.index0 }}][name]" value="{{ r.name }}" maxlength="100" {{ writable ? '' : 'disabled' }}
                                       aria-label="{{ 'calendar.period'|trans({}, 'quality') }}" placeholder="{{ r.id ? '' : 'calendar.new_period'|trans({}, 'quality') }}" class="{{ cell }}">
                            </td>
                            <td class="py-1 pr-2"><input type="date" name="periods[{{ loop.index0 }}][start]" value="{{ r.start }}" {{ writable ? '' : 'disabled' }} aria-label="{{ 'calendar.start'|trans({}, 'quality') }}" class="{{ cell }}"></td>
                            <td class="py-1 pr-2"><input type="date" name="periods[{{ loop.index0 }}][end]" value="{{ r.end }}" {{ writable ? '' : 'disabled' }} aria-label="{{ 'calendar.end'|trans({}, 'quality') }}" class="{{ cell }}"></td>
                            {% if writable %}
                                <td class="py-1 text-center">
                                    {% if r.id %}<input type="checkbox" name="periods[{{ loop.index0 }}][remove]" value="1" aria-label="{{ 'calendar.remove'|trans({}, 'quality') }} {{ r.name }}" class="mt-2 rounded text-red-600 focus:ring-red-500">{% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if errors.periods is defined %}<p class="text-xs text-red-600">{{ errors.periods }}</p>{% endif %}
        {% if writable %}
            <p class="text-xs text-gray-500">{{ 'calendar.edit_help'|trans({}, 'quality') }}</p>
            <div class="flex flex-wrap items-center justify-between gap-3">
                <details>
                    <summary class="cursor-pointer list-none text-sm font-medium text-red-700 hover:text-red-800 [&::-webkit-details-marker]:hidden">{{ 'calendar.delete'|trans({}, 'quality') }}</summary>
                    <p class="mt-2 max-w-sm text-xs text-gray-600">{{ (usage is empty ? 'calendar.delete_confirm' : 'calendar.error.in_use')|trans({}, 'quality') }}</p>
                    {% if usage is empty %}
                        <button type="submit" form="delete-calendar" class="mt-2 rounded-lg bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-700">{{ 'calendar.delete_submit'|trans({}, 'quality') }}</button>
                    {% endif %}
                </details>
                <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700">
                    {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}{{ 'plan.save'|trans({}, 'quality') }}
                </button>
            </div>
        {% endif %}
    </form>
    {% if writable and usage is empty %}
        <form id="delete-calendar" method="post" action="{{ path('app_quality_calendar_delete', {id: cid}) }}" hidden>
            <input type="hidden" name="_token" value="{{ csrf_token('quality_calendar_' ~ cid) }}">
        </form>
    {% endif %}
</div>
{% endblock %}
