{% extends 'layouts/app.html.twig' %}

{% block title %}{{ title }} · {{ app_name }}{% endblock %}

{# One slot of an activity delivered by filling a model in: the form while there is a draft, the delivered document otherwise. #}
{% block content %}
<div class="px-4 sm:px-6 py-6 max-w-4xl mx-auto">
    <div class="mb-4">
        <a href="{{ backUrl }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-forest-600">
            {{ ux_icon('heroicons:arrow-left', {class: 'h-4 w-4'}) }}{{ activity.title }}
        </a>
        <h1 class="mt-1 break-words text-2xl font-bold text-gray-900">{{ title }}</h1>
        <p class="text-sm text-gray-500">{{ submission.modelRevision.code ?: submission.activity.formModel.document.name }} · REV {{ submission.modelRevision.revision.version }}</p>
    </div>

    {% if window.blocked %}
        <p class="mb-4 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">{{ (window.reason.value == 'before_start' ? 'fill.error.before_start' : 'fill.error.after_end')|trans({}, 'forms') }}</p>
    {% endif %}

    {% if editor is defined and lockedBy is not null %}
        {# Somebody else is editing this draft: one person at a time. #}
        <div class="mb-4 flex flex-wrap items-center gap-3 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
            <span class="min-w-0 flex-1">{{ 'fill.locked_banner'|trans({'%name%': lockedBy.name.firstName ~ ' ' ~ lockedBy.name.lastName, '%time%': lockedUntil|date('H:i')}, 'forms') }}</span>
            <form method="post" action="{{ path('app_form_take', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}" class="js-confirm-form"
                  data-confirm="{{ 'fill.confirm_take'|trans({}, 'forms')|e('html_attr') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('form_take_' ~ submission.id.toRfc4122) }}">
                <button type="submit" class="js-confirm-trigger rounded-lg border border-amber-300 bg-white px-3 py-1.5 font-medium hover:bg-amber-100">{{ 'fill.take_over'|trans({}, 'forms') }}</button>
            </form>
        </div>
    {% endif %}

    {% if update is defined and update is not null and canEdit %}
        {# A newer revision of the model is in force: update (it keeps what still fits) or keep working on the old one, unless it is mandatory. #}
        <div class="mb-4 rounded-xl border px-4 py-3 text-sm {{ update.required ? 'border-red-200 bg-red-50 text-red-800' : 'border-sky-200 bg-sky-50 text-sky-900' }}" data-testid="update-banner">
            <p class="font-medium">{{ (update.required ? 'fill.update_required' : (update.mandatory ? 'fill.update_mandatory' : 'fill.update_available'))|trans({'%version%': update.version, '%date%': update.deadline ? update.deadline|date('d/m/Y') : ''}, 'forms') }}</p>
            {% if update.lost is not empty %}
                <p class="mt-1">{{ 'fill.update_lost'|trans({}, 'forms') }} {{ update.lost|join(', ') }}.</p>
            {% endif %}
            <form method="post" action="{{ path('app_form_update', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}" class="mt-2 js-confirm-form"
                  {% if update.lost is not empty %}data-confirm="{{ 'fill.confirm_update'|trans({'%fields%': update.lost|join(', ')}, 'forms')|e('html_attr') }}"{% endif %}>
                <input type="hidden" name="_token" value="{{ csrf_token('form_update_' ~ submission.id.toRfc4122) }}">
                <button type="submit" class="{{ update.lost is not empty ? 'js-confirm-trigger ' : '' }}rounded-lg bg-forest-600 px-3 py-1.5 font-semibold text-white hover:bg-forest-700">{{ 'fill.update'|trans({}, 'forms') }}</button>
            </form>
        </div>
    {% endif %}

    {% if editor is defined and prefill is defined and prefill is not null and canEdit %}
        <div class="mb-4 flex flex-wrap items-center gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 shadow-xs" data-testid="prefill-banner">
            <span class="min-w-0 flex-1">{{ ('fill.prefilled_' ~ prefill.kind)|trans({'%label%': prefill.label}, 'forms') }}</span>
            <form method="post" action="{{ path('app_form_prefill', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}" class="js-confirm-form" data-confirm="{{ 'fill.confirm_prefill'|trans({}, 'forms')|e('html_attr') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('form_prefill_' ~ submission.id.toRfc4122) }}">
                <button type="submit" class="js-confirm-trigger rounded-lg border border-gray-200 px-3 py-1.5 font-medium hover:bg-gray-50">{{ 'fill.prefill_again'|trans({}, 'forms') }}</button>
            </form>
            <form method="post" action="{{ path('app_form_scratch', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}" class="js-confirm-form" data-confirm="{{ 'fill.confirm_scratch'|trans({}, 'forms')|e('html_attr') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('form_scratch_' ~ submission.id.toRfc4122) }}">
                <button type="submit" class="js-confirm-trigger rounded-lg border border-gray-200 px-3 py-1.5 font-medium hover:bg-gray-50">{{ 'fill.start_scratch'|trans({}, 'forms') }}</button>
            </form>
        </div>
    {% endif %}

    {% if editor is defined %}
        {% set labels = {
            history: 'fill.history'|trans({}, 'forms'),
            history_empty: 'fill.history_empty'|trans({}, 'forms'),
            history_restore: 'fill.history_restore'|trans({}, 'forms'),
            history_loading: 'fill.history_loading'|trans({}, 'forms'),
            saving: 'fill.saving'|trans({}, 'forms'),
            saved: 'fill.saved'|trans({}, 'forms'),
            offline: 'fill.offline'|trans({}, 'forms'),
            recovered: 'fill.recovered'|trans({}, 'forms'),
            stale: 'fill.stale'|trans({}, 'forms'),
            add_row: 'fill.add_row'|trans({}, 'forms'),
            remove_row: 'fill.remove_row'|trans({}, 'forms'),
            edit_text: 'fill.edit_text'|trans({}, 'forms'),
            write_text: 'fill.write_text'|trans({}, 'forms'),
            choose: 'fill.choose'|trans({}, 'forms'),
            yes: 'view.yes'|trans({}, 'forms'),
            no: 'view.no'|trans({}, 'forms'),
            row: 'fill.row'|trans({}, 'forms'),
            pending: 'fill.pending'|trans({}, 'forms'),
            starter_modified: 'fill.starter_modified'|trans({}, 'forms'),
            progress: 'fill.progress'|trans({}, 'forms'),
            total: 'view.total'|trans({}, 'forms'),
            matrix_empty: 'fill.matrix_empty'|trans({}, 'forms'),
            add_copy: 'fill.add_copy'|trans({}, 'forms'),
            remove_copy: 'fill.remove_copy'|trans({}, 'forms'),
            confirm_remove_copy: 'fill.confirm_remove_copy'|trans({}, 'forms'),
            confirm_remove_rows: 'fill.confirm_remove_rows'|trans({}, 'forms'),
            counted_empty: 'fill.counted_empty'|trans({}, 'forms'),
            no_results: 'fill.no_results'|trans({}, 'forms'),
            err_min: 'fill.error.number_min'|trans({}, 'forms'),
            err_max: 'fill.error.number_max'|trans({}, 'forms'),
        } %}
        <div data-controller="form-fill"
             data-form-fill-config-value="{{ editor|json_encode|e('html_attr') }}"
             data-form-fill-labels-value="{{ labels|json_encode|e('html_attr') }}">
            <p class="mb-3 text-sm" role="status" aria-live="polite" data-form-fill-target="status"></p>
            <div class="rounded-2xl border border-gray-200 bg-white px-4 py-5 shadow-xs sm:px-6" data-form-fill-target="canvas"></div>

            <section class="mt-6 rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
                <h2 class="text-base font-semibold text-gray-900">{{ 'fill.deliver_title'|trans({}, 'forms') }}</h2>
                <div data-form-fill-target="problemsBox" class="{{ problems is empty ? 'hidden' : '' }}">
                    <p class="mt-1 text-sm font-medium text-amber-800">{{ 'fill.pending'|trans({}, 'forms') }}</p>
                    <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-amber-800" data-form-fill-target="problems">
                        {% for p in problems %}<li>{{ p.text }}</li>{% endfor %}
                    </ul>
                </div>
                <div data-form-fill-target="warningsBox" class="{{ warnings is empty ? 'hidden' : '' }}">
                    <p class="mt-3 text-sm font-medium text-gray-700">{{ 'fill.warnings_title'|trans({}, 'forms') }}</p>
                    <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-gray-600" data-form-fill-target="warnings">
                        {% for w in warnings %}<li>{{ w.text }}</li>{% endfor %}
                    </ul>
                </div>
                <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                    {# Opens in another tab; the controller saves what is typed first so the preview shows it. #}
                    <a href="{{ path('app_form_preview', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}" target="_blank" rel="noopener" data-action="click->form-fill#preview"
                       class="w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-gray-700 hover:bg-gray-50 sm:w-auto">{{ 'fill.preview'|trans({}, 'forms') }}</a>
                    {% if submission.document is not null or last is not null %}
                        <form method="post" action="{{ path('app_form_discard', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}" class="js-confirm-form"
                              data-confirm="{{ 'fill.confirm_discard'|trans({}, 'forms')|e('html_attr') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('form_discard_' ~ submission.id.toRfc4122) }}">
                            <button type="submit" class="js-confirm-trigger w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 sm:w-auto">{{ 'fill.discard'|trans({}, 'forms') }}</button>
                        </form>
                    {% endif %}
                    {% if canEdit %}
                        <form method="post" action="{{ path('app_form_deliver', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('form_deliver_' ~ submission.id.toRfc4122) }}">
                            <button type="submit" data-form-fill-target="deliver" class="w-full rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 sm:w-auto">{{ 'fill.deliver'|trans({}, 'forms') }}</button>
                        </form>
                    {% endif %}
                </div>
            </section>
        </div>
    {% elseif last is not null %}
        {% set revision = lastRevision %}
        <div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
            {% if revision.pendingReview %}<span class="rounded-full bg-amber-50 px-3 py-1 font-medium text-amber-800">{{ 'fill.status_pending'|trans({}, 'forms') }}</span>
            {% elseif revision.rejected %}<span class="rounded-full bg-red-50 px-3 py-1 font-medium text-red-700">{{ 'fill.status_rejected'|trans({}, 'forms') }}</span>
            {% else %}<span class="rounded-full bg-forest-50 px-3 py-1 font-medium text-forest-700">{{ 'fill.status_approved'|trans({}, 'forms') }}</span>{% endif %}
            <span class="text-gray-500">{{ 'fill.version'|trans({'%version%': revision.version}, 'forms') }}</span>
            <span class="flex-1"></span>
            <a href="{{ path('app_form_revision_view', {revisionId: revision.id.toRfc4122}) }}"
               class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 font-medium text-gray-700 hover:bg-gray-50">
                {{ ux_icon('heroicons:chat-bubble-left-right', {class: 'h-4 w-4'}) }}{{ 'review.open'|trans({}, 'forms') }}
            </a>
            <a href="{{ path('app_folder_document_revision_download', {folderId: folderId, documentId: documentId, revisionId: revision.id.toRfc4122}) }}"
               class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3 py-2 font-medium text-gray-700 hover:bg-gray-50">
                {{ ux_icon('heroicons:document-arrow-down', {class: 'h-4 w-4'}) }}PDF
            </a>
            {% if canEdit %}
                <form method="post" action="{{ path('app_form_correct', {activityId: activity.id.toRfc4122, slotKey: slot.key}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('form_correct_' ~ submission.id.toRfc4122) }}">
                    <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-3.5 py-2 font-semibold text-white hover:bg-forest-700">
                        {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4'}) }}{{ 'fill.correct'|trans({}, 'forms') }}
                    </button>
                </form>
            {% endif %}
        </div>
        <article class="rounded-2xl border border-gray-200 bg-white px-5 py-6 shadow-xs sm:px-8">
            {% include 'form/_document.html.twig' with {sections: sections, blank: false} only %}
        </article>
    {% endif %}
</div>
{% endblock %}
