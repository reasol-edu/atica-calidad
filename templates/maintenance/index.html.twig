<!DOCTYPE html>
{# Standalone like the error pages (templates/bundles/TwigBundle/Exception): it must render without the app layout, the compiled CSS or any session. #}
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'maintenance.title'|trans({}, 'security') }} · {{ app_name }}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('static/favicon.svg') }}">
    <link rel="shortcut icon" href="{{ asset('static/favicon.ico') }}">
    <style>
        @font-face {
            font-family: 'Inter';
            font-style: normal;
            font-weight: 300 700;
            font-display: swap;
            src: url('/static/fonts/inter-latin.woff2') format('woff2');
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }
        @font-face {
            font-family: 'Inter';
            font-style: normal;
            font-weight: 300 700;
            font-display: swap;
            src: url('/static/fonts/inter-latin-ext.woff2') format('woff2');
            unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --forest-300: #aec094;
            --forest-400: #8fab74;
            --forest-500: #6e8c63;
            --forest-600: #5a7550;
            --forest-700: #46603d;
            --forest-800: #374b2e;
            --forest-900: #2e3b27;
            --forest-950: #1a2415;
            --amber-400: #d69b3b;
            --amber-300: #e4b15c;
        }

        html, body { height: 100%; }

        body {
            font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
            background: var(--forest-950);
            color: white;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Rings and diamonds with parallax ────────────────────────────── */
        .orb {
            position: fixed;
            border-radius: 50%;
            background: transparent;
            pointer-events: none;
            will-change: transform;
        }
        .orb-a { width: 540px; height: 540px; top: -180px; right: -180px; border: 3px solid rgba(255,255,255,0.18); }
        .orb-b { width: 360px; height: 360px; top: -100px; right: -100px; border: 3px solid rgba(255,255,255,0.10); }
        .orb-c { width: 300px; height: 300px; top: 38%;    right: -80px;  border: 3px solid rgba(143,171,116,0.38); background: rgba(110,140,99,0.07); }
        .orb-d { width: 460px; height: 460px; bottom: -130px; left: -130px; border: 3px solid rgba(255,255,255,0.15); }
        .orb-e { width: 200px; height: 200px; bottom: 20%; left: -40px;   border: 3px solid rgba(174,192,148,0.30); }

        .diamond {
            position: fixed;
            pointer-events: none;
            will-change: transform;
        }
        .diamond-a { width: 64px; height: 64px; bottom: 13%; right: 7%;  background: rgba(110,140,99,0.13);   transform: rotate(45deg); }
        .diamond-b { width: 44px; height: 44px; bottom: 16%; right: 11%; background: rgba(255,255,255,0.07); transform: rotate(45deg); }
        .diamond-c { width: 30px; height: 30px; bottom: 10%; right: 9%;  background: rgba(174,192,148,0.11); transform: rotate(45deg); }
        .diamond-d { width: 48px; height: 48px; top: 10%; left: 6%;  background: rgba(255,255,255,0.06); transform: rotate(45deg); }
        .diamond-e { width: 32px; height: 32px; top: 13%; left: 9%;  background: rgba(110,140,99,0.11);   transform: rotate(45deg); }

        /* ── Content ──────────────────────────────────────────────────────── */
        .page {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 2rem 1.5rem;
        }

        /* ── Gears scene ──────────────────────────────────────────────────── */
        .gear-scene {
            position: relative;
            width: 200px;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Concentric ripple rings that pulse outward */
        .ring {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(214,155,59,0.28);
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            animation: ring-expand 3s ease-out infinite;
            pointer-events: none;
        }
        .ring:nth-child(1) { animation-delay: 0s; }
        .ring:nth-child(2) { animation-delay: 1s; }
        .ring:nth-child(3) { animation-delay: 2s; }

        @keyframes ring-expand {
            0%   { width:  80px; height:  80px; opacity: 0.9; }
            100% { width: 250px; height: 250px; opacity: 0;   }
        }

        .gears {
            position: relative;
            z-index: 10;
            width: 150px;
            height: 150px;
            filter: drop-shadow(0 0 14px rgba(214,155,59,0.22));
            will-change: transform;
            animation: gears-idle 6s ease-in-out infinite;
        }
        @keyframes gears-idle {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-6px); }
        }

        /* Two meshing gears turning in opposite directions; the small one turns faster. */
        .gear { transform-box: fill-box; transform-origin: center; }
        .gear-large { color: var(--amber-400); animation: spin 14s linear infinite; }
        .gear-small { color: var(--forest-400); animation: spin-back 9s linear infinite; }
        @keyframes spin      { to { transform: rotate(360deg);  } }
        @keyframes spin-back { to { transform: rotate(-360deg); } }

        .gear-glow {
            position: absolute;
            inset: -20px;
            border-radius: 50%;
            background: radial-gradient(circle at center, rgba(214,155,59,0.26) 0%, transparent 65%);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }

        /* ── Typography: same rhythm as the error pages ───────────────────── */
        .badge {
            margin-top: 0.5rem;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: var(--amber-400);
            text-transform: uppercase;
        }

        .title {
            margin-top: 0.75rem;
            font-size: clamp(1.4rem, 3.4vw, 1.9rem);
            font-weight: 700;
            letter-spacing: -0.02em;
            color: white;
        }

        .subtitle {
            margin-top: 0.75rem;
            font-size: 1rem;
            line-height: 1.65;
            color: var(--forest-400);
            max-width: 27rem;
        }

        /* Three dots that "work" under the text */
        .progress {
            margin-top: 1.75rem;
            display: flex;
            gap: 0.5rem;
        }
        .progress span {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: var(--amber-400);
            opacity: 0.25;
            animation: blink 1.4s ease-in-out infinite;
        }
        .progress span:nth-child(2) { animation-delay: 0.2s; }
        .progress span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes blink {
            0%, 80%, 100% { opacity: 0.25; transform: scale(1); }
            40%           { opacity: 1;    transform: scale(1.25); }
        }

        /* ── Actions ──────────────────────────────────────────────────────── */
        .actions {
            margin-top: 2.25rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            justify-content: center;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--forest-600);
            color: white;
            font-family: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: background 0.15s, transform 0.15s, box-shadow 0.2s;
        }
        .btn-primary:hover {
            background: var(--forest-700);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(90,117,80,0.4);
        }
        .btn-primary:active { transform: translateY(0); }

        .footer {
            margin-top: 3rem;
            font-size: 0.75rem;
            letter-spacing: 0.04em;
            color: var(--forest-500);
        }

        @media (prefers-reduced-motion: reduce) {
            .ring, .gears, .gear, .progress span { animation: none; }
            .progress span { opacity: 0.6; }
            .btn-primary:hover { transform: none; }
        }
    </style>
</head>
<body>
    <div class="orb orb-a" data-speed="30"></div>
    <div class="orb orb-b" data-speed="18"></div>
    <div class="orb orb-c" data-speed="50"></div>
    <div class="orb orb-d" data-speed="36"></div>
    <div class="orb orb-e" data-speed="62"></div>
    <div class="diamond diamond-a" data-speed="44"></div>
    <div class="diamond diamond-b" data-speed="55"></div>
    <div class="diamond diamond-c" data-speed="68"></div>
    <div class="diamond diamond-d" data-speed="40"></div>
    <div class="diamond diamond-e" data-speed="58"></div>

    <main class="page">
        <div class="gear-scene" id="gear-scene">
            <div class="ring"></div>
            <div class="ring"></div>
            <div class="ring"></div>
            <div class="gear-glow" id="gear-glow"></div>
            {# Gear teeth are the dashes of a thick dashed circle: 14 teeth on the large gear (circumference 2π·40 ≈ 251.3 = 14 × 17.95), 9 on the small one (2π·25 ≈ 157.1 = 9 × 17.45). #}
            <svg class="gears" id="gears" viewBox="0 0 132 132" fill="none" aria-hidden="true">
                <g class="gear gear-large">
                    <circle cx="52" cy="52" r="40" stroke="currentColor" stroke-width="9" stroke-dasharray="8.98 8.97" opacity="0.9"/>
                    <circle cx="52" cy="52" r="34" stroke="currentColor" stroke-width="3.5"/>
                    <circle cx="52" cy="52" r="12" stroke="currentColor" stroke-width="3.5"/>
                    <path d="M52 18v22M52 64v22M18 52h22M64 52h22" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.55"/>
                </g>
                <g class="gear gear-small">
                    <circle cx="97" cy="97" r="25" stroke="currentColor" stroke-width="8" stroke-dasharray="8.73 8.72" opacity="0.9"/>
                    <circle cx="97" cy="97" r="20" stroke="currentColor" stroke-width="3"/>
                    <circle cx="97" cy="97" r="7" stroke="currentColor" stroke-width="3"/>
                </g>
            </svg>
        </div>

        <p class="badge">{{ 'maintenance.badge'|trans({}, 'security') }}</p>
        <h1 class="title">{{ 'maintenance.title'|trans({}, 'security') }}</h1>
        <p class="subtitle">{{ 'maintenance.text'|trans({}, 'security') }}</p>

        <div class="progress" aria-hidden="true"><span></span><span></span><span></span></div>

        <div class="actions">
            {% if signed_in %}
                <a href="{{ path('app_logout') }}" class="btn-primary">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"/>
                    </svg>
                    {{ 'maintenance.logout'|trans({}, 'security') }}
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn-primary">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
                    </svg>
                    {{ 'maintenance.login'|trans({}, 'security') }}
                </a>
            {% endif %}
        </div>

        <p class="footer">{{ app_name }}{% if app_version %} · v{{ app_version }}{% endif %}</p>
    </main>

    <script>
    (function () {
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducedMotion) { return; }

        var els   = document.querySelectorAll('[data-speed]');
        var gears = document.getElementById('gears');
        var glow  = document.getElementById('gear-glow');
        var scene = document.getElementById('gear-scene');

        var tx = 0, ty = 0, cx = 0, cy = 0;
        var gx = 0, gy = 0, gcx = 0, gcy = 0;

        document.addEventListener('mousemove', function (e) {
            tx = e.clientX / window.innerWidth  - 0.5;
            ty = e.clientY / window.innerHeight - 0.5;

            // The gears lean slightly toward the cursor and light up when it is near.
            var rect  = scene.getBoundingClientRect();
            var dx    = e.clientX - (rect.left + rect.width  / 2);
            var dy    = e.clientY - (rect.top  + rect.height / 2);
            var dist  = Math.sqrt(dx * dx + dy * dy);
            var reach = 240;

            if (dist < reach) {
                var force = Math.pow(1 - dist / reach, 1.5) * 14;
                var ang   = Math.atan2(dy, dx);
                gx = Math.cos(ang) * force;
                gy = Math.sin(ang) * force;
                glow.style.opacity = (1 - dist / reach) * 0.9;
            } else {
                gx = 0; gy = 0;
                glow.style.opacity = 0;
            }
        });

        (function tick() {
            cx  += (tx - cx)  * 0.06;
            cy  += (ty - cy)  * 0.06;
            gcx += (gx - gcx) * 0.10;
            gcy += (gy - gcy) * 0.10;

            els.forEach(function (o) {
                var s = +o.dataset.speed;
                o.style.transform = 'translate(' + (cx * s).toFixed(1) + 'px,' + (cy * s).toFixed(1) + 'px)';
            });
            // The idle float is a CSS animation on the SVG; the lean goes on its wrapper-less parent glow scene.
            scene.style.transform = 'translate(' + gcx.toFixed(1) + 'px,' + gcy.toFixed(1) + 'px)';

            requestAnimationFrame(tick);
        }());
    }());
    </script>
</body>
</html>
