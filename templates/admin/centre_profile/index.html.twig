{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'centre_profiles.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 mx-auto">

    <div class="max-w-7xl mx-auto">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_centre_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'educational_centre'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'centre_profiles.title'|trans({}, 'admin') }}</h1>
        <p class="mt-1 text-sm text-gray-500">{{ 'centre_profiles.help'|trans({}, 'admin') }}</p>
    </div>

    {# ── Pestañas ─────────────────────────────────────────────────────── #}
    <nav class="max-w-7xl mx-auto mt-4 flex gap-6 border-b border-gray-200" aria-label="{{ 'centre_profiles.tabs.aria'|trans({}, 'admin') }}">
        <a href="{{ path('app_centre_profiles_index', {centreId: centre.id, tab: 'global'}) }}"
           {% if tab == 'global' %}aria-current="page"{% endif %}
           class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
                  {{ tab == 'global' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
            {{ ux_icon('heroicons:user-circle', {class: 'h-4 w-4'}) }}
            {{ 'centre_profiles.tabs.global'|trans({}, 'admin') }}
        </a>
        <a href="{{ path('app_centre_profiles_index', {centreId: centre.id, tab: 'specific'}) }}"
           {% if tab == 'specific' %}aria-current="page"{% endif %}
           class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
                  {{ tab == 'specific' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
            {{ ux_icon('heroicons:rectangle-group', {class: 'h-4 w-4'}) }}
            {{ 'centre_profiles.tabs.specific'|trans({}, 'admin') }}
        </a>
    </nav>

    <div class="mt-6">
        {% if tab == 'specific' %}
            <div class="max-w-7xl mx-auto">
                <twig:Admin:SpecificProfileTreeComponent :centre="centre" />
            </div>
        {% else %}
            <div class="max-w-3xl mx-auto">
                {% if centre.activeAcademicYear is null %}
                    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs px-6 py-4">
                        <p class="text-sm text-gray-500">{{ 'centre_profiles.no_active_year'|trans({}, 'admin') }}</p>
                    </div>
                {% else %}
                    <form method="post" class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
                        <input type="hidden" name="_token" value="{{ csrf_token('edit_centre_profiles_' ~ centre.id) }}">

                        <div class="px-6 py-5 border-b border-gray-100">
                            <label class="block text-sm font-medium text-gray-700 mb-0.5">
                                {{ 'centre_profiles.quality_managers.label'|trans({}, 'admin') }}
                            </label>
                            <p class="text-xs text-gray-400 mb-2">{{ 'centre_profiles.quality_managers.help'|trans({}, 'admin') }}</p>
                            <select name="quality_managers[]" multiple
                                    data-controller="symfony--ux-autocomplete--autocomplete"
                                    data-symfony--ux-autocomplete--autocomplete-url-value="{{ path('ux_entity_autocomplete', {alias: 'teacher_centre', academicYearId: centre.activeAcademicYear.id}) }}"
                                    data-symfony--ux-autocomplete--autocomplete-min-characters-value="2"
                                    data-symfony--ux-autocomplete--autocomplete-no-results-found-text-value="{{ 'autocomplete.no_results'|trans({}, 'admin') }}"
                                    data-symfony--ux-autocomplete--autocomplete-tom-select-options-value='{"dropdownParent":"body"}'
                                    class="w-full">
                                {% for teacher in selectedQualityManagers %}
                                    <option value="{{ teacher.id }}" selected>{{ teacher.name.lastName }}, {{ teacher.name.firstName }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="px-6 py-5 border-b border-gray-100">
                            <label class="block text-sm font-medium text-gray-700 mb-0.5">
                                {{ 'centre_profiles.internal_auditors.label'|trans({}, 'admin') }}
                            </label>
                            <p class="text-xs text-gray-400 mb-2">{{ 'centre_profiles.internal_auditors.help'|trans({}, 'admin') }}</p>
                            <select name="internal_auditors[]" multiple
                                    data-controller="symfony--ux-autocomplete--autocomplete"
                                    data-symfony--ux-autocomplete--autocomplete-url-value="{{ path('ux_entity_autocomplete', {alias: 'teacher_centre', academicYearId: centre.activeAcademicYear.id}) }}"
                                    data-symfony--ux-autocomplete--autocomplete-min-characters-value="2"
                                    data-symfony--ux-autocomplete--autocomplete-no-results-found-text-value="{{ 'autocomplete.no_results'|trans({}, 'admin') }}"
                                    data-symfony--ux-autocomplete--autocomplete-tom-select-options-value='{"dropdownParent":"body"}'
                                    class="w-full">
                                {% for teacher in selectedInternalAuditors %}
                                    <option value="{{ teacher.id }}" selected>{{ teacher.name.lastName }}, {{ teacher.name.firstName }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="px-6 py-4 bg-gray-50 flex justify-end">
                            <button type="submit"
                                    class="rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                                           hover:bg-forest-700 transition-colors shadow-xs">
                                {{ 'centre_profiles.save'|trans({}, 'admin') }}
                            </button>
                        </div>
                    </form>
                {% endif %}
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
