<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'DejaVu Sans', Arial, sans-serif;
        font-size: 9pt;
        color: #453b32;
        line-height: 1.35;
    }

    /* ── Cabecera de página (no se reduce) ── */
    .page-header {
        border-bottom: 2px solid #46603d;
        padding-bottom: 10px;
        margin-bottom: 14px;
    }
    .page-header h1 {
        font-size: 17pt;
        font-weight: bold;
        color: #2e2822;
    }
    .page-header .subtitle {
        font-size: 11pt;
        color: #5e5044;
        margin-top: 3px;
    }
    .page-header .meta {
        font-size: 9.5pt;
        color: #93826a;
        margin-top: 2px;
    }
    .page-header .centre-info {
        font-size: 10pt;
        color: #46603d;
        margin-top: 4px;
        font-weight: bold;
        letter-spacing: 0.3pt;
    }

    /* ── Secciones ── */
    .section-title {
        font-size: 9.5pt;
        font-weight: bold;
        color: #2e3b27;
        text-transform: uppercase;
        letter-spacing: 0.4pt;
        border-bottom: 1px solid #c7d8bc;
        padding-bottom: 4px;
        margin-bottom: 8px;
        margin-top: 15px;
    }
    .subsection-title {
        font-size: 9pt;
        font-weight: bold;
        color: #374b2e;
        background-color: #f3f6f0;
        border-left: 3px solid #5a7550;
        padding: 4px 8px;
        margin-bottom: 6px;
        margin-top: 10px;
    }

    /* ── Texto de descripción / observaciones (HTML saneado) ── */
    .prose-block {
        margin-bottom: 7px;
    }
    .prose-block p {
        margin-bottom: 5px;
    }

    /* ── Tablas de datos ── */
    table.data-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
        font-size: 8pt;
    }
    table.data-table thead {
        display: table-header-group;
    }
    table.data-table thead tr {
        background-color: #374b2e;
    }
    table.data-table thead th {
        padding: 5px 7px;
        text-align: left;
        vertical-align: middle;
        font-weight: bold;
        font-size: 7.5pt;
        text-transform: uppercase;
        letter-spacing: 0.3pt;
        color: #ffffff;
    }
    table.data-table tbody tr {
        page-break-inside: avoid;
    }
    table.data-table tbody tr:nth-child(even) {
        background-color: #faf7f1;
    }
    table.data-table tbody tr:nth-child(odd) {
        background-color: #ffffff;
    }
    table.data-table tbody td {
        padding: 5px 7px;
        border-bottom: 1px solid #e3d8c1;
        vertical-align: top;
        line-height: 1.25;
        color: #453b32;
    }

    /* ── Texto secundario dentro de una celda ── */
    .cell-sub {
        color: #93826a;
        font-size: 7.5pt;
    }

    /* ── Conductas contrarias, agrupadas por categoría ── */
    table.behavior-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
    }
    table.behavior-table td.behavior-cell {
        width: 33.33%;
        vertical-align: top;
        background-color: #faf7f1;
        border: 1px solid #e3d8c1;
        padding: 6px 8px;
    }
    .behavior-category {
        font-size: 7.5pt;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.3pt;
        color: #374b2e;
        margin-bottom: 4px;
        padding-bottom: 3px;
        border-bottom: 1px solid #c7d8bc;
    }
    .behavior-category-serious {
        color: #6b3241;
    }
    table.behavior-table ul {
        margin: 0;
        padding-left: 13px;
    }
    table.behavior-table li {
        font-size: 8pt;
        margin-bottom: 2px;
    }

    /* ── Badges ──
       mPDF no aplica border-radius a elementos inline, así que las píldoras
       quedan rectangulares (varias en la misma línea); se compensa con más
       padding para que el color no quede pegado al texto. */
    .badge {
        display: inline-block;
        padding: 3px 9px;
        margin: 0 4px 4px 0;
        font-size: 7.5pt;
        font-weight: 600;
        letter-spacing: 0.2pt;
        color: #453b32;
    }
    .badge-green  { background-color: #e3ebdd; color: #46603d; }
    .badge-amber  { background-color: #f7e7c4; color: #6b4a18; }
    .badge-red    { background-color: #ead1d7; color: #6b3241; }
    .badge-blue   { background-color: #d3dee7; color: #4e5f72; }
    .badge-gray   { background-color: #f1ead9; color: #776552; }
    .badge-purple { background-color: #a5b9c7; color: #2d3742; }

    /* ── Pie de página (no se reduce) ── */
    .pdf-footer {
        font-size: 8.5pt;
        color: #93826a;
        text-align: right;
        border-top: 1px solid #e3d8c1;
        padding-top: 4px;
    }
</style>
