<div class="px-4 sm:px-6 py-6 max-w-7xl mx-auto"
     data-controller="form-model-editor"
     data-form-model-editor-config-value="{{ editor|json_encode|e('html_attr') }}"
     data-form-model-editor-labels-value="{{ labels|json_encode|e('html_attr') }}">

    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
            <a href="{{ path('app_form_models') }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-forest-600">
                {{ ux_icon('heroicons:arrow-left', {class: 'h-4 w-4'}) }}{{ 'models.title'|trans({}, 'forms') }}
            </a>
            <h1 class="mt-1 break-words text-2xl font-bold text-gray-900">{{ document.name }}</h1>
            <p class="text-sm text-gray-500">{{ document.folder.documentSection.name }} › {{ document.folder.name }}</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <label for="model-code-input" class="text-sm text-gray-600">{{ 'models.code'|trans({}, 'forms') }}</label>
            <input id="model-code-input" data-form-model-editor-target="code" maxlength="40" value="{{ model.code }}"
                   class="w-32 rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500">
            <a href="{{ path('app_form_model_preview', {id: model.id.toRfc4122}) }}" target="_blank" rel="noopener"
               class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3.5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                {{ ux_icon('heroicons:eye', {class: 'h-4 w-4'}) }}{{ 'editor.preview'|trans({}, 'forms') }}
            </a>
            <a href="{{ path('app_form_model_preview_pdf', {id: model.id.toRfc4122}) }}" target="_blank" rel="noopener" data-testid="preview-pdf"
               class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3.5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                {{ ux_icon('heroicons:document', {class: 'h-4 w-4'}) }}{{ 'editor.preview_pdf'|trans({}, 'forms') }}
            </a>
        </div>
    </div>

    {% set send_label = (document.folder.requiresReview ? 'editor.send' : 'editor.save_revision')|trans({}, 'forms') %}

    {# The bar stays in view while editing: how the draft is saved, what is still to send, and the way to send it (the panel opens under it). #}
    <div class="sticky top-0 z-30 -mx-4 mt-3 border-b border-gray-200 bg-white/95 px-4 py-2 backdrop-blur sm:-mx-6 sm:px-6" data-form-model-editor-target="bar">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <p class="text-sm" role="status" aria-live="polite" data-form-model-editor-target="status"></p>
            <p class="min-w-0 flex-1 text-sm text-gray-600" data-form-model-editor-target="summary"></p>
            <button type="button" data-form-model-editor-target="openSend" data-action="form-model-editor#togglePanel" aria-expanded="false" aria-controls="send-panel"
                    class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-3.5 py-2 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 disabled:cursor-not-allowed disabled:bg-gray-300">
                {{ ux_icon('heroicons:paper-airplane', {class: 'h-4 w-4'}) }}{{ send_label }}
            </button>
        </div>

        <section id="send-panel" hidden data-form-model-editor-target="panel" class="mt-3 max-h-[70vh] overflow-y-auto rounded-2xl border border-gray-200 bg-white p-4 shadow-lg sm:p-5">
            <h2 class="text-base font-semibold text-gray-900">{{ send_label }}</h2>
            <p class="mt-1 text-sm text-gray-500">{{ (document.folder.requiresReview ? 'editor.send_review' : 'editor.send_direct')|trans({}, 'forms') }}</p>
            <ul class="mt-3 space-y-1 text-sm text-amber-800" data-form-model-editor-target="problems"></ul>
            {% if impact.drafts + impact.delivered > 0 %}
                <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900" data-testid="send-impact">{{ 'editor.impact'|trans({'%drafts%': impact.drafts, '%delivered%': impact.delivered}, 'forms') }}</p>
            {% endif %}
            <form method="post" action="{{ path('app_form_model_send', {id: model.id.toRfc4122}) }}" class="mt-3 flex flex-wrap items-end gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('form_model_send_' ~ model.id.toRfc4122) }}">
                {% if impact.drafts + impact.delivered > 0 or hasRevisions %}
                    <fieldset class="w-full">
                        <legend class="block text-sm font-medium text-gray-700">{{ 'editor.policy'|trans({}, 'forms') }}</legend>
                        <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
                            <twig:Form:RadioCard
                                name="policy"
                                value="optional"
                                label="{{ 'editor.policy_optional'|trans({}, 'forms') }}"
                                help="{{ 'editor.policy_optional_help'|trans({}, 'forms') }}"
                                :checked="true"
                            />
                            <twig:Form:RadioCard
                                name="policy"
                                value="mandatory"
                                label="{{ 'editor.policy_mandatory'|trans({}, 'forms') }}"
                                help="{{ 'editor.policy_mandatory_help'|trans({}, 'forms') }}"
                            />
                        </div>
                        <label class="mt-2 inline-flex items-center gap-2 text-sm text-gray-700">{{ 'editor.policy_deadline'|trans({}, 'forms') }}
                            <input type="date" name="deadline" class="rounded-lg border border-gray-200 px-2 py-1 text-sm focus:border-forest-500 focus:ring-forest-500">
                        </label>
                    </fieldset>
                {% endif %}
                <div class="min-w-0 flex-1">
                    <label for="send-description" class="block text-sm font-medium text-gray-700">{{ 'editor.send_description'|trans({}, 'forms') }}</label>
                    <input id="send-description" name="description" maxlength="2000" class="mt-1 w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500">
                </div>
                <button type="submit" data-form-model-editor-target="send" class="w-full rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-forest-700 disabled:cursor-not-allowed disabled:bg-gray-300 sm:w-auto">{{ send_label }}</button>
            </form>
        </section>
    </div>

    {# The tabs are drawn by the controller (they carry the state of each part); the panels are here. #}
    <div class="mt-4 flex gap-1 overflow-x-auto border-b border-gray-200" role="tablist" data-form-model-editor-target="tabs"></div>

    <div class="mt-4" role="tabpanel" data-panel="content">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[16rem_minmax(0,1fr)]">
            <nav aria-label="{{ 'editor.outline'|trans({}, 'forms') }}" class="hidden lg:block">
                <div class="sticky top-20 max-h-[75vh] overflow-y-auto rounded-2xl border border-gray-200 bg-white p-3 shadow-xs" data-form-model-editor-target="outline"></div>
            </nav>
            <div class="min-w-0 space-y-4" data-form-model-editor-target="canvas"></div>
        </div>
    </div>
    <div class="mt-4" role="tabpanel" data-panel="rules" hidden data-form-model-editor-target="rules"></div>
    <div class="mt-4" role="tabpanel" data-panel="approval" hidden data-form-model-editor-target="approval"></div>

    {% set sources_with_fields = indicatorSources|filter(s => s.fields is not empty) %}
    {% if sources_with_fields is not empty or modelIndicators is not empty %}
        <section class="mt-4 rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5" role="tabpanel" data-panel="indicators" hidden data-testid="indicator-sources">
            {% if modelIndicators is not empty %}
                <h2 class="text-base font-semibold text-gray-900">{{ 'editor.indicators_existing'|trans({}, 'forms') }}</h2>
                <p class="mt-1 text-sm text-gray-500">{{ 'editor.indicators_existing_help'|trans({}, 'forms') }}</p>
                <ul class="mt-3 divide-y divide-gray-100 rounded-xl border border-gray-200" data-testid="model-indicators">
                    {% for i in modelIndicators %}
                        <li>
                            <a href="{{ path('app_quality_indicator', {id: i.id}) }}" class="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-2.5 hover:bg-gray-50">
                                <span class="min-w-0 flex-1">
                                    <span class="block break-words text-sm font-medium text-gray-900">{{ i.name }}</span>
                                    <span class="block break-words text-xs text-gray-500">
                                        {{ i.activity }} ·
                                        {% if i.field is not null %}{{ ('indicator.source.agg_' ~ i.aggregation)|trans({}, 'quality') }}: {{ i.field }}{% else %}{{ 'editor.indicator_field_gone'|trans({}, 'forms') }}{% endif %}
                                    </span>
                                </span>
                                {% if not i.active %}<span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">{{ 'indicator.inactive'|trans({}, 'quality') }}</span>{% endif %}
                                {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0 text-gray-400'}) }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% if sources_with_fields is not empty %}
            <h2 class="{{ modelIndicators is not empty ? 'mt-6 ' : '' }}text-base font-semibold text-gray-900">{{ 'editor.indicator_title'|trans({}, 'forms') }}</h2>
            <p class="mt-1 text-sm text-gray-500">{{ 'editor.indicator_help'|trans({}, 'forms') }}</p>
            {% for source in sources_with_fields %}
                <h3 class="mt-3 text-sm font-medium text-gray-700">{{ source.name }}</h3>
                <ul class="mt-1 flex flex-wrap gap-2">
                    {% for field in source.fields %}
                        <li>
                            <a href="{{ path('app_quality_indicator_new', {fuente: source.id ~ '|' ~ field.key, agg: field.type == 'scale' ? 'avg' : (field.type == 'number' or field.type == 'calculated' ? 'sum' : 'percent_if')}) }}"
                               class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 max-sm:py-2">
                                {{ ux_icon('heroicons:chart-bar', {class: 'h-4 w-4'}) }}{{ 'editor.indicator_create'|trans({'%field%': field.label}, 'forms') }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endfor %}
        {% endif %}
        </section>
    {% endif %}

    {# ── Settings of the document: running header and footer, orientation and font scale ── #}
    <section class="mt-4 space-y-6" role="tabpanel" data-panel="layout" hidden data-testid="layout-panel">
        {% for part in ['header', 'footer'] %}
            {% set custom = layout[part] is not null %}
            <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5" data-layout-part="{{ part }}">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <h2 class="text-base font-semibold text-gray-900">{{ ('layout.' ~ part ~ '_title')|trans({}, 'forms') }}</h2>
                        <p class="mt-1 text-sm text-gray-500">{{ ('layout.' ~ part ~ '_help')|trans({}, 'forms') }}</p>
                    </div>
                    <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700">
                        <input type="checkbox" class="rounded border-gray-300 text-forest-600 focus:ring-forest-500" data-part="{{ part }}"
                               data-action="change->form-model-editor#layoutMode" {{ custom ? 'checked' : '' }}>
                        {{ 'layout.customize'|trans({}, 'forms') }}
                    </label>
                </div>

                {# What it has without its own (the centre's, or the platform's) #}
                <div class="mt-3 {{ custom ? 'hidden' : '' }}" data-layout-inherited>
                    <div class="overflow-x-auto rounded-xl border border-dashed border-gray-300 bg-gray-50 p-3 text-sm text-gray-700 doc-layout-prose">{{ inherited[part]|sanitize_html('app.doc_layout') }}</div>
                    <p class="mt-1.5 text-xs text-gray-500">{{ 'layout.inherited_note'|trans({}, 'forms') }}</p>
                </div>

                <div class="mt-3 {{ custom ? '' : 'hidden' }}" data-layout-custom>
                    {{ include('components/_doc_layout_editor.html.twig', {
                        id: 'model-layout-' ~ part,
                        value: layout[part] ?? inherited[part],
                        default: inherited[part],
                        input: 'data-part="' ~ part ~ '" data-action="change->form-model-editor#layoutEdited"',
                        code: model.code,
                        title: document.name,
                    }) }}
                </div>
            </div>
        {% endfor %}

        {# A header of its own for the first page (without it the first page has the normal header) #}
        {% set customFirst = layout.firstHeader is not null %}
        <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5" data-layout-part="firstHeader">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-base font-semibold text-gray-900">{{ 'layout.first_title'|trans({}, 'forms') }}</h2>
                    <p class="mt-1 text-sm text-gray-500">{{ 'layout.first_help'|trans({}, 'forms') }}</p>
                </div>
                <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700">
                    <input type="checkbox" class="rounded border-gray-300 text-forest-600 focus:ring-forest-500" data-part="firstHeader"
                           data-action="change->form-model-editor#layoutMode" {{ customFirst ? 'checked' : '' }}>
                    {{ 'layout.first_use'|trans({}, 'forms') }}
                </label>
            </div>
            {# Without its own, the first page has the header above: the checkbox starts from that one. #}
            <div class="mt-3 {{ customFirst ? '' : 'hidden' }}" data-layout-custom>
                {{ include('components/_doc_layout_editor.html.twig', {
                    id: 'model-layout-firstHeader',
                    value: layout.firstHeader ?? (layout.header ?? inherited.header),
                    default: layout.header ?? inherited.header,
                    input: 'data-part="firstHeader" data-action="change->form-model-editor#layoutEdited"',
                    code: model.code,
                    title: document.name,
                }) }}
            </div>
        </div>

        {# The margins of the page, in millimetres #}
        {% set customMargins = layout.margins is not null %}
        {% set shownMargins = layout.margins ?? inherited.margins %}
        <fieldset class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5" data-layout-margins>
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <legend class="p-0 text-base font-semibold text-gray-900">{{ 'layout.margins'|trans({}, 'forms') }}</legend>
                    <p class="mt-1 text-sm text-gray-500">{{ 'layout.margins_help'|trans({}, 'forms') }}</p>
                </div>
                <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-700">
                    <input type="checkbox" class="rounded border-gray-300 text-forest-600 focus:ring-forest-500"
                           data-action="change->form-model-editor#layoutMarginsMode" {{ customMargins ? 'checked' : '' }}>
                    {{ 'layout.customize'|trans({}, 'forms') }}
                </label>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {% for side in ['top', 'right', 'bottom', 'left'] %}
                    <div>
                        <label for="layout-margin-{{ side }}" class="block text-xs font-medium text-gray-600">{{ ('layout.margin_' ~ side)|trans({}, 'forms') }}</label>
                        <input id="layout-margin-{{ side }}" type="number" min="5" max="40" step="1" value="{{ shownMargins[side] }}" data-side="{{ side }}"
                               data-inherited="{{ inherited.margins[side] }}" data-action="input->form-model-editor#layoutMargins" {{ customMargins ? '' : 'disabled' }}
                               class="mt-1 w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-forest-500 focus:ring-forest-500 disabled:bg-gray-50 disabled:text-gray-500">
                    </div>
                {% endfor %}
            </div>
            <p class="mt-2 text-xs text-gray-500">{{ 'layout.margins_note'|trans({}, 'forms') }}</p>
        </fieldset>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <fieldset class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
                <legend class="px-1 text-base font-semibold text-gray-900">{{ 'layout.orientation'|trans({}, 'forms') }}</legend>
                <div class="mt-2 grid grid-cols-2 gap-3">
                    {% for o in ['portrait', 'landscape'] %}
                        <label class="flex cursor-pointer flex-col items-center gap-2 rounded-xl border border-gray-200 p-3 text-sm font-medium text-gray-700 has-checked:border-forest-500 has-checked:bg-forest-50 has-checked:text-forest-800">
                            <input type="radio" name="layout-orientation" value="{{ o }}" class="sr-only" data-action="change->form-model-editor#layoutOrientation" {{ layout.orientation == o ? 'checked' : '' }}>
                            <svg viewBox="0 0 40 40" class="h-10 w-10" aria-hidden="true">
                                {% if o == 'portrait' %}<rect x="11" y="4" width="18" height="32" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15 12h10M15 17h10M15 22h6" stroke="currentColor" stroke-width="1.5" fill="none"/>
                                {% else %}<rect x="4" y="11" width="32" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 17h20M10 22h14" stroke="currentColor" stroke-width="1.5" fill="none"/>{% endif %}
                            </svg>
                            {{ ('layout.orientation_' ~ o)|trans({}, 'forms') }}
                        </label>
                    {% endfor %}
                </div>
            </fieldset>

            <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5">
                <label for="layout-scale" class="text-base font-semibold text-gray-900">{{ 'layout.font_scale'|trans({}, 'forms') }}</label>
                <p class="mt-1 text-sm text-gray-500">{{ 'layout.font_scale_help'|trans({}, 'forms') }}</p>
                <div class="mt-4 flex items-center gap-3">
                    <span class="text-xs text-gray-500" aria-hidden="true">50 %</span>
                    <input id="layout-scale" type="range" min="50" max="150" step="5" value="{{ layout.fontScale }}" class="min-w-0 flex-1 accent-forest-600"
                           data-action="input->form-model-editor#layoutScale" data-form-model-editor-target="scale">
                    <span class="text-xs text-gray-500" aria-hidden="true">150 %</span>
                </div>
                <div class="mt-3 flex items-center justify-between gap-3">
                    <output for="layout-scale" class="text-sm font-semibold text-forest-700" data-form-model-editor-target="scaleOutput">{{ layout.fontScale }} %</output>
                    <button type="button" data-action="form-model-editor#layoutScaleReset" class="rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50">{{ 'layout.font_scale_reset'|trans({}, 'forms') }}</button>
                </div>
            </div>
        </div>
    </section>

</div>
{% endblock %}
