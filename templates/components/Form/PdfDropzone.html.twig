{# `accept` and `hint` default to the PDF template case; other forms with a single file reuse it with their own. #}
{% props id, name, accept = 'application/pdf', hint = null, required = false, withSubmit = true, thumbs = false %}
{% set hintText = hint ?? 'settings.pdf_template.dropzone_hint'|trans({}, 'settings') %}
{% set limits = upload_limits() %}
<div data-controller="file-drop"
     data-file-drop-single-value="true"
     data-file-drop-max-size-value="{{ limits.maxFileBytes }}"
     data-file-drop-too-large-message-value="{{ 'settings.pdf_template.dropzone_too_large'|trans({'%filename%': '%filename%', '%max%': limits.formatSize(limits.maxFileBytes)}, 'settings') }}">

    <div data-file-drop-target="dropzone"
         data-action="dragenter->file-drop#dragEnter dragover->file-drop#dragOver dragleave->file-drop#dragLeave drop->file-drop#drop click->file-drop#triggerBrowse"
         class="flex items-center gap-3 rounded-xl border-2 border-dashed border-gray-200 bg-gray-50 px-4 py-3 cursor-pointer transition-colors hover:border-forest-300 hover:bg-forest-50/50">
        {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-5 w-5 text-gray-400 shrink-0'}) }}
        <span class="text-sm text-gray-500">{{ hintText }}</span>
        <input type="file" id="{{ id }}" name="{{ name }}"
               aria-label="{{ hintText }}"
               accept="{{ accept }}"{{ required ? ' required' }}
               data-file-drop-target="input"
               data-action="change->file-drop#change"
               class="sr-only">
    </div>

    <div data-file-drop-target="list" class="mt-2 space-y-1.5"></div>

    <template data-file-drop-target="itemTemplate">
        <div class="flex items-center gap-3 rounded-lg border border-gray-200 bg-white px-3 py-2">
            {% if thumbs %}
                {# The picked image, shown before it is sent (the controller fills it in from the file chosen). #}
                <img data-role="thumb" alt="" class="hidden h-12 max-w-32 shrink-0 rounded border border-gray-200 bg-white object-contain p-0.5">
            {% endif %}
            {{ ux_icon('heroicons:document', {class: 'h-4 w-4 text-gray-400 shrink-0'}) }}
            <span class="text-sm text-gray-700 flex-1 truncate" data-role="name"></span>
            <span class="text-xs text-gray-400 shrink-0" data-role="size"></span>
            <button type="button" data-action="click->file-drop#removeFile"
                    class="text-gray-400 hover:text-red-600 transition-colors" aria-label="{{ 'attachment.remove'|trans({}, 'admin') }}">
                {{ ux_icon('heroicons:x-mark', {class: 'h-4 w-4'}) }}
            </button>
        </div>
    </template>

    <p data-file-drop-target="clientError" class="mt-1 text-xs text-red-600 hidden"></p>

    {# Only offered once a file has been picked or dropped (the file-drop controller shows it); it has to live inside the controller's element to be its target. #}
    {% if withSubmit %}
    <button type="submit" data-file-drop-target="submit"
            class="hidden mt-2 items-center rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium
                   text-gray-700 hover:bg-gray-50 transition-colors">
        {{ 'settings.pdf_template.upload'|trans({}, 'settings') }}
    </button>
    {% endif %}
</div>
